-- Il terreno dipinto di una mappa (strumenti/grafica/mappe_dipinte.py): la sua
-- collezione si carica solo quando serve (battaglia/dipinti.collection) e manda la texture
-- alla mesh della mappa (battaglia/terreno.script).

go.property("nome", hash(""))  -- l'id della sua collection factory
go.property("terreno", resource.texture("/assets/fx/bagliore.png"))

function init(self)
	msg.post("/terreno#script", "dipinto", { nome = self.nome, terreno = self.terreno })
end
