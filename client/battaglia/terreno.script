-- Rettangolo della mappa (mesh con lo shader del terreno). La GUI crea la
-- texture della maschera e ci manda il suo percorso: qui la colleghiamo alla mesh,
-- insieme ai disegni della mappa (terreno e parete dei crateri).
--
-- Le mappe vecchie (forgia, crogiolo) hanno i disegni fra le risorse e lo sfondo
-- lo fa lo shader. Quelle dell'apprendista (battaglia/dipinti.lua) hanno terreno
-- e sfondo dipinti da SVG in client/dipinti, in texture compresse, una volta per
-- ogni densità di schermo. Ogni immagine ha la sua collezione, che le collection
-- factory di battaglia/dipinti.collection caricano solo quando serve e in un altro thread
-- (niente scatti): in memoria c'è un solo terreno e un solo sfondo, della densità
-- dello schermo. Finché non è pronta si vede solo lo sfondo.
--
-- Messaggi: "maschera" {path, mappa, dipinta} (una partita), "home" {sfondo}
-- (solo lo sfondo, dietro la home; senza sfondo la home si chiude), "schermo" {kx, ky},
-- "dipinto" {terreno} o {cielo, lontano, medio, vicino} (dalle collezioni appena create).
-- A chi manda "maschera" o "home" (col numero n della richiesta) risponde
-- "terreno_pronto" {n} quando c'è tutto.

local dipinti = require "battaglia.dipinti"

go.property("forgia_terreno", resource.texture("/assets/mappe/forgia/terreno.png"))
go.property("forgia_interno", resource.texture("/assets/mappe/forgia/interno_mezzo.png"))
go.property("crogiolo_terreno", resource.texture("/assets/mappe/crogiolo/terreno.png"))
go.property("crogiolo_interno", resource.texture("/assets/mappe/crogiolo/interno_mezzo.png"))

local MSG_MASCHERA = hash("maschera")
local MSG_HOME = hash("home")
local MSG_SCHERMO = hash("schermo")
local MSG_DIPINTO = hash("dipinto")
local MSG_PRONTO = hash("terreno_pronto")

-- le strisce dello sfondo e i loro posti nella mesh (texture3..6, come in terreno.material)
local PIANI = { "cielo", "lontano", "medio", "vicino" }
local POSTO = { cielo = "texture3", lontano = "texture4", medio = "texture5", vicino = "texture6" }
local STRISCIA = { lontano = "striscia1", medio = "striscia2", vicino = "striscia3" }

-- la densità delle immagini: la 2 (1,5 volte più grande) solo sugli schermi alti
-- almeno 1400 pixel veri (tablet, telefoni QHD); su un telefono a 1080 basta la 1
local function densita()
	local _, h = window.get_size()
	return (h or 0) >= 1400 and dipinti.densita[2] or dipinti.densita[1]
end

local function fabbrica(id)
	return msg.url(nil, "/dipinti/fabbriche", id)
end

-- Chiede un dipinto (tipo "terreno" o "sfondo", id della collection factory): lo
-- carica in un altro thread e crea la sua collezione, che manda le texture
-- (MSG_DIPINTO). Il dipinto di prima resta finché il nuovo non è pronto.
local function chiedi(self, tipo, id)
	local p = self.pezzi[tipo]
	if p and p.id == id then return end
	local nuovo = { id = id, vecchio = p and (p.pronto and p.id or p.vecchio) }
	if p and not p.pronto then
		-- quello che si stava caricando non serve più
		collectionfactory.unload(fabbrica(p.id))
	end
	self.pezzi[tipo] = nuovo
	collectionfactory.load(fabbrica(id), function(self, url, ok)
		if self.pezzi[tipo] ~= nuovo then return end
		if not ok then
			print("ERROR: dipinto " .. id .. " non caricato")
			return
		end
		collectionfactory.create(url)
	end)
end

-- lo sfondo dipinto di un girone e i numeri delle sue strisce
local function chiedi_sfondo(self, nome)
	chiedi(self, "sfondo", nome .. "_" .. densita())
	if self.strisce_di == nome then return end
	self.strisce_di = nome
	-- w: quanto è scorsa la striscia (lo aggiorna update, già dentro un giro)
	self.strisce = {}
	for _, g in ipairs(dipinti.sfondi[nome].gruppi) do
		self.strisce[#self.strisce + 1] = { nome = STRISCIA[g.nome], scorre = g.scorre,
			v = vmath.vector4(g.y0 / 720, g.h / 720, g.quanto, 0) }
	end
end

local function pronto(self, tipo)
	local p = self.pezzi[tipo]
	return p ~= nil and p.pronto == true
end

function init(self)
	-- x = 1 mappa dipinta, y = secondi (braci che salgono, sfondo che scorre),
	-- zw = proporzioni dello schermo (ui/schermo.lua: kx, ky)
	self.opzioni = vmath.vector4(0, 0, 1, 1)
	-- x = sfondo dipinto, y = crateri che mostrano lo sfondo, z = solo sfondo (terreno.fp)
	self.stile = vmath.vector4(0, 0, 0, 0)
	self.pezzi = {}
	-- lo sfondo della home (e delle mappe dipinte) comincia a caricarsi subito,
	-- mentre c'è ancora la schermata d'ingresso
	chiedi_sfondo(self, "forgia")
end

function update(self, dt)
	-- dopo un'ora si ricomincia, così il float dello shader resta preciso
	self.opzioni.y = (self.opzioni.y + dt) % 3600
	go.set("#mesh", "opzioni", self.opzioni)
	go.set("#mesh", "stile", self.stile)
	-- lo scorrimento di ogni striscia lo contiamo qui, dentro un giro: nello
	-- shader il tempo in mediump andrebbe a scatti, e al giro dell'ora salterebbe
	if self.strisce and self.stile.x > 0.5 then
		for _, st in ipairs(self.strisce) do
			st.v.w = (st.v.w + dt * st.scorre) % dipinti.giro
			go.set("#mesh", st.nome, st.v)
		end
	end
end

-- lo stile della mappa (stile.x, stile.y) o, dietro la home, solo lo sfondo
-- dipinto; quello che non è ancora pronto non si disegna. Quando c'è tutto lo
-- dice alla GUI (MSG_PRONTO), che tiene chiusa l'iride fino ad allora
local function applica(self)
	local tutto = true
	if self.home then
		chiedi_sfondo(self, self.home)
		tutto = pronto(self, "sfondo")
		self.stile.x, self.stile.y, self.stile.z = tutto and 1 or 0, 0, 1
	elseif self.sfondo_mappa then
		chiedi_sfondo(self, self.sfondo_mappa)
		chiedi(self, "terreno", self.mappa .. "_" .. densita())
		tutto = pronto(self, "sfondo") and pronto(self, "terreno")
		self.stile.x, self.stile.y = pronto(self, "sfondo") and 1 or 0, 1
		self.stile.z = pronto(self, "terreno") and 0 or 1
	else
		self.stile.x, self.stile.y, self.stile.z = 0, 0, 0
	end
	if tutto and self.chi then
		msg.post(self.chi, MSG_PRONTO, { n = self.chi_n })
		self.chi = nil
	end
end

function on_message(self, message_id, message, sender)
	if message_id == MSG_MASCHERA then
		go.set("#mesh", "texture2", message.path)
		local mappa = message.mappa
		self.mappa, self.sfondo_mappa = mappa, dipinti.mappe[mappa]
		self.chi, self.chi_n = sender, message.n
		if self.sfondo_mappa then
			self.opzioni.x = 1
		else
			-- mappe senza disegni: restano quelli della mesh, lo shader non li usa
			if message.dipinta and self[mappa .. "_terreno"] then
				go.set("#mesh", "texture0", self[mappa .. "_terreno"])
				go.set("#mesh", "texture1", self[mappa .. "_interno"])
			end
			self.opzioni.x = message.dipinta and 1 or 0
		end
		applica(self)
	elseif message_id == MSG_HOME then
		-- sfondo: il girone dietro la home; nil, la home si chiude
		self.home = message.sfondo
		if self.home then self.chi, self.chi_n = sender, message.n end
		applica(self)
	elseif message_id == MSG_DIPINTO then
		local tipo = message.terreno and "terreno" or "sfondo"
		local p = self.pezzi[tipo]
		if message.terreno then
			go.set("#mesh", "texture0", message.terreno)
		else
			for _, piano in ipairs(PIANI) do go.set("#mesh", POSTO[piano], message[piano]) end
		end
		-- le texture restano caricate finché non si scarica la fabbrica: l'oggetto non serve più
		go.delete(sender)
		if p and not p.pronto then
			p.pronto = true
			if p.vecchio and p.vecchio ~= p.id then collectionfactory.unload(fabbrica(p.vecchio)) end
			p.vecchio = nil
		end
		applica(self)
	elseif message_id == MSG_SCHERMO then
		self.opzioni.z, self.opzioni.w = message.kx, message.ky
	end
end
