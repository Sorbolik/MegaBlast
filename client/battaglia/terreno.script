-- Rettangolo della mappa (mesh con lo shader del terreno). La GUI crea la
-- texture della maschera e ci manda il suo percorso: qui la colleghiamo alla mesh,
-- insieme ai disegni della mappa (terreno e parete dei crateri).
--
-- Le mappe vecchie (forgia, crogiolo) hanno i disegni fra le risorse e lo sfondo
-- lo fa lo shader. Quelle dell'apprendista (battaglia/dipinti.lua) hanno terreno
-- e sfondo dipinti da SVG in client/dipinti, una volta per ogni densità di
-- schermo: qui si carica solo quella che serve, quando serve (così in memoria
-- non c'è mai la versione grande su un telefono piccolo).
--
-- Messaggi: "maschera" {path, mappa, dipinta} (una partita), "home" {sfondo}
-- (solo lo sfondo, dietro la home; senza sfondo la home si chiude), "schermo" {kx, ky}.

local dipinti = require "battaglia.dipinti"

go.property("forgia_terreno", resource.texture("/assets/mappe/forgia/terreno.png"))
go.property("forgia_interno", resource.texture("/assets/mappe/forgia/interno_mezzo.png"))
go.property("crogiolo_terreno", resource.texture("/assets/mappe/crogiolo/terreno.png"))
go.property("crogiolo_interno", resource.texture("/assets/mappe/crogiolo/interno_mezzo.png"))

local MSG_MASCHERA = hash("maschera")
local MSG_HOME = hash("home")
local MSG_SCHERMO = hash("schermo")

local TEX_2D = graphics and graphics.TEXTURE_TYPE_2D or resource.TEXTURE_TYPE_2D
local TEX_RGBA = graphics and graphics.TEXTURE_FORMAT_RGBA or resource.TEXTURE_FORMAT_RGBA
local TEX_RGB = graphics and graphics.TEXTURE_FORMAT_RGB or resource.TEXTURE_FORMAT_RGB
-- le strisce dello sfondo e i loro posti nella mesh (texture3..6, come in terreno.material)
local PIANI = { "cielo", "lontano", "medio", "vicino" }
local POSTO = { cielo = "texture3", lontano = "texture4", medio = "texture5", vicino = "texture6" }
local STRISCIA = { lontano = "striscia1", medio = "striscia2", vicino = "striscia3" }

-- la densità delle immagini: la 2 (1,5 volte più grande) sugli schermi alti
-- almeno 1000 pixel veri, dove la 1 si vedrebbe sfocata da vicino
local function densita()
	local _, h = window.get_size()
	return (h or 0) >= 1000 and dipinti.densita[2] or dipinti.densita[1]
end

-- Un PNG di client/dipinti in una texture (sempre la stessa per lo stesso posto:
-- cambiando mappa si riscrive quella)
local function carica(self, posto, file)
	local dati = sys.load_resource("/dipinti/" .. file)
	if not dati then
		print("ERROR: manca il dipinto " .. file)
		return nil
	end
	local img = image.load_buffer(dati, { premultiply_alpha = true, flip_vertically = true })
	local formato = img.type == image.TYPE_RGB and TEX_RGB or TEX_RGBA
	local p = { type = TEX_2D, format = formato, width = img.width, height = img.height }
	local percorso = self.texture[posto]
	if percorso and self.misura[posto] == img.width .. "x" .. img.height .. formato then
		resource.set_texture(percorso, p, img.buffer)
	else
		if percorso then resource.release(percorso) end
		percorso = resource.create_texture("/dipinti/" .. posto .. self.n .. ".texturec", p, img.buffer)
		self.n = self.n + 1
	end
	self.texture[posto], self.misura[posto] = percorso, img.width .. "x" .. img.height .. formato
	go.set("#mesh", posto, percorso)
	return percorso
end

-- lo sfondo dipinto di un girone: le immagini (se non ci sono già) e i numeri delle strisce
local function metti_sfondo(self, nome)
	local s = dipinti.sfondi[nome]
	local d = densita()
	if self.sfondo ~= nome .. d then
		for _, piano in ipairs(PIANI) do
			carica(self, POSTO[piano], "sfondi/" .. nome .. "_" .. piano .. "_" .. d .. ".png")
		end
		self.sfondo = nome .. d
	end
	for _, g in ipairs(s.gruppi) do
		go.set("#mesh", STRISCIA[g.nome], vmath.vector4(g.y0 / 720, g.h / 720, g.quanto, g.scorre))
	end
end

function init(self)
	-- x = 1 mappa dipinta, y = secondi (braci che salgono, sfondo che scorre),
	-- zw = proporzioni dello schermo (ui/schermo.lua: kx, ky)
	self.opzioni = vmath.vector4(0, 0, 1, 1)
	-- x = sfondo dipinto, y = crateri che mostrano lo sfondo, z = solo sfondo (terreno.fp)
	self.stile = vmath.vector4(0, 0, 0, 0)
	self.texture, self.misura, self.n = {}, {}, 0
end

function update(self, dt)
	-- dopo un'ora si ricomincia, così il float dello shader resta preciso (un
	-- giro dello sfondo, 2560 pixel, ci sta un numero intero di volte solo per
	-- caso: il salto si vede una volta ogni ora)
	self.opzioni.y = (self.opzioni.y + dt) % 3600
	go.set("#mesh", "opzioni", self.opzioni)
	go.set("#mesh", "stile", self.stile)
end

-- lo stile della mappa (stile.x, stile.y) o, dietro la home, solo lo sfondo dipinto
local function applica(self)
	if self.home then
		metti_sfondo(self, self.home)
		self.stile.x, self.stile.y, self.stile.z = 1, 0, 1
	else
		if self.sfondo_mappa then metti_sfondo(self, self.sfondo_mappa) end
		self.stile.x, self.stile.y, self.stile.z = self.sfondo_mappa and 1 or 0, self.sfondo_mappa and 1 or 0, 0
	end
end

function on_message(self, message_id, message)
	if message_id == MSG_MASCHERA then
		go.set("#mesh", "texture2", message.path)
		local mappa = message.mappa
		self.sfondo_mappa = dipinti.mappe[mappa]
		if self.sfondo_mappa then
			carica(self, "texture0", "mappe/" .. mappa .. "_" .. densita() .. ".png")
			self.opzioni.x = 1
		else
			-- mappe senza disegni: restano quelli della mesh, lo shader non li usa
			if message.dipinta and self[mappa .. "_terreno"] then
				go.set("#mesh", "texture0", self[mappa .. "_terreno"])
				go.set("#mesh", "texture1", self[mappa .. "_interno"])
			end
			self.opzioni.x = message.dipinta and 1 or 0
		end
		applica(self)
	elseif message_id == MSG_HOME then
		-- sfondo: il girone dietro la home; nil, la home si chiude
		self.home = message.sfondo
		applica(self)
	elseif message_id == MSG_SCHERMO then
		self.opzioni.z, self.opzioni.w = message.kx, message.ky
	end
end
