#version 140

in highp vec4 position;
in mediump vec2 texcoord0;

out mediump vec2 var_uv;
// punto sullo schermo in pixel del gioco (1280 x 720, stirati: terreno.fp li
// riporta alle proporzioni vere) e zoom della camera, per lo sfondo in parallasse
out highp vec2 var_schermo;
out highp float var_zoom;

uniform vs_uniforms
{
    highp mat4 view_proj;
};

void main()
{
    var_uv = texcoord0;
    gl_Position = view_proj * vec4(position.xyz, 1.0);
    var_schermo = (gl_Position.xy / gl_Position.w * 0.5 + 0.5) * vec2(1280.0, 720.0);
    // proiezione 2 / 1280 per lo zoom della vista, per 1,5: lo sfondo è fatto
    // sulla mappa di prima (1280 x 720), più piccola di 1,5 volte (game.CELL 3 / 2)
    var_zoom = view_proj[0][0] * 960.0;
}
