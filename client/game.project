[project]
title = MegaBlast
dependencies#0 = https://github.com/defold/extension-websocket/archive/refs/tags/4.2.4.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1280
height = 720
high_dpi = 1

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[android]
package = com.sorbolik.megablast

[ios]
bundle_identifier = com.sorbolik.megablast

[megablast]
server_url = ws://127.0.0.1:8080/ws
