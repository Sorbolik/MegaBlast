[project]
title = MegaBlast
dependencies#0 = https://github.com/defold/extension-websocket/archive/refs/tags/4.2.4.zip
custom_resources = /sim,/paintings,/paintings_hd,/assets/capes,/assets/skins/favilla_testa_1.png,/assets/skins/favilla_testa_arrabbiata_1.png,/assets/skins/favilla_testa_colpita_1.png,/assets/skins/favilla_testa_felice_1.png,/assets/skins/favilla_testa_ko_1.png,/assets/skins/favilla_testa_mira_1.png,/assets/skins/favilla_testa_paura_1.png,/assets/skins/favilla_testa_provocazione_1.png,/assets/skins/favilla_testa_sconfitta_1.png

[bootstrap]
main_collection = /main/main.collectionc
render = /render/lit.renderc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1280
height = 720
high_dpi = 1

[graphics]
default_texture_min_filter = linear_mipmap_linear
default_texture_mag_filter = linear
texture_profiles = /texture_profiles.texture_profiles

[html5]
scale_mode = stretch
show_fullscreen_button = 0
show_made_with_defold = 0

[android]
package = com.sorbolik.megablast
manifest = /android/AndroidManifest.xml
immersive_mode = 1
display_cutout = 0
app_icon_36x36 = /assets/icona/icona_36.png
app_icon_48x48 = /assets/icona/icona_48.png
app_icon_72x72 = /assets/icona/icona_72.png
app_icon_96x96 = /assets/icona/icona_96.png
app_icon_144x144 = /assets/icona/icona_144.png
app_icon_192x192 = /assets/icona/icona_192.png

[native_extension]
app_manifest = /megablast.appmanifest

[ios]
bundle_identifier = com.sorbolik.megablast

[megablast]
server_url = ws://49.13.44.34/ws
