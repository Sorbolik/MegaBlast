    <item android:drawable="@drawable/avvio_giro_02" android:duration="33" />
    <item android:drawable="@drawable/avvio_giro_03" android:duration="33" />
    <item android:drawable="@drawable/avvio_giro_04" android:duration="33" />
    <item android:drawable="@drawable/avvio_giro_05" android:duration="33" />
    <item android:drawable="@drawable/avvio_giro_06" android:duration="33" />
    <item android:drawable="@drawable/avvio_giro_07" android:duration="33" />
    <item android:drawable="@drawable/avvio_giro_08" android:duration="33" />
    <item android:drawable="@drawable/avvio_giro_09" android:duration="33" />
    <item android:drawable="@drawable/avvio_giro_10" android:duration="10000" />
</animation-list>
