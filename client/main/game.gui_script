-- Teams: Crimson and Cobalt from the art bible, then Green and Gold for
-- free-for-all. The palette lives only in ui/ui.lua
local TEAM_NAMES = TM.team_names
local TEAM_COLORS = ui.C.SQUADRA
local WHITE = vmath.vector4(1, 1, 1, 1)

-- Weapon bar, in this order: only those the robot has are shown. Around the
-- stopwatch at the bottom center (docs/decisioni/interfaccia.md): on the left
-- the primaries (Rune launcher always, next to the ring, the others from
-- crates) with an ember border, on the right the secondaries (the Blade
-- always, plus the one picked at the start) with a steel border. The Grapple
-- is round and purple next to the teleport: on the right, where the aiming
-- hand is, because the left one moves. The consumable items (trap, shield,
-- springboard, parachute: tapping them uses them at once) are a thing of their
-- own (Sergio, 29 Oct: above the secondaries they looked like a submenu of
-- theirs): a mint column above the teleport, titled OGGETTI with how many are
-- left. Once a weapon is used, its whole group goes off: the next shot is the
-- other color.
-- status effects: the label rising over the robot when they arrive and the
-- name under its health, with the turns left (no accents: the font lacks them)
local STATUS_NAME = { { "burn", TM.status_name.burn }, { "slow", TM.status_name.slow }, { "cracked", TM.status_name.cracked } }
local BAR_WEAPONS = { "missile", "grenade", "shards", "punch", "sniper", "sword", "eagle", "mallet", "lunge", "bellows",
	"trap", "shield", "trampoline", "hook", "parachute" }
-- border color of the four groups: primaries, secondaries, items, Grapple
local BAR_COLORS = { ui.C.BRACE, ui.C.STEEL, ui.C.MINT, ui.C.PURPLE }
local function bar_group(w)
	if w == "hook" then return 4 end
	return game.SECONDARY[w] and 2 or (game.TOOLS[w] and 3 or 1)
end
-- icons of the bar and of the draft (weapons atlas, strumenti/grafica/armi.py)
