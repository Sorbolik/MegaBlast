-- MegaBlast client: menus, local match (hot-seat) and online match.
-- The map is a mesh with the terrain shader (battle/terrain.*), everything
-- else (robots, missile, explosions, controls) is GUI nodes created in code.
-- The game logic lives in sim/ (pure Lua). Locally we run it here, online the
-- server runs it and we draw the state it sends us.

local game = require "sim.game"
local ui = require "ui.ui"
local gconfig = require "sim.config"
local scoria = require "battle.scoria"
local plate = require "battle.plate"
local home = require "menu.home"
local profile = require "menu.profile"
local TP = require("lang.text").pill
local TM = require("lang.text").match
local common = require("lang.text").common
local loadout = require "sim.loadout"
local awards = require "sim.awards"
local draft = require "sim.draft"
local bot = require "sim.bot"
local replay = require "sim.replay"
-- the screens outside the battle, in a single table: the gui_script is close
-- to Lua's limit of 200 local variables
local menu = { podium = require "menu.podium", armory = require "menu.armory", pick = require "menu.pick",
	training = require "menu.training", level_end = require "menu.level_end", campaign = require "menu.campaign",
	settings = require "menu.settings", board = require "menu.board", queue = require "menu.queue",
	lineup = require "menu.lineup", profile_tabs = require "menu.profile_tabs", lobby = require "menu.lobby",
	-- not screens, here so as not to add local variables (limit of 200): the
	-- server's events and their rules (start online)
	eventi = require "main.events", regole = require "sim.rules",
	-- the entry, the transitions between screens and the waiting flame
	ingresso = require "ui.entry", passaggio = require "ui.transition", attesa = require "ui.waiting",
	-- the queue that stays alive outside the waiting room (Sergio, 3 Nov)
	pill = require "ui.pill" }
local missions = require "sim.missions"
local sticks = require "battle.sticks"
local aim_name = require "battle.aim"
local camera = require "battle.camera"
local items = require "battle.items"
local score = require "battle.score"
local hud = require "battle.hud"
local screen = require "ui.screen"
local frames = require "ui.frames"
-- in the browser without the extension (web build) the browser's WebSocket is enough
local ws = websocket or (html5 and require "main.ws_browser")

-- W, H: the game screen (16:9; on other proportions the real screen goes from
-- schermo.x0 to x1 and from y0 to y1, ui/screen.lua); the map is game.WORLD_W x game.WORLD_H
local W, H = screen.W, screen.H
local TW, TH = game.WORLD_W / game.CELL, game.WORLD_H / game.CELL

local DEFAULT_SERVER = "ws://127.0.0.1:8080/ws"
-- Protocol version, equal to protocolVersion in server/server.go
local PROTOCOL = 8
-- If the connection drops in a match we retry for a while (the server keeps
-- the seat for 20 seconds)
local RECONNECT_TRIES, RECONNECT_WAIT = 12, 1.5

-- the input actions, in a single table (limit of 200 local variables)
local ACTION = {
	TOUCH = hash("touch"), LEFT = hash("left"), RIGHT = hash("right"), JUMP = hash("jump"),
	CANCEL = hash("cancel"), MULTI = hash("multitouch"), TELE_BTN = hash("teleport"), ZOOM = hash("zoom"),
	ZOOM_IN = hash("zoom_avanti"), ZOOM_OUT = hash("zoom_indietro"), MENU = hash("menu_partita"),
	-- keys 1-9: the bar's weapons
	WEAPON = {},
}
for i = 1, 9 do ACTION.WEAPON[hash("arma" .. i)] = i end
-- the controller's buttons reach the menus as ACTION.PAD (ui.tocco)
ACTION.PAD = ui.PAD

-- Controller (ui/controller.lua, docs/controller.md): reading the buttons and,
-- further down, what they do in battle, in a single table (limit of 200 locals)
