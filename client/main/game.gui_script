for _, w in ipairs({ "missile", "sniper", "grenade", "shards", "punch", "sword", "eagle", "mallet", "lunge", "bellows", "hook",
	"trap", "shield", "trampoline", "parachute" }) do
	WEAPON_ICON[w] = w .. "_icona"
end
-- melee weapons: no aim line
local SLOT, SLOT_GAP, BAR_Y = 84, 10, 64
-- on the phone the slots are smaller (narrow with five primaries, so they
-- don't reach the stick); the items round; from the ring's edge to the first
-- slot; how far the one in hand rises
local SIZES = { slot_tel = 72, narrow_slot = 62, gap_tel = 8, oggetto = 56, from_ring = 30, alza = 10, ring_y = 70 }
-- slot border: unavailable (already used, or teleport), available (the
-- group's color), selected
local SLOT_BORDER = { [0] = vmath.vector4(1, 0.886, 0.769, 0.06), ui.C.LINE, ui.C.LIGHT }
-- icon of a weapon already used this turn (it goes off: you see what is left)
local ICON_USED = vmath.vector4(1, 1, 1, 0.3)
local SLOT_SCALE, CHOSEN = vmath.vector3(1, 1, 1), 1.12
-- Sniper bounce: how much it squashes, how soon it calms down and how much it shakes
local BOING_AMP, BOING_DAMP, BOING_FREQ = 0.7, 4, 26
local SNIPER_EULER, SNIPER_SCALE = vmath.vector3(0, 0, 0), vmath.vector3(1, 1, 1)

-- points of the whole trajectory (one every 4 ticks), shown only in the
-- Training lessons
local HELP_POINTS = 45
local AIM_RANGE = 220 -- finger distance matching maximum power
-- bringing the finger back onto the robot and leaving it there cancels the shot
local CANCEL_R = 28

local function fit(node)
	gui.set_adjust_mode(node, gui.ADJUST_FIT)
	return node
end

local function box(x, y, w, h, color)
	local n = fit(gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0)))
	gui.set_color(n, color)
	return n
end

-- additive white halo (fx/bagliore.png), tinted with color
local function glow(x, y, d, color)
	local n = fit(gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(d, d, 0)))
	gui.set_texture(n, "battaglia")
	gui.play_flipbook(n, "bagliore")
	gui.set_blend_mode(n, gui.BLEND_ADD)
	gui.set_color(n, color)
	return n
end

-- HUD labels in the interface font: scale 1 = about 16 px
local FONT_K = 0.4
-- A shot in flight (or the button's orb) from the weapons atlas, sc times its
-- world size (battle/weapons.lua): the image and on top the parts with the
-- shooter's color. Returns the node and the parts to tint.
local function hit_def(nome, sc)
	local a = require("battle.weapons").shots[nome]
	local img = fit(gui.new_box_node(vmath.vector3(a.x * sc, a.y * sc, 0), vmath.vector3(a.w * sc, a.h * sc, 0)))
	gui.set_texture(img, "armi")
	gui.play_flipbook(img, a.img)
	local tint = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(a.w * sc, a.h * sc, 0))
	gui.set_texture(tint, "armi")
	gui.play_flipbook(tint, a.tint)
	gui.set_parent(tint, img)
	return img, tint
end

local function label(x, y, text, scale)
	return fit(ui.testo(text, x, y, (scale or 1) * FONT_K * 2))
end

-- Simulation (strumenti/simula): with megablast.simula = 1 the game writes to
-- the log the events and where the robot whose turn it is stands, so a script
-- can drive it.
local function config_int(key, default)
	if sys.get_config_int then return sys.get_config_int(key, default) end
	return tonumber(sys.get_config(key, tostring(default))) or default
end
local SIMULATE = config_int("megablast.simula", 0) == 1
-- in the simulator (build without the extension) online goes through LuaSocket
if not ws and SIMULATE then ws = require "main.ws_socket" end

local function config_string(key, default)
	if sys.get_config_string then return sys.get_config_string(key, default) end
	return sys.get_config(key, default)
end

