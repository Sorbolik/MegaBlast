-- Telefono o computer: [megablast] comandi = telefono / computer per
-- sceglierlo, altrimenti dal sistema (e dal browser, se è un telefono).
-- Durante la partita si cambia da soli: un dito sullo schermo accende le
-- levette, un tasto le spegne.
local COMANDI = config_string("megablast.comandi", "")
local function touch_device()
	if COMANDI == "telefono" then return true end
	if COMANDI == "computer" then return false end
	local name = sys.get_sys_info().system_name
	if name == "Android" or name == "iPhone OS" then return true end
	if name == "HTML5" and html5 then
		return html5.run("('ontouchstart' in window) || navigator.maxTouchPoints > 0") == "true"
	end
	return false
end

local function server_url()
	if sys.get_config_string then
		return sys.get_config_string("megablast.server_url", DEFAULT_SERVER)
	end
	return sys.get_config("megablast.server_url", DEFAULT_SERVER)
end

-- Terreno -----------------------------------------------------------------------

-- La mesh della mappa legge la maschera di collisione da una texture 640 x 360:
-- r = terreno adesso, g = terreno all'inizio (per riconoscere i crateri).
-- Dopo un'esplosione rimandiamo alla GPU solo il rettangolo del cratere.
local MASK_PATH = "/battaglia/maschera_viva.texturec"
local RGBA = hash("rgba")
local MASK_FORMAT = { { name = RGBA, type = buffer.VALUE_TYPE_UINT8, count = 4 } }
-- mappe che hanno i disegni in assets/mappe (le altre usano una roccia semplice)
local PAINTED = { forgia = true, crogiolo = true }

-- le costanti stanno in graphics (Defold recenti) o in resource (vecchi)
local TEX_2D = graphics and graphics.TEXTURE_TYPE_2D or resource.TEXTURE_TYPE_2D
local TEX_RGBA = graphics and graphics.TEXTURE_FORMAT_RGBA or resource.TEXTURE_FORMAT_RGBA

local function mask_params(w, h, x, y)
	return {
		type = TEX_2D, format = TEX_RGBA,
		width = w, height = h, x = x, y = y,
	}
end

local function draw_terrain(self)
	local data = self.g.terrain.data
	local buf = buffer.create(TW * TH, MASK_FORMAT)
	local st = buffer.get_stream(buf, RGBA)
	-- buffer.create non azzera la memoria: scriviamo ogni cella
	for i = 1, TW * TH do
		local v = data[i] ~= 0 and 255 or 0
		local j = i * 4 - 3
		st[j], st[j + 1] = v, v
	end
	self.mask_stream = st
	self.mask_buf = buf
	if self.mask_tex then
		resource.set_texture(self.mask_tex, mask_params(TW, TH), buf)
	else
		self.mask_tex = resource.create_texture(MASK_PATH, mask_params(TW, TH), buf)
	end
	msg.post("/terreno#script", "maschera", { path = self.mask_tex, mappa = self.g.map,
		dipinta = PAINTED[self.g.map] == true })
end

-- Aggiorna la maschera nel rettangolo dato (coordinate di cella)
local function redraw_cells(self, cx0, cy0, cx1, cy1)
	cx0, cy0 = math.max(0, cx0), math.max(0, cy0)
	cx1, cy1 = math.min(TW - 1, cx1), math.min(TH - 1, cy1)
	if cx1 < cx0 or cy1 < cy0 then return end
	local w, h = cx1 - cx0 + 1, cy1 - cy0 + 1
	local data, full = self.g.terrain.data, self.mask_stream
	local buf = buffer.create(w * h, MASK_FORMAT)
	local st = buffer.get_stream(buf, RGBA)
	local k = 1
	for cy = cy0, cy1 do
		local i = cy * TW + cx0 + 1
		for _ = 1, w do
			local j = i * 4 - 3
			local now = data[i] ~= 0 and 255 or 0
			full[j] = now
			st[k], st[k + 1] = now, full[j + 1]
			i, k = i + 1, k + 4
		end
	end
	resource.set_texture(self.mask_tex, mask_params(w, h, cx0, cy0), buf)
end

-- Messaggi e menu -------------------------------------------------------------

local function show_message(self, text, keep)
	gui.set_text(self.message, text)
	gui.cancel_animations(self.message, "color.w")
	gui.set_color(self.message, WHITE)
	if not keep then
		gui.animate(self.message, "color.w", 0, gui.EASING_INCUBIC, 0.6, 1.2)
	end
end

local function set_controls_visible(self, visible)
	self.controls_visible = visible
	gui.set_enabled(self.move_pad.base, visible and self.touch_ui)
	gui.set_enabled(self.aim_pad.base, visible and self.touch_ui)
	gui.set_enabled(self.bar, visible)
	gui.set_enabled(self.btn_tele, visible)
	gui.set_enabled(self.hud, visible)
	gui.set_enabled(self.time_bar_bg, visible)
	gui.set_enabled(self.time_bar, visible)
	gui.set_enabled(self.tele_label, visible)
	gui.set_enabled(self.score_label, visible)
	gui.set_enabled(self.btn_zoom, visible)
end

local function disconnect(self)
	if self.conn then
		ws.disconnect(self.conn)
		self.conn = nil
	end
end

-- Schermate fuori dalla battaglia (podio, armeria): si creano
-- quando si aprono e si cancellano quando si chiudono, così non pesano mentre si
-- gioca. Ogni modulo ha new, on_input (-> "indietro" / "continua" per uscire),
-- distruggi e, se si anima, update. I nodi vivi tutti insieme: circa 650 della
-- battaglia, più il podio del 2 contro 2 (circa 275) o l'armeria (fino a 330):
-- per questo max_nodes di game.gui è 2048 e non 1024.
local function chiudi_schermata(self)
	if self.schermata then
		self.schermata.mod.distruggi(self.schermata.obj)
		self.schermata = nil
	end
end

local function show_menu(self)
	chiudi_schermata(self)
	self.podio_t = nil
	disconnect(self)
	self.mode = "menu"
	home.show(self.home)
	-- la home copre tutto: la mappa sotto non serve disegnarla
	msg.post("/terreno", "disable")
	set_controls_visible(self, false)
	show_message(self, "", true)
	self.tut, self.tut_wait = nil, nil
	gui.set_text(self.tut_label, "")
end

-- Fluidità -------------------------------------------------------------------
-- La simulazione avanza a passi fissi (60 al secondo in locale, uno stato ogni
-- SNAPSHOT_TICKS online), mentre lo schermo può andare a 60, 90 o 120 Hz.
-- Disegniamo sempre una posizione interpolata tra la posa precedente (a) e
-- l'ultima (b), così il movimento non scatta.

-- Le pose sono tabelle riusate: niente allocazioni a ogni frame, quindi
-- niente pause del garbage collector.
local function new_pose()
	local o = {}
	for i = 1, game.MAX_ORBS do o[i] = { id = 0, x = 0, y = 0 } end
	local sh = {}
	for i = 1, game.SHARD_COUNT do sh[i] = { x = 0, y = 0, on = false } end
	-- c: casse per id (in caduta si muovono, vanno interpolate anche loro)
	local r = {}
	for i = 1, game.MAX_PLAYERS do r[i] = { x = 0, y = 0 } end
	return { r = r, p = { x = 0, y = 0 }, has_p = false,
		o = o, no = 0, s = sh, c = {} }
end

-- Il globo con quel numero nella posa, o nil
local function find_orb(pose, id)
	for i = 1, pose.no do
		if pose.o[i].id == id then return pose.o[i] end
	end
end

local function capture(pose, g)
	for i, rb in ipairs(g.robots) do
		local r = pose.r[i]
		r.x, r.y, r.g = rb.x, rb.y, rb.grounded
	end
	pose.has_p = g.projectile ~= nil
	if pose.has_p then pose.p.x, pose.p.y = g.projectile.x, g.projectile.y end
	local n = math.min(#g.orbs, game.MAX_ORBS)
	for i = 1, n do
		local src, dst = g.orbs[i], pose.o[i]
		dst.id, dst.x, dst.y = src.id, src.x, src.y
	end
	pose.no = n
	for i = 1, game.SHARD_COUNT do
		local sh, ps = g.shards[i], pose.s[i]
		ps.on = sh ~= nil
		if sh then ps.x, ps.y = sh.x, sh.y end
	end
	for _, pc in pairs(pose.c) do pc.seen = false end
	for _, c in ipairs(g.crates) do
		local pc = pose.c[c.id]
		if not pc then
			pc = {}
			pose.c[c.id] = pc
		end
		pc.x, pc.y, pc.landed, pc.seen = c.x, c.y, c.landed, true
	end
	for id, pc in pairs(pose.c) do
		if not pc.seen then pose.c[id] = nil end
	end
end

local function pose_k(self)
	return math.max(0, math.min(1, self.pose_t / self.pose_dt))
end

local ORB_TMP = {}
for i = 1, game.MAX_ORBS do ORB_TMP[i] = { id = 0, x = 0, y = 0 } end

-- Porta la posa a verso b della frazione k (a diventa ciò che è sullo schermo)
local function advance_pose(a, b, k)
	for i, rb in ipairs(b.r) do
		local ra = a.r[i]
		ra.x, ra.y, ra.g = ra.x + (rb.x - ra.x) * k, ra.y + (rb.y - ra.y) * k, rb.g
	end
	if b.has_p then
		if not a.has_p then a.p.x, a.p.y = b.p.x, b.p.y end
		a.p.x, a.p.y = a.p.x + (b.p.x - a.p.x) * k, a.p.y + (b.p.y - a.p.y) * k
	end
	a.has_p = b.has_p
	-- i globi di b, ognuno partendo da dove era in a (stesso numero)
	for i = 1, b.no do
		local ob, s = b.o[i], ORB_TMP[i]
		local oa = find_orb(a, ob.id) or ob
		s.id, s.x, s.y = ob.id, oa.x + (ob.x - oa.x) * k, oa.y + (ob.y - oa.y) * k
	end
	for i = 1, b.no do
		local s, d = ORB_TMP[i], a.o[i]
		d.id, d.x, d.y = s.id, s.x, s.y
	end
	a.no = b.no
	for i = 1, game.SHARD_COUNT do
		local sa, sb = a.s[i], b.s[i]
		if sb.on then
			if not sa.on then sa.x, sa.y = sb.x, sb.y end
			sa.x, sa.y = sa.x + (sb.x - sa.x) * k, sa.y + (sb.y - sa.y) * k
		end
		sa.on = sb.on
	end
	for id, cb in pairs(b.c) do
		local ca = a.c[id]
		if not ca then
			ca = { x = cb.x, y = cb.y }
			a.c[id] = ca
		end
		ca.x, ca.y, ca.landed = ca.x + (cb.x - ca.x) * k, ca.y + (cb.y - ca.y) * k, cb.landed
	end
	for id in pairs(a.c) do
		if not b.c[id] then a.c[id] = nil end
	end
end

-- Dopo un teletrasporto il robot non deve scivolare dal vecchio punto al nuovo
local function snap_robot(self, i)
	local ra, rb = self.pose_a.r[i], self.pose_b.r[i]
	local rg, v = self.g.robots[i], self.view[i]
	ra.x, ra.y = rg.x, rg.y
	rb.x, rb.y = rg.x, rg.y
	v.x, v.y, v.px = rg.x, rg.y, nil
end

local function reset_pose(self)
	self.pose_a = self.pose_a or new_pose()
	self.pose_b = self.pose_b or new_pose()
	capture(self.pose_a, self.g)
	capture(self.pose_b, self.g)
	self.pose_t = 0
end

-- Partita -----------------------------------------------------------------------

-- Nomi e colori: quelli della squadra, col numero se in squadra si è in due.
-- list: i robot o i giocatori, ognuno con team.
local function names_colors(list)
	local size, nth, names, colors = {}, {}, {}, {}
	for _, p in ipairs(list) do size[p.team] = (size[p.team] or 0) + 1 end
	for i, p in ipairs(list) do
		nth[p.team] = (nth[p.team] or 0) + 1
		names[i] = TEAM_NAMES[p.team] .. (size[p.team] > 1 and (" " .. nth[p.team]) or "")
		colors[i] = TEAM_COLORS[p.team]
	end
	return names, colors
end

local function new_match(self, seed, map, opts)
	self.g = game.new(seed, map, opts)
	-- se sullo schermo c'è già questa mappa intatta (es. quella del menu) non la ridisegnamo
	local key = self.g.map .. (maps.get(self.g.map).seeded and seed or "")
	if key ~= self.drawn_map then
		draw_terrain(self)
		self.drawn_map = key
	end
	self.names, self.colors = names_colors(self.g.robots)
	for i = #self.g.robots + 1, game.MAX_PLAYERS do
		scoria.set_enabled(self.robots[i].rig, false)
		targa.set_enabled(self.robots[i].targa, false)
	end
	self.view = {}
	for i, rb in ipairs(self.g.robots) do
		scoria.set_color(self.robots[i].rig, self.colors[i])
		scoria.set_enabled(self.robots[i].rig, true)
		targa.colore(self.robots[i].targa, self.colors[i])
		targa.set_enabled(self.robots[i].targa, true)
		targa.vita(self.robots[i].targa, rb.hp, rb.max_hp, rb.shield)
		self.view[i] = { x = rb.x, y = rb.y, hp = rb.hp, scudo = rb.shield }
	end
	self.trail_n = 0
	self.pose_dt = game.DT
	reset_pose(self)
	self.aiming = false
	self.weapon = "missile"
	self.tele_armed = false
	self.snap = {}
	self.crate_tabs = {}
	for _, n in ipairs(self.crate_nodes) do n.id = nil; gui.set_enabled(n.node, false) end
	self.acc = 0
	self.sent = {}
	-- la camera parte già su chi tocca
	local rb = self.g.robots[self.g.current]
	camera.salta(self.cam, rb.x, rb.y + game.ROBOT_H / 2, camera.zoom(self.cam))
	self.cam_sosta = 0
	self.fermo = 0
end

-- Un solo vettore riusato per tutte le posizioni del frame
local POS = vmath.vector3(0, 0, 0)
local function set_pos(node, x, y)
	POS.x, POS.y = x, y
	gui.set_position(node, POS)
end

local EULER = vmath.vector3(0, 0, 0)

-- Esplosione: flipbook di 12 fotogrammi più un lampo di brace in additivo.
-- I nodi sono pochi e riusati a giro, così non se ne creano durante la partita.
local BRACE = vmath.vector4(1, 0.478, 0.102, 1)
local function hide_node(_, node) gui.set_enabled(node, false) end

local function explosion(self, x, y, r)
	self.boom_i = self.boom_i % #self.booms + 1
	local b = self.booms[self.boom_i]
	local d = r * 3.6
	gui.set_enabled(b.anim, true)
	gui.set_position(b.anim, vmath.vector3(x, y, 0))
	gui.set_size(b.anim, vmath.vector3(d, d, 0))
	gui.set_euler(b.anim, vmath.vector3(0, 0, math.random(0, 359)))
	gui.play_flipbook(b.anim, "esplosione", hide_node)

	gui.set_enabled(b.flash, true)
	gui.cancel_animations(b.flash)
	gui.set_position(b.flash, vmath.vector3(x, y, 0))
	gui.set_size(b.flash, vmath.vector3(r * 6, r * 6, 0))
	gui.set_color(b.flash, BRACE)
	gui.animate(b.flash, "color.w", 0, gui.EASING_OUTQUAD, 0.45, 0, hide_node)

	-- detriti: pezzi di roccia e di brace lanciati verso l'alto
	for j = 1, DETRITI_PER_COLPO do
		self.detrito_i = self.detrito_i % #self.detriti + 1
		local d = self.detriti[self.detrito_i]
		local a = math.pi / 2 + (math.random() * 2 - 1) * 1.1
		local v = r * (5 + math.random() * 5)
		d.x, d.y, d.vx, d.vy = x, y, math.cos(a) * v, math.sin(a) * v
		d.a, d.va, d.t = math.random() * 360, (math.random() * 2 - 1) * 720, 0
		local lato = r * (0.16 + math.random() * 0.14)
		gui.set_size(d.node, vmath.vector3(lato, lato, 0))
		local c = j % 2 == 0 and BRACE_SCURA or PIETRA
		d.col.x, d.col.y, d.col.z = c.x, c.y, c.z
		gui.set_enabled(d.node, true)
	end
	-- lo schermo sobbalza anche se non colpisce nessuno; da dove viene un colpo lo
	-- ricordiamo per spingere chi è colpito
	camera.scuoti(self.cam, math.random() - 0.5, -1, 3 + r * 0.2)
	self.colpo_x, self.colpo_y, self.colpo_t = x, y, self.clock
end

local function muovi_detriti(self, dt)
	for _, d in ipairs(self.detriti) do
		if d.t < DETRITO_VITA then
			d.t = d.t + dt
			d.vy = d.vy - game.GRAVITY * dt
			d.x, d.y, d.a = d.x + d.vx * dt, d.y + d.vy * dt, d.a + d.va * dt
			d.col.w = math.min(1, (DETRITO_VITA - d.t) / 0.3)
			POS.x, POS.y = d.x, d.y
			gui.set_position(d.node, POS)
			EULER.z = d.a
			gui.set_euler(d.node, EULER)
			gui.set_color(d.node, d.col)
			if d.t >= DETRITO_VITA then gui.set_enabled(d.node, false) end
		end
	end
end

-- Da dove arriva il colpo che ha tolto vita al robot i: l'esplosione o il pugno
-- di un attimo fa, altrimenti chi è di turno (la spada)
local function colpo_da(self, i)
	if self.colpo_t and self.clock - self.colpo_t < 0.5 then return self.colpo_x, self.colpo_y end
	local v = self.view[self.g.current]
	if self.g.current == i then return v.x - 1, v.y end
	return v.x, v.y + game.ROBOT_H / 2
end

-- Onda d'urto del Pugno del Titano: un anello di brace che si allarga
local function shock(self, x, y)
	local n = self.shock
	gui.set_enabled(n, true)
	gui.cancel_animations(n)
	gui.set_position(n, vmath.vector3(x, y, 0))
	gui.set_size(n, vmath.vector3(20 * K, 20 * K, 0))
	gui.set_color(n, BRACE)
	gui.animate(n, "size", vmath.vector3(90 * K, 90 * K, 0), gui.EASING_OUTQUAD, 0.35)
	gui.animate(n, "color.w", 0, gui.EASING_INQUAD, 0.35, 0, hide_node)
end

local function who_name(self, robot)
	if self.mode == "online" and robot == self.me then return "Tu" end
	return self.names[robot]
end

local function my_turn(self)
	return self.mode == "local" or (self.mode == "online" and self.g.current == self.me)
end

local function handle_event(self, e)
	if SIMULA then print("SIMULA evento " .. e.type) end
	if e.type == "explosion" then
		local row_min, row_max = e.row_min, e.row_max
		if self.mode == "online" then
			-- online il terreno lo scaviamo noi, nello stesso punto del server
			row_min, row_max = self.g.terrain:carve(e.x, e.y, e.r)
		end
		self.drawn_map = nil
		redraw_cells(self, math.floor((e.x - e.r) / CELL) - 1, row_min - 1,
			math.floor((e.x + e.r) / CELL) + 1, row_max + 1)
		explosion(self, e.x, e.y, e.r)
		self.cam_sosta, self.sosta_x, self.sosta_y = CAMERA_SOSTA, e.x, e.y
	elseif e.type == "fire" or e.type == "sniper" or e.type == "grenade" or e.type == "orb" or e.type == "shards" then
		-- rinculo del Lanciarune (e del cecchino), slancio del lancio, raffica di schegge
		local kind = (e.type == "fire" or e.type == "sniper") and "missile" or (e.type == "shards" and "shards" or "throw")
		scoria.fire(self.robots[e.robot].rig, kind)
	elseif e.type == "teleport" then
		if self.mode == "online" then
			-- lo stato col robot nella nuova posizione arriva subito dopo l'evento
			self.snap[e.robot] = true
		else
			snap_robot(self, e.robot)
		end
	elseif e.type == "teleports" then
		show_message(self, string.format("%s +%d teletrasport%s", who_name(self, e.robot), e.amount, e.amount == 1 and "o" or "i"))
	elseif e.type == "trap" then
		show_message(self, who_name(self, e.robot) .. " finisce in una trappola!")
		shock(self, e.x, e.y)
	elseif e.type == "eagle" or e.type == "hook" then
		-- colpo dritto: la traccia (bianca, o acciaio per la fune del Rampino)
		-- dalla canna al punto colpito, che sfuma in un quarto di secondo
		scoria.fire(self.robots[e.robot].rig, e.type == "eagle" and "missile" or "shards")
		local n, dx, dy = self.tracer, e.x1 - e.x0, e.y1 - e.y0
		gui.set_enabled(n, true)
		gui.cancel_animations(n)
		gui.set_position(n, vmath.vector3((e.x0 + e.x1) / 2, (e.y0 + e.y1) / 2, 0))
		gui.set_size(n, vmath.vector3(math.sqrt(dx * dx + dy * dy), e.type == "hook" and 1.5 * K or 2.5 * K, 0))
		gui.set_euler(n, vmath.vector3(0, 0, math.deg(math.atan2(dy, dx))))
		gui.set_color(n, e.type == "hook" and ui.C.ACCIAIO or WHITE)
		-- la fune del Rampino resta tesa finché tira (rope, aggiornata a ogni frame):
		-- al robot agganciato, o a chi tira se si è agganciato al terreno
		self.rope = e.type == "hook" and (e.target or e.anchor and e.robot) or nil
		if not self.rope then gui.animate(n, "color.w", 0, gui.EASING_INQUAD, 0.25, 0, hide_node) end
		if e.target then
			-- il colpo arriva dalla canna: la spinta del colpito va da lì
			self.colpo_x, self.colpo_y, self.colpo_t = e.x0, e.y0, self.clock
			if e.type == "hook" then targa.annuncio(self.robots[e.target].targa, "AGGANCIATO!") end
		end
	elseif e.type == "lunge" then
		scoria.lunge(self.robots[e.robot].rig)
	elseif e.type == "mallet" then
		scoria.fire(self.robots[e.robot].rig, "throw")
	elseif e.type == "mallet_hit" then
		-- l'onda dove ha sbattuto il martello; se chi colpisce rimbalza lo dice la sua targa
		shock(self, e.x, e.y)
		local by = self.g.robots[e.robot]
		if e.target then self.colpo_x, self.colpo_y, self.colpo_t = by.x, by.y + game.SWORD_PIVOT_Y, self.clock end
		if e.bounce then targa.annuncio(self.robots[e.robot].targa, "RIMBALZO!") end
	elseif e.type == "lunge_hit" then
		shock(self, e.x, e.y)
		self.colpo_x, self.colpo_y, self.colpo_t = e.x, e.y, self.clock
	elseif e.type == "sniper_bounce" then
		-- il colpo del cecchino rimbalza goffo: si schiaccia e tremola
		self.boing = self.clock
	elseif e.type == "sniper_hit" then
		shock(self, e.x, e.y)
		targa.annuncio(self.robots[e.target].targa, "SBALZATO!")
		self.colpo_x, self.colpo_y, self.colpo_t = e.x, e.y, self.clock
	elseif e.type == "overtime" then
		show_message(self, "Supplementari: si finisce il giro di turni")
	elseif e.type == "parachute" then
		show_message(self, "Paracadute aperto!")
	elseif e.type == "status" then
		targa.annuncio(self.robots[e.robot].targa, STATUS_TEXT[e.kind])
	elseif e.type == "heal_spawn" then
		show_message(self, "Un cerchio di cura: chi ci finisce il turno dentro si cura")
	elseif e.type == "heal" then
		targa.annuncio(self.robots[e.robot].targa, "+" .. e.amount)
	elseif e.type == "crate" then
		show_message(self, "Una cassa cade dal cielo!")
	elseif e.type == "crate_pick" then
		local verbo = (self.mode == "online" and e.robot == self.me) and " hai trovato " or " trova "
		show_message(self, who_name(self, e.robot) .. verbo .. WEAPON_FOUND[e.weapon] .. "!")
	elseif e.type == "punch_hit" then
		shock(self, e.x, e.y)
		self.colpo_x, self.colpo_y, self.colpo_t = e.x, e.y, self.clock
		self.cam_sosta, self.sosta_x, self.sosta_y = CAMERA_SOSTA * 0.5, e.x, e.y
	elseif e.type == "turn" then
		-- ogni turno ricomincia dal Lanciarune, non dall'arma del turno prima
		self.tele_armed, self.weapon = false, "missile"
		if self.mode == "online" then
			show_message(self, e.robot == self.me and "Tocca a te!" or "Turno dell'avversario")
		else
			show_message(self, "Turno di " .. self.names[e.robot])
		end
	elseif e.type == "death" then
		-- crolla e svanisce da solo; dopo 1,5 s ricompare altrove, nello stesso turno
		scoria.die(self.robots[e.robot].rig)
		targa.set_enabled(self.robots[e.robot].targa, false)
		if e.by then
			local verbo = e.env and " butta giù " or " elimina "
			show_message(self, string.format("%s%s%s! +%d", who_name(self, e.by), verbo, who_name(self, e.robot), e.points))
		end
	elseif e.type == "respawn" then
		scoria.set_enabled(self.robots[e.robot].rig, true)
		targa.set_enabled(self.robots[e.robot].targa, true)
		if self.mode == "online" then
			self.snap[e.robot] = true
		else
			snap_robot(self, e.robot)
		end
	elseif e.type == "over" then
		local text
		if self.mode == "online" then
			local mine = self.g.robots[self.me].team
			text = e.winner == mine and "Hai vinto!" or (e.winner and "Hai perso!" or "Pareggio!")
		else
			text = e.winner and ("Vince " .. TEAM_NAMES[e.winner] .. "!") or "Pareggio!"
		end
		if e.reason == "time" then text = "Tempo scaduto!\n" .. text end
		show_message(self, text, true)
		self.fine_online = self.mode == "online"
		self.mode = "ended"
		-- dopo un attimo (o al primo tocco) il podio coi risultati
		self.risultati = e.results
		self.podio_t = PODIO_ATTESA
	end
end

-- Il podio, coi risultati della partita appena finita. Chi gioca su questo
-- telefono (online il suo robot, in locale il primo) guadagna esperienza.
local function apri_podio(self)
	self.podio_t = nil
	local res = self.risultati
	local giocatori, me = {}, self.fine_online and self.me or nil
	for i in ipairs(self.g.robots) do
		local nome = (self.fine_online and i == self.me) and "Tu" or self.names[i]
		giocatori[i] = { nome = nome, colore = self.colors[i] }
	end
	local mio = me or 1
	local posto, presi = #res.ranking, {}
	for _, v in ipairs(res.ranking) do
		if v.robot == mio then posto = v.place end
	end
	local per_robot = riconoscimenti.assign(res.ranking)
	presi = per_robot[mio] or presi
	local guadagno = profilo.fine_partita(self.profilo, posto, presi)
	profilo.salva(self.profilo)
	show_message(self, "", true)
	set_controls_visible(self, false)
	-- prima la schermata, poi il modo: se new si rompe non resta un modo senza schermata
	self.schermata = { mod = podio, obj = podio.new(res, giocatori, me, guadagno, self.profilo) }
	self.mode = "schermata"
end

local function apri_schermata(self, mod, ...)
	home.hide(self.home)
	self.schermata = { mod = mod, obj = mod.new(...) }
	self.mode = "schermata"
end

-- Online ------------------------------------------------------------------------

local function send(self, msg)
	if self.conn then
		ws.send(self.conn, json.encode(msg), { type = ws.DATA_TYPE_TEXT })
	end
end

local function apply_state(self, s)
	local g = self.g
	g.phase, g.current, g.timer = s.phase, s.cur, s.timer
	g.window, g.teleports, g.overtime = s.win or 0, s.tp or 0, s.ot or false
	local u = s.u or 0
	g.used.primary, g.used.secondary, g.used.hook = u % 2 == 1, u % 4 >= 2, u >= 4
	g.match_left = s.mt or g.match_left
	for i, r in ipairs(s.r) do
		local rb = g.robots[i]
		rb.x, rb.y, rb.hp, rb.facing, rb.dead, rb.grounded = r.x, r.y, r.hp, r.f, r.d, r.g
		rb.teleports_left, rb.turns, rb.points = r.tl or 0, r.tu or 1, r.pt or 0
		rb.max_hp = r.mh or rb.max_hp
		rb.swing = (r.s or 0) > 0 and r.s or nil
		rb.swing_dir = (r.sd or 0) ~= 0 and r.sd or rb.facing
		rb.punch = (r.pu or 0) > 0 and r.pu or nil
		rb.punch_dir = (r.pd or 0) ~= 0 and r.pd or rb.facing
		rb.swing_base, rb.punch_base = r.sb or 0, r.pb or 0
		rb.ammo.grenade, rb.ammo.shards, rb.ammo.punch = r.ag or 0, r.as or 0, r.ap or 0
		rb.ammo.sniper = r.ac or 0
		rb.secondary = (r.sw or "") ~= "" and r.sw or nil
		rb.lunge = (r.lu or 0) > 0 and r.lu or nil
		rb.hooked = (r.hk or 0) > 0 and { by = r.hk } or (r.hk or 0) < 0 and { x = r.hx, y = r.hy } or nil
		rb.mallet = (r.ml or 0) > 0 and r.ml or nil
		rb.mallet_stop = (r.ms or 0) > 0 and r.ms or nil
		rb.mallet_dir = (r.md or 0) ~= 0 and r.md or nil
		rb.ammo.trap, rb.ammo.shield, rb.ammo.trampoline = r.ak or 0, r.ad or 0, r.am or 0
		rb.shield = (r.sh or 0) > 0 and r.sh or nil
		rb.parachute = r.pa or false
		rb.parachutes_left = r.pl or 0
		-- turni rimasti: bruciatura, rallentamento x 10, armatura incrinata x 100
		local st = r.st or 0
		for k, kind in ipairs({ "burn", "slow", "cracked" }) do
			local turns = math.floor(st / 10 ^ (k - 1)) % 10
			rb.status[kind] = turns > 0 and { turns = turns } or nil
		end
	end
	g.projectile = s.p and { x = s.p.x, y = s.p.y, kind = s.p.k, fuse = s.p.fu } or nil
	g.orbs = {}
	for i, o in ipairs(s.o or {}) do g.orbs[i] = { id = o.i, x = o.x, y = o.y } end
	for i = 1, game.SHARD_COUNT do g.shards[i] = nil end
	for _, sh in ipairs(s.s or {}) do g.shards[sh.i] = sh end
	-- trappole e trampolini posati
	for i = #g.placed, 1, -1 do g.placed[i] = nil end
	for i, o in ipairs(s.pl or {}) do
		g.placed[i] = { id = o.i, kind = o.k, x = o.x, y = o.y, armed = o.a, team = o.tm, r = o.r, flying = o.v }
	end
	-- cerchi di cura
	for i = #g.heals, 1, -1 do g.heals[i] = nil end
	for i, h in ipairs(s.hl or {}) do g.heals[i] = { id = h.i, x = h.x, y = h.y } end
	-- casse: tabelle riusate per id
	local list = g.crates
	for i = #list, 1, -1 do list[i] = nil end
	for i, c in ipairs(s.c or {}) do
		local t = self.crate_tabs[c.i] or {}
		self.crate_tabs[c.i] = t
		t.id, t.x, t.y, t.landed = c.i, c.x, c.y, c.l
		list[i] = t
	end
	-- si riparte da dove siamo sullo schermo verso il nuovo stato
	advance_pose(self.pose_a, self.pose_b, pose_k(self))
	capture(self.pose_b, g)
	for i in pairs(self.snap) do
		snap_robot(self, i)
		self.snap[i] = nil
	end
	self.pose_t = 0
	self.pose_dt = game.SNAPSHOT_TICKS * game.DT
end

local function on_server_message(self, m)
	if m.t == "wait" then
		show_message(self, "In attesa di un avversario...", true)
	elseif m.t == "draft" then
		-- scelta dell'arma: per ora online non c'è la schermata, allo scadere
		-- il server dà a ognuno la prima arma libera. Il gettone serve già
		-- per tornare se la connessione cade adesso.
		self.tok, self.tries = m.tok or self.tok, 0
		show_message(self, "Avversari trovati!\nLa partita sta per cominciare...", true)
	elseif m.t == "start" then
		-- anche quando torniamo dopo una caduta (resume): la partita si
		-- ricostruisce dal seed, poi arrivano gli scavi e lo stato.
		-- players: le squadre dei robot, [{"team":1},...] (senza, un 1 contro 1)
		new_match(self, m.seed, m.map, m.players and { players = m.players })
		self.g:pop_events()
		self.me, self.tok, self.tries = m.you, m.tok, 0
		self.mode = "online"
		set_controls_visible(self, true)
		show_message(self, m.resume and "Di nuovo in partita!" or ("Sei " .. self.names[m.you]))
	elseif m.t == "sync" and self.g then
		for _, c in ipairs(m.x) do self.g.terrain:carve(c[1], c[2], c[3]) end
		self.drawn_map = nil
		draw_terrain(self)
	elseif m.t == "state" and self.g then
		apply_state(self, m)
	elseif m.t == "ev" then
		handle_event(self, m)
	elseif m.t == "away" then
		show_message(self, "L'avversario ha perso la connessione...", true)
	elseif m.t == "back" and m.robot ~= self.me then
		show_message(self, "L'avversario è tornato")
	elseif m.t == "left" then
		self.mode = "ended"
		show_message(self, "L'avversario è uscito\nTocca per tornare al menu", true)
	elseif m.t == "error" then
		self.mode, self.tok = "ended", nil
		show_message(self, (SERVER_ERRORS[m.e] or "Errore del server") .. "\nTocca per tornare al menu", true)
	end
end

local on_socket

local function connect(self)
	self.conn = ws.connect(server_url(), { timeout = 5000 }, on_socket)
end

on_socket = function(self, conn, data)
	if data.event == ws.EVENT_CONNECTED then
		-- il primo messaggio dice la versione: in coda, o di nuovo nella partita
		if self.tok then
			send(self, { t = "hello", v = PROTOCOL, tok = self.tok })
		else
			show_message(self, "Connesso, in attesa...", true)
			send(self, { t = "hello", v = PROTOCOL, mode = "1v1" })
		end
	elseif data.event == ws.EVENT_MESSAGE then
		local ok, m = pcall(json.decode, data.message)
		if ok and m then on_server_message(self, m) end
	elseif data.event == ws.EVENT_DISCONNECTED or data.event == ws.EVENT_ERROR then
		self.conn = nil
		if (self.mode == "online" or self.mode == "connecting") and self.tok and self.tries < RECONNECT_TRIES then
			-- in partita: riproviamo, il server ci tiene il posto
			self.tries = self.tries + 1
			show_message(self, "Connessione persa\nMi riconnetto...", true)
			timer.delay(RECONNECT_WAIT, false, function()
				if (self.mode == "online" or self.mode == "connecting") and not self.conn then connect(self) end
			end)
		elseif self.mode ~= "menu" and self.mode ~= "ended" then
			self.mode = "ended"
			show_message(self, "Connessione persa\nTocca per tornare al menu", true)
		end
	end
end

local function hide_menu(self)
	home.hide(self.home)
	msg.post("/terreno", "enable")
end

local function start_online(self)
	hide_menu(self)
	if not ws then
		-- l'estensione si scarica con Project -> Fetch Libraries
		self.mode = "ended"
		show_message(self, "Manca l'estensione WebSocket\nIn Defold: Project > Fetch Libraries\nTocca per tornare al menu", true)
		return
	end
	self.mode, self.tok, self.tries = "connecting", nil, 0
	show_message(self, "Connessione a\n" .. server_url(), true)
	connect(self)
end

local start_local_match

-- Tutorial (battaglia/tutorial.lua): un passo alla volta, ognuno una partita
-- col suo bersaglio; titolo e consiglio restano in alto.
local function tutorial_step(self)
	local t = self.tut
	new_match(self, os.time(), tutorial.MAPPA, tutorial.opzioni(t))
	tutorial.prepara(t, self.g)
	snap_robot(self, 2)
	self.g:pop_events()
	local p = tutorial.passo(t)
	gui.set_text(self.tut_label, p.titolo .. "\n" .. p.consiglio)
	self.tut_wait = nil
	self.mode = "local"
	set_controls_visible(self, true)
end

-- Obiettivo del passo raggiunto: un attimo per vederlo, poi il passo dopo
local function tutorial_update(self, dt)
	local t = self.tut
	if not self.tut_wait then
		if tutorial.fatto(t, self.g) then
			self.tut_wait = 1.5
			show_message(self, "Fatto!")
		end
		return
	end
	self.tut_wait = self.tut_wait - dt
	if self.tut_wait > 0 then return end
	if tutorial.avanti(t) then
		tutorial_step(self)
	else
		self.tut, self.tut_wait = nil, nil
		gui.set_text(self.tut_label, "")
		self.mode = "ended"
		set_controls_visible(self, false)
		show_message(self, "Tutorial finito!\nTocca per tornare al menu", true)
	end
end

-- Si parte con la scelta delle armi (menu/scelta.lua); finita quella, la partita
local function start_local(self)
	hide_menu(self)
	-- [megablast] tutorial = 1: STESSO TELEFONO apre il tutorial (finché la home
	-- non ha il suo pulsante)
	if config_int("megablast.tutorial", 0) > 0 then
		self.tut = tutorial.new()
		tutorial_step(self)
		return
	end
	-- [megablast] giocatori = 1v1, 2v2 o ffa (tutti contro tutti), sullo stesso telefono
	local opts = { players = gconfig.MODES[config_string("megablast.giocatori", "1v1")] }
	self.local_opts = opts
	-- negli scenari di prova la scelta c'è solo con prova_scelta 1 (scenario scelta.txt)
	if SIMULA and config_int("megablast.prova_scelta", 0) == 0 then
		start_local_match(self, nil)
		return
	end
	local nomi, colori = names_colors(opts.players)
	self.mode = "scelta"
	scelta_armi.show(self.scelta, draft.new(os.time(), opts.players), nomi, colori)
end

-- La partita sullo stesso telefono, con i giocatori usciti dalla scelta (nil: senza scelta)
start_local_match = function(self, picked)
	local opts = self.local_opts
	if picked then opts = { players = picked } end
	if SIMULA then
		-- solo per gli scenari di prova (comando "imposta" in strumenti/simula)
		local colpi = config_int("megablast.prova_armi", 0)
		local ogni = config_int("megablast.prova_casse", 0)
		local vita = config_int("megablast.prova_vita", 0)
		-- prova_secondaria = eagle | mallet | lunge: tutti hanno quella secondaria
		local secondaria = config_string("megablast.prova_secondaria", "")
		opts = {
			players = opts.players,
			hp = vita > 0 and vita or nil,
			secondary = game.SECONDARY[secondaria] and secondaria or nil,
			ammo = colpi > 0 and { grenade = colpi, shards = colpi, punch = colpi, sniper = colpi,
				trap = colpi, shield = colpi, trampoline = colpi } or nil,
			crate_every = ogni > 0 and ogni or nil,
		}
	end
	-- il primo robot gioca con l'assetto attivo del profilo (copia: MODES non si tocca)
	local mio = profilo.assetto_attivo(self.profilo)
	local players = {}
	for i, p in ipairs(opts.players) do
		players[i] = {}
		for k, v in pairs(p) do players[i][k] = v end
	end
	players[1].stats = assetto.stats(game.base_stats(), mio, profilo.tier(self.profilo, mio))
	opts.players = players
	new_match(self, os.time(), self.mappa, opts)
	-- prova_durata N: la partita dura N secondi (scenari/podio.txt)
	local durata = SIMULA and config_int("megablast.prova_durata", 0) or 0
	if durata > 0 then self.g.match_left = durata * 60 end
	if SIMULA and config_int("megablast.prova_stati", 0) > 0 then
		-- tutti partono con i tre effetti di stato, per vederli (scenario stati.txt)
		for _, rb in ipairs(self.g.robots) do
			for kind in pairs(gconfig.STATUS) do rb.status[kind] = { turns = 2 } end
		end
	end
	self.mode = "local"
	set_controls_visible(self, true)
end

-- Rendering -------------------------------------------------------------------

local function current_robot(self)
	return self.g.robots[self.g.current]
end

-- snap: la mira va subito sul dito (quando lo si appoggia). Altrimenti con
-- game.AIM_SMOOTH < 1 la mira lo insegue (smooth_aim), come in Blastron.
-- (x, y) sono sullo schermo: la direzione si prende nel mondo, la distanza (e
-- quindi la potenza) resta in pixel dello schermo, uguale a ogni zoom.
local function aim_from(self, x, y, snap)
	local rb = current_robot(self)
	self.aim_sx, self.aim_sy = x, y
	local wx, wy = camera.al_mondo(self.cam, x, y)
	local dx, dy = wx - rb.x, wy - (rb.y + game.ROBOT_H / 2)
	self.aim_target = math.atan2(dy, dx)
	if snap or game.AIM_SMOOTH >= 1 or not self.aim_angle then self.aim_angle = self.aim_target end
	self.aim_dist = math.sqrt(dx * dx + dy * dy) * self.cam.s
	self.aim_power = game.aim_power(self.aim_dist / AIM_RANGE)
end

local function smooth_aim(self, dt)
	if not (self.aiming and self.aim_target) or game.AIM_SMOOTH >= 1 then return end
	local d = (self.aim_target - self.aim_angle + math.pi) % (2 * math.pi) - math.pi
	self.aim_angle = self.aim_angle + d * (1 - (1 - game.AIM_SMOOTH) ^ (dt * 60))
end

-- Comandi del movimento: tastiera o levetta
local function move_left(self)
	return self.keys.left or (self.move_st.moving and self.move_st.dir < 0)
end
local function move_right(self)
	return self.keys.right or (self.move_st.moving and self.move_st.dir > 0)
end
local function jump_held(self)
	return self.keys.jump or self.move_st.jumping
end

-- Levette ---------------------------------------------------------------------

local PAD_POS = vmath.vector3(0, 0, 0)

local function new_pad(rest, ring_color)
	local pad = { rest = rest }
	pad.base = stretch(gui.new_box_node(vmath.vector3(rest.x, rest.y, 0), vmath.vector3(PAD_D, PAD_D, 0)))
	gui.set_texture(pad.base, "battaglia")
	gui.play_flipbook(pad.base, "levetta_base")
	pad.ring = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(PAD_D, PAD_D, 0))
	gui.set_texture(pad.ring, "battaglia")
	gui.play_flipbook(pad.ring, "levetta_anello")
	gui.set_blend_mode(pad.ring, gui.BLEND_ADD)
	gui.set_color(pad.ring, ring_color)
	gui.set_parent(pad.ring, pad.base)
	pad.knob = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(KNOB_D, KNOB_D, 0))
	gui.set_texture(pad.knob, "battaglia")
	gui.play_flipbook(pad.knob, "levetta_pomello")
	gui.set_parent(pad.knob, pad.base)
	return pad
end

-- Il pollice si appoggia in (x, y): la base va lì, senza uscire dallo schermo
local function pad_press(pad, id, x, y)
	pad.id, pad.x0, pad.y0 = id, x, y
	local h = PAD_D / 2
	PAD_POS.x = math.max(h, math.min(W - h, x))
	PAD_POS.y = math.max(h, math.min(H - h, y))
	pad.bx, pad.by = PAD_POS.x, PAD_POS.y
	gui.set_position(pad.base, PAD_POS)
end

-- Il pollice è in (x, y): torna lo spostamento dal punto in cui si è
-- appoggiato, in frazioni della corsa (lunghezza al massimo 1)
local function pad_drag(pad, x, y)
	local dx, dy = (x - pad.x0) / PAD_R, (y - pad.y0) / PAD_R
	local mag = math.sqrt(dx * dx + dy * dy)
	if mag > 1 then dx, dy = dx / mag, dy / mag end
	PAD_POS.x = pad.x0 - pad.bx + dx * PAD_R
	PAD_POS.y = pad.y0 - pad.by + dy * PAD_R
	gui.set_position(pad.knob, PAD_POS)
	return dx, dy
end

local function pad_release(pad, ring_color)
	pad.id = nil
	PAD_POS.x, PAD_POS.y = pad.rest.x, pad.rest.y
	gui.set_position(pad.base, PAD_POS)
	PAD_POS.x, PAD_POS.y = 0, 0
	gui.set_position(pad.knob, PAD_POS)
	gui.set_color(pad.ring, ring_color)
end

local function move_pad_drag(self, x, y)
	local nx, ny = pad_drag(self.move_pad, x, y)
	if levette.muovi(self.move_st, nx, ny) then self.jump_pressed = true end
	local on = self.move_st.moving or self.move_st.jumping
	gui.set_color(self.move_pad.ring, on and MOVE_LIVE or MOVE_IDLE)
end

local function aim_pad_drag(self, x, y)
	local st = self.aim_st
	local was = st.active
	levette.mira(st, pad_drag(self.aim_pad, x, y))
	self.aim_target = st.angle
	-- appena si accende la mira va subito sulla levetta, poi la insegue
	if (st.active and not was) or game.AIM_SMOOTH >= 1 or not self.aim_angle then self.aim_angle = st.angle end
	self.aim_power = math.max(0.1, st.f ^ game.AIM_EXPONENT)
	self.aim_dist = math.huge
	self.aiming = st.active
	gui.set_color(self.aim_pad.ring, st.active and AIM_LIVE or AIM_IDLE)
end

-- Il pollice si stacca dalla levetta della mira: parte il colpo se la levetta
-- era accesa un attimo prima (levette.RILASCIO), con la mira di allora
local function aim_pad_release(self)
	local st = self.aim_st
	local h = levette.al_rilascio(st, self.clock)
	local live = h and h.active
	if (live or st.active) and self.g:can_use(self.tele_armed and "teleport" or self.weapon) and my_turn(self) then
		self.fire = { angle = live and h.angle or self.aim_angle, power = live and h.power or self.aim_power,
			weapon = self.tele_armed and "teleport" or self.weapon }
		self.tele_armed = false
	end
	levette.reset(st)
	self.aiming = false
	pad_release(self.aim_pad, AIM_IDLE)
end

local function move_pad_release(self)
	levette.reset(self.move_st)
	pad_release(self.move_pad, MOVE_IDLE)
end

-- Levette accese (telefono) o spente (computer)
local function set_touch_ui(self, on)
	if self.touch_ui == on then return end
	if self.move_pad.id then move_pad_release(self) end
	if self.aim_pad.id then
		levette.reset(self.aim_st)
		self.aiming = false
		pad_release(self.aim_pad, AIM_IDLE)
	end
	self.touch_ui = on
	gui.set_position(self.btn_tele, on and TELE_TOUCH or TELE_DESK)
	gui.set_enabled(self.tele_key, not on)
	if self.controls_visible ~= nil then set_controls_visible(self, self.controls_visible) end
end


local function set_hud(self, text)
	if self.hud_text ~= text then
		gui.set_text(self.hud, text)
		self.hud_text = text
	end
end

-- Barra delle armi -------------------------------------------------------------

-- Di chi sono le armi nella barra: online le nostre, in locale di chi è di turno
local function bar_robot(self)
	if self.mode == "online" then return self.g.robots[self.me] end
	return current_robot(self)
end

-- Lo slot si vede? Il paracadute finché ne restano o è già aperto; il Rampino sempre.
local function slot_have(rb, w)
	if w == "parachute" then
		return rb.parachute or rb.parachutes_left > 0
	elseif w == "hook" then
		return true
	end
	return game.has_weapon(rb, w)
end

local function update_bar(self)
	local rb = bar_robot(self)
	if not rb then return end
	local g = self.g
	-- finiti i colpi (o lanciato il Rampino del turno) si torna al Lanciarune
	if not slot_have(rb, self.weapon) or (self.weapon == "hook" and g.used.hook) then self.weapon = "missile" end
	-- dopo il primo attacco si passa da soli all'altro (arma o spada)
	if g.window > 0 and rb.id == g.current and not g:can_use(self.weapon) then
		local other = game.SECONDARY[self.weapon] and "missile" or "sword"
		if g:can_use(other) then self.weapon = other end
	end
	local turn = rb.id == g.current and g.phase == "aim"
	-- larghezza della barra: gli slot visibili, con più spazio tra un gruppo e l'altro
	local width, last = -SLOT_GAP, nil
	for _, sl in ipairs(self.slots) do
		if slot_have(rb, sl.weapon) then
			width = width + SLOT + (last and last ~= sl.group and GROUP_GAP or SLOT_GAP)
			last = sl.group
		end
	end
	local x, from, to = W / 2 - width / 2 + SLOT / 2, {}, {}
	last = nil
	for _, sl in ipairs(self.slots) do
		local have = slot_have(rb, sl.weapon)
		if sl.have ~= have then
			gui.set_enabled(sl.node, have)
			sl.have = have
		end
		if have then
			if last and last ~= sl.group then x = x + GROUP_GAP - SLOT_GAP end
			last = sl.group
			from[sl.group] = from[sl.group] or x
			to[sl.group] = x
			if sl.x ~= x then
				set_pos(sl.node, x, BAR_Y)
				sl.x = x
			end
			x = x + SLOT + SLOT_GAP
			local count = rb.ammo[sl.weapon] or 0
			if sl.count ~= count then
				gui.set_text(sl.label, count > 0 and ("x" .. count) or "")
				sl.count = count
			end
			-- 2: scelta, 1: si può usare (bordo del colore del gruppo), 0: già usata
			local on = ((sl.weapon == self.weapon and not self.tele_armed) or (sl.weapon == "parachute" and rb.parachute)) and 2
				or ((not turn or g:can_use(sl.weapon)) and 1 or 0)
			if sl.on ~= on then
				gui.set_color(sl.bordo, on == 1 and BAR_GROUPS[sl.group][2] or SLOT_BORDO[on])
				if sl.icon then gui.set_color(sl.icon, on == 0 and ICON_USED or WHITE) end
				gui.set_scale(sl.node, on == 2 and SLOT_SCALE_ON or SLOT_SCALE_OFF)
				sl.on = on
			end
		end
	end
	-- il nome di ogni gruppo sopra i suoi slot, col suo colore; spento quando
	-- in questo turno l'attacco di quel gruppo è già stato fatto
	local used = { turn and g.used.primary, turn and g.used.secondary, false }
	for i, n in ipairs(self.bar_groups) do
		local gx = from[i] and (from[i] + to[i]) / 2 or false
		if self.bar_group_x[i] ~= gx then
			gui.set_enabled(n, gx ~= false)
			if gx then set_pos(n, gx, BAR_Y + SLOT / 2 + 12) end
			self.bar_group_x[i] = gx
		end
		if self.bar_group_used[i] ~= used[i] then
			gui.set_color(n, used[i] and ui.C.SPENTO or BAR_GROUPS[i][2])
			self.bar_group_used[i] = used[i]
		end
	end
end

-- La camera sposta e ingrandisce il nodo "mondo" (tutti i nodi della battaglia)
-- e la vista del render, dove si disegna la mesh del terreno. Scritte e freccia
-- crescono meno del mondo, così da vicino non diventano enormi.
local CAM_POS, CAM_SCALE, LABEL_SCALE = vmath.vector3(0, 0, 0), vmath.vector3(1, 1, 1), vmath.vector3(1, 1, 1)
local function apply_camera(self)
	local c = self.cam
	local tx, ty = camera.spostamento(c)
	tx, ty = tx + self.sc_ox, ty + self.sc_oy
	if tx == self.cam_tx and ty == self.cam_ty and c.s == self.cam_s then return end
	self.cam_tx, self.cam_ty, self.cam_s = tx, ty, c.s
	CAM_POS.x, CAM_POS.y = tx, ty
	gui.set_position(self.mondo, CAM_POS)
	CAM_SCALE.x, CAM_SCALE.y = c.s, c.s
	gui.set_scale(self.mondo, CAM_SCALE)
	local view = self.cam_msg.view
	view.m00, view.m11, view.m03, view.m13 = c.s, c.s, tx, ty
	msg.post("@render:", "set_view_projection", self.cam_msg)
	local l = c.s ^ -0.65
	LABEL_SCALE.x, LABEL_SCALE.y = 0.7 * FONT_K * l, 0.7 * FONT_K * l
	gui.set_scale(self.cancel_label, LABEL_SCALE)
	LABEL_SCALE.x, LABEL_SCALE.y = l, l
	gui.set_scale(self.arrow, LABEL_SCALE)
end

local function render(self, dt)
	self.clock = self.clock + dt
	local g = self.g
	local k, pa, pb = pose_k(self), self.pose_a, self.pose_b
	for i, rb in ipairs(g.robots) do
		local v, r, ra, rb2 = self.view[i], self.robots[i], pa.r[i], pb.r[i]
		v.x = ra.x + (rb2.x - ra.x) * k
		-- a terra il robot sale e scende i gradini del terreno a scatti di 2 pixel:
		-- li ammorbidiamo solo nel disegno, la posizione vera non cambia
		local ty = ra.y + (rb2.y - ra.y) * k
		local dy = ty - v.y
		if rb2.g and math.abs(dy) <= game.MAX_CLIMB + 2 then
			v.y = v.y + dy * math.min(1, dt * 25)
		else
			v.y = ty
		end
		local hp = math.max(0, rb.hp)
		if v.hp ~= hp or v.scudo ~= rb.shield then
			if hp < v.hp then
				-- il colpo: lampo e spinta sul bersaglio, scossa e hit-stop
				local danno = v.hp - hp
				local cx, cy = colpo_da(self, i)
				local dx, dy = v.x - cx, v.y + game.ROBOT_H / 2 - cy
				scoria.hit(r.rig, dx)
				camera.scuoti(self.cam, dx, dy, SCOSSA_BASE + danno * SCOSSA_DANNO)
				self.fermo = math.max(self.fermo, FERMO_MIN + (FERMO_MAX - FERMO_MIN) * math.min(1, danno / 50))
			end
			v.hp, v.scudo = hp, rb.shield
			targa.vita(r.targa, hp, rb.max_hp, rb.shield)
		end
		-- la targa sopra le corna; online il nome si sa solo dopo l'inizio
		local nome = who_name(self, i)
		if v.nome ~= nome then
			targa.nome(r.targa, nome)
			v.nome = nome
		end
		-- gli effetti addosso coi turni che mancano (codice numerico per non
		-- rifare la stringa a ogni frame)
		local codice = 0
		for k, sn in ipairs(STATUS_NAME) do
			local s = rb.status[sn[1]]
			codice = codice + (s and s.turns or 0) * 10 ^ (k - 1)
		end
		if v.stato ~= codice then
			local testo = ""
			for _, sn in ipairs(STATUS_NAME) do
				local s = rb.status[sn[1]]
				if s then testo = testo .. (testo == "" and "" or "  ") .. sn[2] .. " " .. s.turns end
			end
			targa.stato(r.targa, testo)
			v.stato = codice
		end
		targa.update(r.targa, dt, v.x, v.y + scoria.ALTEZZA + 3, self.cam.s ^ -0.65)
		local vx = v.px and (v.x - v.px) / math.max(dt, 1e-4) or 0
		v.px = v.x

		-- chi mira si gira verso il dito e punta il braccio con l'arma
		local aiming = self.aiming and g.phase == "aim" and i == g.current and my_turn(self)
		local st = r.st
		-- corre solo chi si muove da sé: solo chi è di turno ha i comandi, e non
		-- quando lo sbalzano o lo tira il Rampino. Chi viene spinto resta in attesa
		local da_se = i == g.current and not rb.knocked and not rb.hooked
		st.x, st.y, st.grounded, st.moving = v.x, v.y, rb2.g, da_se and vx or 0
		st.facing = rb.facing
		st.turno = i == g.current
		st.paracadute = rb.parachute and not rb.dead
		st.aim = nil
		if aiming then
			st.aim = self.aim_angle
			st.facing = math.cos(self.aim_angle) < 0 and -1 or 1
		end

		-- in mano l'arma equipaggiata: quella scelta da chi è di turno (online
		-- conosciamo solo la nostra), il Lanciarune per gli altri
		local weapon = "missile"
		if i == g.current and my_turn(self) then
			weapon = self.tele_armed and "teleport" or self.weapon
		end
		-- mirando con la spada la lama va dietro la schiena, pronta per il colpo
		-- (è l'angolo da cui parte il fendente); col Pugno il braccio si carica in basso
		-- col modello "blastron" invece l'arma punta dove si mira: il colpo parte da lì
		if aiming and weapon == "sword" and game.SWORD_MODEL ~= "blastron" then
			st.aim = st.facing > 0 and game.SWORD_FROM or math.pi - game.SWORD_FROM
		elseif aiming and weapon == "punch" and game.PUNCH_MODEL ~= "blastron" then
			st.aim = st.facing > 0 and PUNCH_FROM or math.pi - PUNCH_FROM
		end
		-- Pugno del Titano: il braccio sale dal basso fino in alto quando il colpo arriva
		if rb.punch ~= nil and not rb.dead then
			weapon = "punch"
			local span = self.mode == "online" and game.SNAPSHOT_TICKS or 1
			local t = math.max(0, rb.punch - span + k * span)
			local a = PUNCH_FROM + (PUNCH_TO - PUNCH_FROM) * math.min(1, t / game.PUNCH_HIT_TICK)
			if game.PUNCH_MODEL == "blastron" then a = game.punch_angle(t, rb.punch_base) end
			local dir = rb.punch_dir or rb.facing
			st.aim = dir > 0 and a or math.pi - a
			st.facing = dir
		end
		-- Maglio: mirando sta alto dietro la testa (dove parte l'arco); nel colpo
		-- gira attorno alla spalla come la Lama e si ferma dove ha sbattuto
		if aiming and weapon == "mallet" then
			st.aim = st.facing > 0 and gconfig.MALLET.from or math.pi - gconfig.MALLET.from
		end
		if rb.mallet ~= nil and not rb.dead then
			weapon = "mallet"
			local span = self.mode == "online" and game.SNAPSHOT_TICKS or 1
			local a = game.mallet_angle(math.max(0, rb.mallet - span + k * span), rb.mallet_stop)
			local dir = rb.mallet_dir or rb.facing
			st.aim = dir > 0 and a or math.pi - a
			st.facing = dir
		end
		-- Affondo: la lancia punta nella direzione dello scatto
		if rb.lunge ~= nil and not rb.dead then
			weapon = "lunge"
			if rb.lunge_vx then
				st.aim = math.atan2(rb.lunge_vy, rb.lunge_vx)
				st.facing = rb.lunge_vx < 0 and -1 or 1
			end
		end
		-- Lama di Nucleo: durante il fendente il braccio segue l'angolo della lama
		if rb.swing ~= nil and not rb.dead then
			weapon = "sword"
			-- il tick del fendente è quello della posa b: lo disegniamo tra a e b
			local span = self.mode == "online" and game.SNAPSHOT_TICKS or 1
			local a = game.sword_angle(math.max(0, rb.swing - span + k * span), rb.swing_base)
			-- la direzione è quella di partenza: girarsi non cambia il fendente
			local dir = rb.swing_dir or rb.facing
			st.aim = dir > 0 and a or math.pi - a
			st.facing = dir
		end
		scoria.set_weapon(r.rig, weapon)
		scoria.update(r.rig, dt, st)
	end

	-- la fune del Rampino: dalla mano di chi tira al robot appeso; mollato, sfuma
	if self.rope then
		local rb = g.robots[self.rope]
		local n = self.tracer
		if rb.hooked and not rb.dead then
			-- dalla mano di chi tira al centro dell'appeso, o dalla mano
			-- dell'appeso al punto del terreno
			local hand = self.view[rb.hooked.by or self.rope]
			local x0, y0 = hand.x + g.robots[rb.hooked.by or self.rope].facing * game.MUZZLE * 0.5, hand.y + game.SWORD_PIVOT_Y
			local x1, y1 = rb.hooked.x, rb.hooked.y
			if rb.hooked.by then x1, y1 = self.view[self.rope].x, self.view[self.rope].y + game.ROBOT_H / 2 end
			local dx, dy = x1 - x0, y1 - y0
			set_pos(n, (x0 + x1) / 2, (y0 + y1) / 2)
			gui.set_size(n, vmath.vector3(math.sqrt(dx * dx + dy * dy), 1.5 * K, 0))
			EULER.z = math.deg(math.atan2(dy, dx))
			gui.set_euler(n, EULER)
		else
			self.rope = nil
			gui.animate(n, "color.w", 0, gui.EASING_INQUAD, 0.25, 0, hide_node)
		end
	end

	-- Uovo di Fiamma: rotola mentre vola, sopra i secondi che mancano allo scoppio
	local egg = pb.has_p and g.projectile and g.projectile.kind == "grenade"
	gui.set_enabled(self.egg, egg)
	if egg then
		local p0 = pa.has_p and pa.p or pb.p
		local x = p0.x + (pb.p.x - p0.x) * k
		set_pos(self.egg, x, p0.y + (pb.p.y - p0.y) * k)
		self.fuoco_x, self.fuoco_y = x, p0.y + (pb.p.y - p0.y) * k
		EULER.z = -x * 4
		gui.set_euler(self.egg_spin, EULER)
		gui.set_color(self.egg_light, self.colors[g.current])
		local secs = math.max(1, math.ceil((g.projectile.fuse or 0) / 60))
		if self.egg_secs ~= secs then
			gui.set_text(self.egg_label, tostring(secs))
			self.egg_secs = secs
		end
	end

	-- missile: bagliore col colore di chi ha sparato e una scia che si spegne
	local missile = pb.has_p and not egg
	gui.set_enabled(self.projectile, missile)
	if missile then
		local p0 = pa.has_p and pa.p or pb.p
		local x, y = p0.x + (pb.p.x - p0.x) * k, p0.y + (pb.p.y - p0.y) * k
		set_pos(self.projectile, x, y)
		self.fuoco_x, self.fuoco_y = x, y
		gui.set_color(self.projectile_glow, self.colors[g.current])
		gui.set_color(self.razzo_tinta, self.colors[g.current])
		gui.set_color(self.palla_tinta, self.colors[g.current])
		-- razzo e palla puntano nel verso in cui vanno
		local dx, dy = pb.p.x - p0.x, pb.p.y - p0.y
		if dx * dx + dy * dy > 0.01 then SNIPER_EULER.z = math.deg(math.atan2(dy, dx)) end
		gui.set_euler(self.projectile, SNIPER_EULER)
		local sniper = g.projectile and g.projectile.kind == "sniper"
		gui.set_enabled(self.razzo, not sniper)
		gui.set_enabled(self.palla, sniper)
		if sniper then
			-- cecchino: allungato nel verso in cui va; a ogni rimbalzo si
			-- schiaccia e tremola come una gelatina, poi torna com'era
			local t = self.clock - (self.boing or -10)
			local w = BOING_AMP * math.exp(-t * BOING_DAMP) * math.cos(t * BOING_FREQ)
			SNIPER_SCALE.x, SNIPER_SCALE.y = VK.x * (1.25 - w), VK.y * (0.85 + w)
			gui.set_scale(self.projectile, SNIPER_SCALE)
			self.sniper_shape = true
		elseif self.sniper_shape then
			gui.set_scale(self.projectile, VK)
			self.sniper_shape = false
		end
		local n = #self.trail
		self.trail_i = self.trail_i % n + 1
		local tp = self.trail_pos[self.trail_i]
		tp.x, tp.y = x, y
		self.trail_n = math.min(n, self.trail_n + 1)
		for j = 1, n do
			local node = self.trail[j]
			if j <= self.trail_n then
				local q = self.trail_pos[(self.trail_i - j) % n + 1]
				gui.set_enabled(node, true)
				set_pos(node, q.x, q.y)
			else
				gui.set_enabled(node, false)
			end
		end
	else
		self.trail_n = 0
		for _, node in ipairs(self.trail) do gui.set_enabled(node, false) end
	end

	-- Sciame di Schegge: piccoli bagliori col colore di chi spara
	local n_shards, shard_x, shard_y = 0, 0, 0
	for i = 1, game.SHARD_COUNT do
		local sb, node = pb.s[i], self.shard_nodes[i]
		gui.set_enabled(node, sb.on)
		if sb.on then
			local sa = pa.s[i].on and pa.s[i] or sb
			local x, y = sa.x + (sb.x - sa.x) * k, sa.y + (sb.y - sa.y) * k
			set_pos(node, x, y)
			-- la scheggia punta nel verso in cui va
			if sb.x ~= sa.x or sb.y ~= sa.y then
				EULER.z = math.deg(math.atan2(sb.y - sa.y, sb.x - sa.x))
				gui.set_euler(node, EULER)
			end
			n_shards, shard_x, shard_y = n_shards + 1, shard_x + x, shard_y + y
		end
	end
	if self.shard_color ~= g.current then
		for i = 1, game.SHARD_COUNT do
			gui.set_color(self.shard_nodes[i], self.colors[g.current])
			gui.set_color(self.shard_tints[i], self.colors[g.current])
		end
		self.shard_color = g.current
	end

	oggetti.update(self.oggetti, g, self.view, self.clock)

	-- casse: cadono dondolando, la runa pulsa
	for _, n in ipairs(self.crate_nodes) do
		if n.id and not pb.c[n.id] then
			n.id = nil
			gui.set_enabled(n.node, false)
		end
	end
	for id, cb in pairs(pb.c) do
		local n
		for _, cn in ipairs(self.crate_nodes) do
			if cn.id == id then n = cn; break end
		end
		if not n then
			for _, cn in ipairs(self.crate_nodes) do
				if not cn.id then n = cn; n.id = id; gui.set_enabled(n.node, true); break end
			end
		end
		if n then
			local ca = pa.c[id] or cb
			set_pos(n.node, ca.x + (cb.x - ca.x) * k, ca.y + (cb.y - ca.y) * k + game.CRATE_H / 2)
			EULER.z = cb.landed and 0 or math.sin(self.clock * 3 + id) * 10
			gui.set_euler(n.node, EULER)
			gui.set_enabled(n.chute, not cb.landed)
			n.light_col.w = 0.75 + 0.25 * math.sin(self.clock * 4 + id)
			gui.set_color(n.light, n.light_col)
		end
	end
	EULER.z = 0

	-- globi del teletrasporto, col cuore del colore di chi l'ha lanciato
	for i, node in ipairs(self.orbs) do
		local on = i <= pb.no
		gui.set_enabled(node.root, on)
		if on then
			local ob = pb.o[i]
			local o0 = find_orb(pa, ob.id) or ob
			set_pos(node.root, o0.x + (ob.x - o0.x) * k, o0.y + (ob.y - o0.y) * k)
			gui.set_color(node.light, self.colors[g.current])
			gui.set_color(node.glow, self.colors[g.current])
		end
	end

	-- pulsanti: arma scelta e teletrasporto (anche con altri globi in volo)
	local tele_ok = g:can_use("teleport") and my_turn(self)
	if self.tele_armed and not tele_ok then self.tele_armed = false end
	update_bar(self)
	local tele_state = self.tele_armed and 2 or (tele_ok and 1 or 0)
	if self.tele_state ~= tele_state then
		gui.set_color(self.tele_bordo, SLOT_BORDO[tele_state])
		gui.set_scale(self.btn_tele, tele_state == 2 and SLOT_SCALE_ON or SLOT_SCALE_OFF)
		self.tele_state = tele_state
	end
	gui.set_color(self.tele_light, self.colors[g.current])

	local aim_weapon = self.tele_armed and "teleport" or self.weapon
	-- col dito sul robot il colpo è annullato: niente traiettoria, solo la scritta
	local can_aim = g:can_use(aim_weapon) and my_turn(self)
	local cancel = self.aiming and can_aim and self.aim_dist <= CANCEL_R
	gui.set_enabled(self.cancel_label, cancel)
	if cancel then
		local v = self.view[g.current]
		set_pos(self.cancel_label, v.x, v.y - 14)
	end
	local show_aim = self.aiming and can_aim and not MELEE[aim_weapon] and not cancel
	if show_aim then
		local pts = g:preview(self.aim_angle, self.aim_power, AIM_DOTS, 4, self.preview_pts, aim_weapon)
		-- Blastron mostra solo l'inizio del volo: una freccia lunga quanto la potenza
		local shown = game.AIM_PREVIEW_DOTS or AIM_DOTS
		for i, n in ipairs(self.dots) do
			gui.set_enabled(n, i <= shown)
			set_pos(n, pts[i].x, pts[i].y)
		end
	else
		for _, n in ipairs(self.dots) do gui.set_enabled(n, false) end
	end

	local secs = math.max(0, math.ceil(g.timer / 60))
	-- tempo rimasto della partita; a zero si finisce il giro di turni
	local left = math.max(0, math.ceil(g.match_left / 60))
	local clock = g.overtime and "SUPPLEMENTARI" or string.format("%d:%02d", math.floor(left / 60), left % 60)
	local who = self.names[g.current]
	if self.mode == "online" then who = g.current == self.me and "Tu" or "Avversario" end
	-- la barra racconta il turno: bianca, gialla finché c'è il secondo attacco, blu dopo
	local bar_left, bar_total, bar_color = g.timer, game.TURN_TICKS, TIME_COLOR
	if g.phase ~= "aim" then
		set_hud(self, g.phase ~= "over" and string.format("%s   %s", who, clock) or "")
		bar_left = 0
	elseif g.window > 0 then
		local second = not (g.used.primary and g.used.secondary)
		set_hud(self, string.format(second and "%s   secondo attacco! %ds   %s" or "%s   riparati! %ds   %s",
			who, math.ceil(g.window / 60), clock))
		bar_left, bar_total, bar_color = g.window, game.AFTER_ATTACK_TICKS, second and SECOND_COLOR or DONE_COLOR
		if g.window <= 120 and math.sin(self.clock * 16) < 0 then bar_left = 0 end
	else
		set_hud(self, string.format("%s   %ds   %s", who, secs, clock))
	end
	local bar_w = math.floor(TIME_BAR_W * bar_left / bar_total + 0.5)
	if self.time_bar_w ~= bar_w or self.time_bar_c ~= bar_color then
		gui.set_size(self.time_bar, vmath.vector3(bar_w, TIME_BAR_H, 0))
		gui.set_color(self.time_bar, bar_color)
		self.time_bar_w, self.time_bar_c = bar_w, bar_color
	end
	-- nell'attesa del secondo attacco le secondarie lampeggiano, se sono loro che restano
	local blink = g.window > 0 and my_turn(self) and math.sin(self.clock * 12) > 0
	for _, sl in ipairs(self.slots) do
		if sl.glow then gui.set_enabled(sl.glow, blink and sl.have and g:can_use(sl.weapon)) end
	end
	-- punti di ogni squadra, in alto a sinistra
	local score = ""
	for t = 1, #TEAM_NAMES do
		local pts, any = 0, false
		for _, rb in ipairs(g.robots) do
			if rb.team == t then pts, any = pts + rb.points, true end
		end
		if any then score = score .. string.format("%s %d   ", TEAM_NAMES[t], math.floor(pts + 0.5)) end
	end
	if self.score_text ~= score then
		gui.set_text(self.score_label, score)
		self.score_text = score
	end
	local n = bar_robot(self)
	local tele = n and n.teleports_left or 0
	if self.tele_n ~= tele then
		gui.set_text(self.tele_label, "TELETRASPORTI " .. tele)
		self.tele_n = tele
	end

	-- freccia sopra il robot di turno
	local cur = current_robot(self)
	local v = self.view[g.current]
	gui.set_enabled(self.arrow, g.phase == "aim" and not cur.dead and (self.mode == "local" or self.mode == "online"))
	set_pos(self.arrow, v.x, v.y + scoria.ALTEZZA + (58 + math.sin(self.clock * 5) * 3) / self.cam.s)
	gui.set_color(self.arrow, self.colors[g.current])

	-- Camera: segue il colpo in volo, poi resta un attimo sull'esplosione, poi
	-- torna su chi è di turno. Nel menu si vede tutta la mappa.
	local c = self.cam
	if self.mode == "menu" then
		camera.segui(c, dt, game.WORLD_W / 2, game.WORLD_H / 2, camera.tutta(c))
	else
		local fx, fy, veloce = v.x, v.y + game.ROBOT_H / 2, false
		self.cam_sosta = math.max(0, self.cam_sosta - dt)
		if missile or egg then
			fx, fy, veloce = self.fuoco_x, self.fuoco_y, true
			self.cam_sosta = 0
		elseif n_shards > 0 then
			fx, fy, veloce = shard_x / n_shards, shard_y / n_shards, true
			self.cam_sosta = 0
		elseif self.cam_sosta > 0 then
			fx, fy = self.sosta_x, self.sosta_y
		end
		camera.segui(c, dt, fx, fy, camera.zoom(c), veloce)
	end
	apply_camera(self)
end

-- Ciclo di vita -------------------------------------------------------------

function init(self)
	msg.post(".", "acquire_input_focus")
	self.keys = {}
	self.preview_pts = {}

	self.clock = 0

	-- tutto quello che sta nel mondo è figlio di questo nodo, che la camera
	-- sposta e ingrandisce (apply_camera)
	self.cam = camera.new(W, H, game.WORLD_W, game.WORLD_H)
	self.cam.livello = math.min(#camera.LIVELLI, math.max(1, ZOOM_INIZIO))
	-- set_view_projection vuole anche id e projection; la proiezione resta quella
	-- del render (stretch), che questa non cambia
	self.cam_msg = { id = hash("camera"), view = vmath.matrix4(), projection = vmath.matrix4() }
	self.cam_sosta = 0
	self.fermo, self.sc_ox, self.sc_oy = 0, 0, 0
	self.mondo = stretch(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0)))
	gui.set_visible(self.mondo, false)

	self.robots = {}
	for i = 1, game.MAX_PLAYERS do
		local r = { rig = scoria.new(TEAM_COLORS[i]), st = {} }
		self.robots[i] = r
	end

	-- puntini della traiettoria: piccoli bagliori bianchi
	self.dots = {}
	for i = 1, AIM_DOTS do
		local n = glow(0, 0, 14 - i * 0.5, vmath.vector4(1, 1, 1, 1 - i / (AIM_DOTS + 4)))
		self.dots[i] = n
	end

	-- missile: scia, alone col colore della squadra e nocciolo bianco
	self.trail, self.trail_pos, self.trail_i, self.trail_n = {}, {}, 0, 0
	for i = 1, 8 do
		self.trail[i] = glow(0, 0, (16 - i * 1.4) * K, vmath.vector4(1, 0.6, 0.3, 0.55 - i * 0.06))
		self.trail_pos[i] = { x = 0, y = 0 }
	end
	self.projectile = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_visible(self.projectile, false)
	gui.set_adjust_mode(self.projectile, gui.ADJUST_STRETCH)
	self.projectile_glow = glow(0, 0, 34, WHITE)
	gui.set_parent(self.projectile_glow, self.projectile)
	self.razzo, self.razzo_tinta = colpo("razzo", 1 / K)
	gui.set_parent(self.razzo, self.projectile)
	self.palla, self.palla_tinta = colpo("palla", 1 / K)
	gui.set_parent(self.palla, self.projectile)
	gui.set_scale(self.projectile, VK)

	-- globo del teletrasporto: piccolo e tondo
	self.orbs = {}
	for i = 1, game.MAX_ORBS do
		local root = stretch(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0)))
		gui.set_visible(root, false)
		local orb_glow = glow(0, 0, 30, WHITE)
		gui.set_parent(orb_glow, root)
		local img, light = colpo("globo", 1 / K)
		gui.set_parent(img, root)
		gui.set_enabled(root, false)
		gui.set_scale(root, VK)
		self.orbs[i] = { root = root, glow = orb_glow, light = light }
	end

	-- Uovo di Fiamma in volo
	self.egg = stretch(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0)))
	gui.set_visible(self.egg, false)
	gui.set_parent(glow(0, 0, 36, BRACE), self.egg)
	self.egg_spin = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_visible(self.egg_spin, false)
	gui.set_parent(self.egg_spin, self.egg)
	local egg_img
	egg_img, self.egg_light = colpo("uovo", 1 / K)
	gui.set_parent(egg_img, self.egg_spin)
	self.egg_label = label(0, 26, "3", 0.7 / K)
	gui.set_parent(self.egg_label, self.egg)
	gui.set_enabled(self.egg, false)
	gui.set_scale(self.egg, VK)

	-- schegge dello Sciame
	self.shard_nodes, self.shard_tints = {}, {}
	for i = 1, game.SHARD_COUNT do
		local n = glow(0, 0, 22, WHITE)
		local img, tinta = colpo("scheggia", 1 / K)
		gui.set_parent(img, n)
		self.shard_tints[i] = tinta
		gui.set_scale(n, VK)
		gui.set_enabled(n, false)
		self.shard_nodes[i] = n
	end

	-- trappole, trampolini, cerchi di cura, scudi e paracadute (battaglia/oggetti.lua)
	self.oggetti = oggetti.new(TEAM_COLORS)

	-- casse (ne servono al massimo CRATE_MAX), con un bagliore sopra mentre cadono
	self.crate_nodes = {}
	for i = 1, game.CRATE_MAX do
		local n = stretch(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(64 * 0.4, 56 * 0.4, 0)))
		gui.set_texture(n, "battaglia")
		gui.play_flipbook(n, "cassa")
		local chute = glow(0, 20, 40, vmath.vector4(1, 0.8, 0.5, 0.45))
		gui.set_parent(chute, n)
		local light = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(64 * 0.4, 56 * 0.4, 0))
		gui.set_texture(light, "battaglia")
		gui.play_flipbook(light, "cassa_luce")
		gui.set_blend_mode(light, gui.BLEND_ADD)
		gui.set_parent(light, n)
		gui.set_enabled(n, false)
		gui.set_scale(n, VK)
		self.crate_nodes[i] = { node = n, chute = chute, light = light, light_col = vmath.vector4(BRACE) }
	end

	-- onda d'urto del Pugno
	self.shock = glow(0, 0, 20, BRACE)
	gui.set_enabled(self.shock, false)
	-- traccia dei colpi dritti (Tonante, Rampino)
	self.tracer = box(0, 0, 1, 1, WHITE)
	gui.set_enabled(self.tracer, false)

	-- esplosioni riusate a giro
	self.booms, self.boom_i = {}, 0
	for i = 1, 10 do
		local anim = stretch(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(100, 100, 0)))
		gui.set_texture(anim, "esplosione")
		gui.play_flipbook(anim, "esplosione")
		gui.set_enabled(anim, false)
		local flash = glow(0, 0, 100, BRACE)
		gui.set_enabled(flash, false)
		self.booms[i] = { anim = anim, flash = flash }
	end

	-- detriti delle esplosioni, riusati a giro
	self.detriti, self.detrito_i = {}, 0
	for i = 1, DETRITI do
		local n = box(0, 0, 1, 1, PIETRA)
		gui.set_enabled(n, false)
		self.detriti[i] = { node = n, x = 0, y = 0, vx = 0, vy = 0, a = 0, va = 0, t = DETRITO_VITA, col = vmath.vector4(PIETRA) }
	end

	local targhe = targa.nuove(TEAM_COLORS, TEAM_NAMES)
	for i = 1, game.MAX_PLAYERS do self.robots[i].targa = targhe[i] end
	self.arrow = box(0, 0, 4, 18, WHITE)
	self.cancel_label = label(0, 0, "ANNULLA", 0.7)
	gui.set_enabled(self.cancel_label, false)

	-- nel mondo, nell'ordine in cui si disegnano
	local mondo = {}
	for i = 1, game.MAX_PLAYERS do mondo[#mondo + 1] = self.robots[i].rig.root end
	for _, n in ipairs(self.dots) do mondo[#mondo + 1] = n end
	for _, n in ipairs(self.trail) do mondo[#mondo + 1] = n end
	mondo[#mondo + 1] = self.projectile
	for _, o in ipairs(self.orbs) do mondo[#mondo + 1] = o.root end
	mondo[#mondo + 1] = self.egg
	for _, n in ipairs(self.shard_nodes) do mondo[#mondo + 1] = n end
	for _, c in ipairs(self.crate_nodes) do mondo[#mondo + 1] = c.node end
	for _, n in ipairs(oggetti.nodi(self.oggetti)) do mondo[#mondo + 1] = n end
	mondo[#mondo + 1] = self.shock
	mondo[#mondo + 1] = self.tracer
	-- i detriti sotto l'esplosione: ne escono mentre si spegne
	for _, d in ipairs(self.detriti) do mondo[#mondo + 1] = d.node end
	for _, b in ipairs(self.booms) do
		mondo[#mondo + 1] = b.anim
		mondo[#mondo + 1] = b.flash
	end
	-- le targhe: prima tutte le barre, poi tutti i testi (due draw call in tutto)
	for i = 1, game.MAX_PLAYERS do mondo[#mondo + 1] = self.robots[i].targa.barre end
	for i = 1, game.MAX_PLAYERS do mondo[#mondo + 1] = self.robots[i].targa.testi end
	mondo[#mondo + 1] = self.arrow
	mondo[#mondo + 1] = self.cancel_label
	for _, n in ipairs(mondo) do gui.set_parent(n, self.mondo) end

	self.hud = label(W / 2, H - 28, "", 1)
	-- barra del tempo del turno (si accorcia verso il centro) e teletrasporti in mano accanto
	self.time_bar_bg = box(W / 2, TIME_BAR_Y, TIME_BAR_W + 4, TIME_BAR_H + 4, vmath.vector4(0.05, 0.05, 0.07, 0.6))
	self.time_bar = box(W / 2, TIME_BAR_Y, TIME_BAR_W, TIME_BAR_H, TIME_COLOR)
	self.tele_label = label(W / 2 + TIME_BAR_W / 2 + 110, TIME_BAR_Y + 2, "TELETRASPORTI 2", 0.9)
	gui.set_color(self.tele_label, vmath.vector4(1, 0.75, 0.35, 1))
	self.score_label = label(24, H - 28, "", 0.8)
	gui.set_pivot(self.score_label, gui.PIVOT_W)
	self.message = label(W / 2, H / 2 + 120, "", 1.6)
	self.tut_label = label(W / 2, H - 120, "", 0.8)
	gui.set_line_break(self.tut_label, true)
	gui.set_size(self.tut_label, vmath.vector3(900, 120, 0))

	-- zoom: vicino, medio, tutta la mappa (anche rotella e tasto Z)
	self.btn_zoom = box(ZOOM_BTN.x, ZOOM_BTN.y, 116, 44, vmath.vector4(0.05, 0.05, 0.07, 0.55))
	self.zoom_label = label(0, 0, camera.NOMI[self.cam.livello], 0.75)
	gui.set_parent(self.zoom_label, self.btn_zoom)

	-- levette del telefono
	self.move_pad = new_pad(MOVE_PAD, MOVE_IDLE)
	self.aim_pad = new_pad(AIM_PAD, AIM_IDLE)
	self.move_st, self.aim_st = levette.new(), levette.new()
	-- barra delle armi in basso al centro e, a parte, il teletrasporto
	self.bar = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_visible(self.bar, false)
	stretch(self.bar)
	self.slots = {}
	for i, w in ipairs(BAR_WEAPONS) do
		local n, bordo = ui.pannello(0, BAR_Y, SLOT, SLOT, self.bar)
		stretch(n)
		local icon -- gli oggetti hanno un'icona di forme (oggetti.icona), che resta accesa
		if WEAPON_ICON[w] then
			icon = gui.new_box_node(vmath.vector3(0, 2, 0), vmath.vector3(62, 62, 0))
			gui.set_texture(icon, "armi")
			gui.play_flipbook(icon, WEAPON_ICON[w])
			gui.set_parent(icon, n)
		else
			oggetti.icona(w, n)
		end
		local count = label(22, -26, "", 0.7)
		gui.set_parent(count, n)
		gui.set_enabled(n, false)
		self.slots[i] = { node = n, bordo = bordo, icon = icon, label = count, weapon = w, have = false, group = bar_group(w) }
		-- le secondarie lampeggiano nell'attesa del secondo attacco, se restano loro
		if game.SECONDARY[w] then
			local gl = glow(0, 0, SLOT * 1.6, SECOND_COLOR)
			gui.set_parent(gl, n)
			gui.set_enabled(gl, false)
			self.slots[i].glow = gl
		end
	end
	self.bar_groups, self.bar_group_x, self.bar_group_used = {}, {}, {}
	for i, gr in ipairs(BAR_GROUPS) do
		self.bar_groups[i] = label(0, 0, gr[1], 0.5)
		gui.set_color(self.bar_groups[i], gr[2])
		gui.set_parent(self.bar_groups[i], self.bar)
		gui.set_enabled(self.bar_groups[i], false)
	end
	-- teletrasporto: uno slot come quelli delle armi, col globo
	self.btn_tele, self.tele_bordo = ui.pannello(TELE_DESK.x, TELE_DESK.y, TELE_D, TELE_D)
	stretch(self.btn_tele)
	local orb_icon
	orb_icon, self.tele_light = colpo("globo", 3.6)
	gui.set_parent(orb_icon, self.btn_tele)
	self.tele_key = label(-26, -28, "T", 0.6)
	gui.set_parent(self.tele_key, self.btn_tele)
	self.pointers = {}
	set_touch_ui(self, touch_device())
	set_controls_visible(self, false)

	-- la home per ultima, così sta sopra la battaglia
	self.home = home.new(TEAM_COLORS[1])
	self.profilo = profilo.carica()
	self.scelta = scelta_armi.new(WEAPON_ICON, WEAPON_NAME, WEAPON_EFFECT)

	-- Nelle partite vere la mappa la sceglie il seed (sim/maps.lua). Negli scenari di
	-- prova è fissa, così le foto si ripetono: forgia, o [megablast] prova_mappa.
	self.mappa = SIMULA and config_string("megablast.prova_mappa", "forgia") or nil
	-- una mappa sullo sfondo del menu
	new_match(self, os.time(), self.mappa)
	self.g:pop_events()
	show_menu(self)
end

function final(self)
	disconnect(self)
end

function update(self, dt)
	if self.conn and ws.poll then ws.poll(self) end
	-- hit-stop: il mondo resta fermo, lo schermo trema lo stesso
	local dt_mondo = dt
	if self.fermo > 0 then
		self.fermo = self.fermo - dt
		dt_mondo = 0
	end
	self.sc_ox, self.sc_oy = camera.scossa(self.cam, dt)
	if self.mode == "local" then
		self.acc = math.min(self.acc + dt_mondo, 0.25)
		while self.acc >= game.DT and self.mode == "local" do
			local input = {
				left = move_left(self),
				right = move_right(self),
				-- con JUMP_REPEAT tenendo premuto si risalta appena si tocca terra
				jump = self.jump_pressed or (game.JUMP_REPEAT and jump_held(self)) or false,
				-- lasciando il salto mentre si sale il salto è corto
				hold = jump_held(self) or false,
				fire = self.fire,
			}
			self.jump_pressed = false
			self.fire = nil
			capture(self.pose_a, self.g)
			self.g:step(input)
			for _, e in ipairs(self.g:pop_events()) do
				handle_event(self, e)
				if self.tut then tutorial.evento(self.tut, self.g, e) end
			end
			self.acc = self.acc - game.DT
			capture(self.pose_b, self.g)
		end
		self.pose_t, self.pose_dt = self.acc, game.DT
		if self.tut then tutorial_update(self, dt) end
	elseif self.mode == "online" then
		self.pose_t = self.pose_t + dt_mondo
		-- mandiamo al server solo i cambiamenti, e solo quando tocca a noi
		if my_turn(self) and self.g.phase == "aim" then
			local l = move_left(self) or false
			local r = move_right(self) or false
			local j = jump_held(self) or false
			if l ~= self.sent.l or r ~= self.sent.r or j ~= self.sent.j then
				send(self, { t = "in", l = l, r = r, j = j })
				self.sent.l, self.sent.r, self.sent.j = l, r, j
			end
			-- salto ripetuto: uno per ogni volta che il robot torna a terra
			local grounded = current_robot(self).grounded
			if self.jump_pressed or (game.JUMP_REPEAT and jump_held(self) and grounded and not self.jump_sent) then
				send(self, { t = "jump" })
				self.jump_sent = true
			end
			if not grounded then self.jump_sent = false end
			if self.fire then
				send(self, { t = "fire", a = self.fire.angle, p = self.fire.power, w = self.fire.weapon })
			end
		else
			self.sent.l, self.sent.r, self.sent.j = false, false, false
		end
		self.jump_pressed = false
		self.fire = nil
	end

	-- mirando col mouse fermo la camera può muoversi (zoom): il punto dello
	-- schermo è lo stesso, quello del mondo no
	if self.pointers.mouse == "aim" and self.aim_sx then aim_from(self, self.aim_sx, self.aim_sy) end
	smooth_aim(self, dt)
	-- per sparare con la mira di un attimo prima che il pollice si stacchi
	if self.aim_pad.id then levette.registra(self.aim_st, self.clock, self.aim_angle, self.aim_power, self.aiming) end
	render(self, dt_mondo)
	muovi_detriti(self, dt_mondo)
	if self.mode == "menu" then home.update(self.home, dt) end
	if self.podio_t then
		self.podio_t = self.podio_t - dt
		if self.podio_t <= 0 then apri_podio(self) end
	end
	if self.schermata and self.schermata.mod.update then self.schermata.mod.update(self.schermata.obj, dt) end
	if self.mode == "scelta" then
		local players = scelta_armi.update(self.scelta, dt)
		if players then start_local_match(self, players) end
	end

	if SIMULA and self.g then
		-- sx, sy: il centro del robot sullo schermo (dove si appoggia il mouse per mirare)
		local rb = current_robot(self)
		local sx, sy = camera.allo_schermo(self.cam, rb.x, rb.y + game.ROBOT_H / 2)
		local line = string.format("SIMULA stato modo=%s turno=%d fase=%s x=%d y=%d sx=%d sy=%d zoom=%.2f",
			self.mode, self.g.current, self.g.phase, math.floor(rb.x), math.floor(rb.y),
			math.floor(sx + 0.5), math.floor(sy + 0.5), self.cam.s)
		if line ~= self.simula_line then
			print(line)
			self.simula_line = line
		end
	end
end

-- Si sceglie un'arma della barra; gli oggetti invece si usano subito
local function choose_slot(self, w)
	if game.TOOLS[w] and not game.THROWN[w] then
		if my_turn(self) and self.g:can_use(w) then self.fire = { angle = 0, power = 1, weapon = w } end
		return
	end
	self.weapon = w
	self.tele_armed = false
end

-- L'arma della barra sotto il dito, se c'è
local function picked_slot(self, x, y)
	for _, sl in ipairs(self.slots) do
		if sl.have and gui.pick_node(sl.node, x, y) then return sl.weapon end
	end
	return nil
end

-- passo: +1 più lontano, -1 più vicino, nil il prossimo livello (il pulsante gira)
local function change_zoom(self, passo)
	if passo then camera.cambia(self.cam, passo) else camera.prossimo(self.cam) end
	gui.set_text(self.zoom_label, camera.NOMI[self.cam.livello])
end

local function toggle_tele(self)
	-- il teletrasporto si attiva come un'arma, ma ha il suo pulsante
	self.tele_armed = not self.tele_armed and self.g:can_use("teleport")
end

-- Un dito (o il mouse) si appoggia in (x, y). id distingue le dita.
local function pointer_down(self, id, x, y)
	if self.mode == "ended" then
		if self.podio_t then apri_podio(self) else show_menu(self) end
		return
	elseif self.mode ~= "local" and self.mode ~= "online" then
		return
	end
	if gui.pick_node(self.btn_zoom, x, y) then
		change_zoom(self)
	elseif gui.pick_node(self.btn_tele, x, y) then
		toggle_tele(self)
	elseif picked_slot(self, x, y) then
		choose_slot(self, picked_slot(self, x, y))
	elseif self.touch_ui then
		if x < PAD_ZONE_X and y < PAD_ZONE_Y and not self.move_pad.id then
			self.pointers[id] = "move"
			pad_press(self.move_pad, id, x, y)
			move_pad_drag(self, x, y)
		elseif x > W - PAD_ZONE_X and y < PAD_ZONE_Y and not self.aim_pad.id and my_turn(self) then
			self.pointers[id] = "pad_aim"
			pad_press(self.aim_pad, id, x, y)
			aim_pad_drag(self, x, y)
		end
	elseif my_turn(self) then
		-- sul computer si mira dal robot col mouse
		self.pointers[id] = "aim"
		self.aiming = true
		aim_from(self, x, y, true)
	end
end

local function pointer_move(self, id, x, y)
	local m = self.pointers[id]
	if m == "move" then
		move_pad_drag(self, x, y)
	elseif m == "pad_aim" then
		aim_pad_drag(self, x, y)
	elseif m == "aim" then
		aim_from(self, x, y)
	end
end

local function pointer_up(self, id, x, y)
	local m = self.pointers[id]
	self.pointers[id] = nil
	if m == "move" then
		move_pad_release(self)
	elseif m == "pad_aim" then
		aim_pad_release(self)
	elseif m == "aim" then
		aim_from(self, x, y)
		-- rilasciare il dito sopra il robot annulla lo sparo
		if self.g:can_use(self.tele_armed and "teleport" or self.weapon) and self.aim_dist > CANCEL_R then
			self.fire = { angle = self.aim_angle, power = self.aim_power,
				weapon = self.tele_armed and "teleport" or self.weapon }
			self.tele_armed = false
		end
		self.aiming = false
	end
end

function on_input(self, action_id, action)
	if self.mode == "schermata" then
		local fine = self.schermata.mod.on_input(self.schermata.obj, action_id, action)
		if fine then show_menu(self) end
		return true
	end
	if self.mode == "menu" then
		local scelta = home.on_input(self.home, action_id, action)
		if scelta == "local" then
			start_local(self)
		elseif scelta == "online" then
			start_online(self)
		elseif scelta == "armeria" then
			apri_schermata(self, armeria, self.profilo)
		end
		return true
	elseif self.mode == "scelta" then
		scelta_armi.on_input(self.scelta, action_id, action)
		return true
	end
	-- un tasto spegne le levette (a meno che non le abbia chieste la configurazione)
	if action_id and action_id ~= ACTION_TOUCH and action_id ~= ACTION_MULTI and action.pressed
		and self.touch_ui and COMANDI == "" then
		set_touch_ui(self, false)
	end
	if action_id == ACTION_LEFT then
		self.keys.left = not action.released
	elseif action_id == ACTION_RIGHT then
		self.keys.right = not action.released
	elseif action_id == ACTION_JUMP then
		if action.pressed then self.jump_pressed = true end
		self.keys.jump = not action.released
	elseif action_id == ACTION_TELE then
		if action.pressed then toggle_tele(self) end
	elseif action_id == ACTION_ZOOM then
		if action.pressed then change_zoom(self) end
	elseif action_id == ACTION_ZOOM_IN or action_id == ACTION_ZOOM_OUT then
		if action.pressed then change_zoom(self, action_id == ACTION_ZOOM_OUT and 1 or -1) end
	elseif ACTION_WEAPON[action_id] then
		-- tasti 1-5: le armi della barra, in ordine
		if action.pressed then
			local n = 0
			for _, sl in ipairs(self.slots) do
				if sl.have then
					n = n + 1
					if n == ACTION_WEAPON[action_id] then choose_slot(self, sl.weapon) end
				end
			end
		end
	elseif action_id == ACTION_MULTI then
		-- dita vere: da qui in poi il tocco del "mouse" (il primo dito) si ignora
		if not self.multitouch then
			self.multitouch = true
			if self.pointers.mouse then pointer_up(self, "mouse", action.x, action.y) end
			if COMANDI ~= "computer" then set_touch_ui(self, true) end
		end
		for _, t in ipairs(action.touch) do
			if t.pressed then
				pointer_down(self, t.id, t.x, t.y)
			elseif t.released then
				pointer_up(self, t.id, t.x, t.y)
			else
				pointer_move(self, t.id, t.x, t.y)
			end
		end
	elseif action_id == ACTION_TOUCH then
		if self.multitouch then return true end
		if action.pressed then
			pointer_down(self, "mouse", action.x, action.y)
		elseif action.released then
			pointer_up(self, "mouse", action.x, action.y)
		else
			pointer_move(self, "mouse", action.x, action.y)
		end
	elseif action_id == ACTION_CANCEL then
		-- tasto destro mentre si mira col sinistro: il colpo è annullato, e lasciando
		-- il sinistro non parte niente (si può cambiare arma e mirare di nuovo)
		if action.pressed and self.pointers.mouse == "aim" then
			self.pointers.mouse = "cancelled"
			self.aiming = false
		end
	elseif action_id == nil and self.pointers.mouse then
		-- movimento del mouse senza cambio di stato
		pointer_move(self, "mouse", action.x, action.y)
	end
	return true
end
