	TOUCH = hash("touch"), LEFT = hash("left"), RIGHT = hash("right"), JUMP = hash("jump"),
	CANCEL = hash("cancel"), MULTI = hash("multitouch"), TELE = hash("teleport"), ZOOM = hash("zoom"),
	ZOOM_IN = hash("zoom_avanti"), ZOOM_OUT = hash("zoom_indietro"), MENU = hash("menu_partita"),
	-- tasti 1-9: le armi della barra
	WEAPON = {},
}
for i = 1, 9 do ACTION.WEAPON[hash("arma" .. i)] = i end

