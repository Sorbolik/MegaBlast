-- Client di MegaBlast: menu, partita locale (hot-seat) e partita online.
-- Tutta la grafica è creata da codice con nodi GUI, senza asset esterni.
-- La logica di gioco sta in sim/ (Lua puro). In locale la facciamo girare qui,
-- online la fa girare il server e noi disegniamo lo stato che ci manda.

local game = require "sim.game"
local maps = require "sim.maps"

local W, H, CELL = game.WORLD_W, game.WORLD_H, game.CELL
local TW, TH = W / CELL, H / CELL

-- Se il terreno appare capovolto, metti questo valore a true.
local FLIP_TEXTURE = true

local DEFAULT_SERVER = "ws://127.0.0.1:8080/ws"

local ACTION_TOUCH = hash("touch")
local ACTION_LEFT = hash("left")
local ACTION_RIGHT = hash("right")
local ACTION_JUMP = hash("jump")

local NAMES = { "Rosso", "Blu" }
local PLAYER_COLORS = { vmath.vector4(0.92, 0.26, 0.22, 1), vmath.vector4(0.22, 0.48, 0.96, 1) }
local SKY = vmath.vector4(0.56, 0.78, 0.95, 1)
local WHITE = vmath.vector4(1, 1, 1, 1)
local DARK = vmath.vector4(0.12, 0.12, 0.14, 1)
local BUTTON = vmath.vector4(1, 1, 1, 0.25)
local MENU_BUTTON = vmath.vector4(0.12, 0.12, 0.14, 0.75)
local BUTTON_ON = vmath.vector4(0.62, 0.36, 0.95, 0.75)
local ORB = vmath.vector4(0.62, 0.36, 0.95, 1)
local BLADE = vmath.vector4(1, 0.85, 0.45, 1)

-- Nomi delle armi sul pulsante (provvisorio, finché non c'è la barra delle armi)
local WEAPON_LABEL = { missile = "MISSILE", sword = "SPADA" }

-- Colori del terreno, già pronti come byte RGBA
local EMPTY = string.char(0, 0, 0, 0)
local GRASS = string.char(98, 172, 62, 255)
local DIRT = {
	string.char(122, 86, 54, 255), string.char(112, 78, 48, 255),
	string.char(130, 92, 60, 255), string.char(106, 74, 46, 255),
}
-- Acciaio (tubi indistruttibili): grigio a strisce
local STEEL = { string.char(150, 156, 166, 255), string.char(118, 124, 134, 255) }
local STEEL_EDGE = string.char(70, 74, 82, 255)

local AIM_DOTS = 12
local AIM_RANGE = 220 -- distanza del dito che corrisponde alla potenza massima

local function stretch(node)
	gui.set_adjust_mode(node, gui.ADJUST_STRETCH)
	return node
end

local function box(x, y, w, h, color)
	local n = stretch(gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0)))
	gui.set_color(n, color)
	return n
end

local function circle(x, y, d, color)
	local n = stretch(gui.new_pie_node(vmath.vector3(x, y, 0), vmath.vector3(d, d, 0)))
	gui.set_color(n, color)
	return n
end

local function label(x, y, text, scale)
	local n = stretch(gui.new_text_node(vmath.vector3(x, y, 0), text))
	gui.set_font(n, "default")
	gui.set_color(n, WHITE)
	gui.set_outline(n, DARK)
	local s = scale or 1
	gui.set_scale(n, vmath.vector3(s, s, 1))
	return n
end

local function server_url()
	if sys.get_config_string then
		return sys.get_config_string("megablast.server_url", DEFAULT_SERVER)
	end
	return sys.get_config("megablast.server_url", DEFAULT_SERVER)
end

-- Terreno -----------------------------------------------------------------------

-- Il terreno è diviso in riquadri, ognuno con la sua piccola texture: dopo
-- un'esplosione ricalcoliamo solo le celle del cratere e rimandiamo alla GPU
-- solo i riquadri toccati (pochi KB invece di quasi 1 MB).
local TILE_W, TILE_H = 80, 60
local TILES_X, TILES_Y = TW / TILE_W, TH / TILE_H

-- Colore della cella (cx, cy), già pronto come byte RGBA
local function cell_color(data, cx, cy)
	local i = cy * TW + cx + 1
	local v = data[i]
	if v == 0 then return EMPTY end
	local up = cy + 1 < TH and data[i + TW] or 0
	if v == 2 then
		local down = cy > 0 and data[i - TW] or 0
		if up ~= 2 or down ~= 2 then return STEEL_EDGE end
		return STEEL[math.floor((cx + cy) / 3) % 2 + 1]
	end
	local up2 = cy + 2 < TH and data[i + 2 * TW] or 0
	if up == 0 or up2 == 0 then return GRASS end
	return DIRT[(cx * 7 + cy * 13 + math.floor(cx / 5) * 3) % 4 + 1]
end

-- Posizione della cella dentro i pixel del suo riquadro
local function pixel_index(cx, cy)
	local lx, ly = cx % TILE_W, cy % TILE_H
	if FLIP_TEXTURE then ly = TILE_H - 1 - ly end
	return ly * TILE_W + lx + 1
end

local function upload_tile(self, tile)
	-- un riquadro tutto cielo non si disegna: meno lavoro per la GPU
	local empty = true
	for _, c in ipairs(tile.px) do
		if c ~= EMPTY then empty = false; break end
	end
	gui.set_enabled(tile.node, not empty)
	if empty and tile.created then return end
	local data = table.concat(tile.px)
	if tile.created then
		gui.set_texture_data(tile.id, TILE_W, TILE_H, "rgba", data)
	else
		assert(gui.new_texture(tile.id, TILE_W, TILE_H, "rgba", data, false))
		gui.set_texture(tile.node, tile.id)
		tile.created = true
	end
end

local function draw_terrain(self)
	local data = self.g.terrain.data
	for _, tile in ipairs(self.tiles) do
		local px = tile.px
		for cy = tile.ty * TILE_H, tile.ty * TILE_H + TILE_H - 1 do
			for cx = tile.tx * TILE_W, tile.tx * TILE_W + TILE_W - 1 do
				px[pixel_index(cx, cy)] = cell_color(data, cx, cy)
			end
		end
		upload_tile(self, tile)
	end
end

-- Ridisegna le celle nel rettangolo dato (coordinate di cella) e carica i riquadri toccati
local function redraw_cells(self, cx0, cy0, cx1, cy1)
	cx0, cy0 = math.max(0, cx0), math.max(0, cy0)
	cx1, cy1 = math.min(TW - 1, cx1), math.min(TH - 1, cy1)
	local data = self.g.terrain.data
	for cy = cy0, cy1 do
		local row = math.floor(cy / TILE_H) * TILES_X
		for cx = cx0, cx1 do
			self.tiles[row + math.floor(cx / TILE_W) + 1].px[pixel_index(cx, cy)] = cell_color(data, cx, cy)
		end
	end
	for ty = math.floor(cy0 / TILE_H), math.floor(cy1 / TILE_H) do
		for tx = math.floor(cx0 / TILE_W), math.floor(cx1 / TILE_W) do
			upload_tile(self, self.tiles[ty * TILES_X + tx + 1])
		end
	end
end

-- Messaggi e menu -------------------------------------------------------------

local function show_message(self, text, keep)
	gui.set_text(self.message, text)
	gui.cancel_animations(self.message, "color.w")
	gui.set_color(self.message, WHITE)
	if not keep then
		gui.animate(self.message, "color.w", 0, gui.EASING_INCUBIC, 0.6, 1.2)
	end
end

local function set_controls_visible(self, visible)
	gui.set_enabled(self.btn_left, visible)
	gui.set_enabled(self.btn_right, visible)
	gui.set_enabled(self.btn_jump, visible)
	gui.set_enabled(self.btn_weapon, visible)
	gui.set_enabled(self.btn_tele, visible)
	gui.set_enabled(self.hud, visible)
end

local function disconnect(self)
	if self.conn then
		websocket.disconnect(self.conn)
		self.conn = nil
	end
end

local function show_menu(self)
	disconnect(self)
	self.mode = "menu"
	gui.set_enabled(self.menu, true)
	set_controls_visible(self, false)
	show_message(self, "", true)
end

-- Fluidità -------------------------------------------------------------------
-- La simulazione avanza a passi fissi (60 al secondo in locale, uno stato ogni
-- SNAPSHOT_TICKS online), mentre lo schermo può andare a 60, 90 o 120 Hz.
-- Disegniamo sempre una posizione interpolata tra la posa precedente (a) e
-- l'ultima (b), così il movimento non scatta.

-- Le pose sono tabelle riusate: niente allocazioni a ogni frame, quindi
-- niente pause del garbage collector.
local function new_pose()
	return { r = { { x = 0, y = 0 }, { x = 0, y = 0 } }, p = { x = 0, y = 0 }, has_p = false,
		o = { x = 0, y = 0 }, has_o = false }
end

local function capture(pose, g)
	for i, rb in ipairs(g.robots) do
		local r = pose.r[i]
		r.x, r.y, r.g = rb.x, rb.y, rb.grounded
	end
	pose.has_p = g.projectile ~= nil
	if pose.has_p then pose.p.x, pose.p.y = g.projectile.x, g.projectile.y end
	pose.has_o = g.orb ~= nil
	if pose.has_o then pose.o.x, pose.o.y = g.orb.x, g.orb.y end
end

local function pose_k(self)
	return math.max(0, math.min(1, self.pose_t / self.pose_dt))
end

-- Porta la posa a verso b della frazione k (a diventa ciò che è sullo schermo)
local function advance_pose(a, b, k)
	for i, rb in ipairs(b.r) do
		local ra = a.r[i]
		ra.x, ra.y, ra.g = ra.x + (rb.x - ra.x) * k, ra.y + (rb.y - ra.y) * k, rb.g
	end
	if b.has_p then
		if not a.has_p then a.p.x, a.p.y = b.p.x, b.p.y end
		a.p.x, a.p.y = a.p.x + (b.p.x - a.p.x) * k, a.p.y + (b.p.y - a.p.y) * k
	end
	a.has_p = b.has_p
	if b.has_o then
		if not a.has_o then a.o.x, a.o.y = b.o.x, b.o.y end
		a.o.x, a.o.y = a.o.x + (b.o.x - a.o.x) * k, a.o.y + (b.o.y - a.o.y) * k
	end
	a.has_o = b.has_o
end

-- Dopo un teletrasporto il robot non deve scivolare dal vecchio punto al nuovo
local function snap_robot(self, i)
	local ra, rb = self.pose_a.r[i], self.pose_b.r[i]
	local rg = self.g.robots[i]
	ra.x, ra.y = rg.x, rg.y
	rb.x, rb.y = rg.x, rg.y
	self.view[i].x, self.view[i].y = rg.x, rg.y
end

local function reset_pose(self)
	self.pose_a = self.pose_a or new_pose()
	self.pose_b = self.pose_b or new_pose()
	capture(self.pose_a, self.g)
	capture(self.pose_b, self.g)
	self.pose_t = 0
end

-- Partita -----------------------------------------------------------------------

local function new_match(self, seed, map)
	self.g = game.new(seed, map)
	-- se sullo schermo c'è già questa mappa intatta (es. quella del menu) non la ridisegnamo
	local key = self.g.map .. (maps.get(self.g.map).seeded and seed or "")
	if key ~= self.drawn_map then
		draw_terrain(self)
		self.drawn_map = key
	end
	self.view = {}
	for i, rb in ipairs(self.g.robots) do
		gui.set_enabled(self.robots[i].body, true)
		self.view[i] = { x = rb.x, y = rb.y }
	end
	self.pose_dt = game.DT
	reset_pose(self)
	self.aiming = false
	self.weapon = "missile"
	self.tele_armed = false
	self.snap = {}
	self.acc = 0
	self.sent = {}
end

local function explosion_flash(x, y, r)
	local n = circle(x, y, r * 2, vmath.vector4(1, 0.7, 0.2, 0.9))
	gui.animate(n, "color.w", 0, gui.EASING_OUTQUAD, 0.35, 0, function() gui.delete_node(n) end)
	gui.animate(n, "scale", vmath.vector3(1.3, 1.3, 1), gui.EASING_OUTQUAD, 0.35)
end

local function my_turn(self)
	return self.mode == "local" or (self.mode == "online" and self.g.current == self.me)
end

local function handle_event(self, e)
	if e.type == "explosion" then
		local row_min, row_max = e.row_min, e.row_max
		if self.mode == "online" then
			-- online il terreno lo scaviamo noi, nello stesso punto del server
			row_min, row_max = self.g.terrain:carve(e.x, e.y, e.r)
		end
		-- l'erba dipende dalle 2 celle sopra e l'acciaio da quelle vicine,
		-- quindi ridisegniamo un margine di 2 celle attorno al cratere
		self.drawn_map = nil
		redraw_cells(self, math.floor((e.x - e.r) / CELL) - 2, row_min - 2,
			math.floor((e.x + e.r) / CELL) + 2, row_max + 2)
		explosion_flash(e.x, e.y, e.r)
	elseif e.type == "teleport" then
		if self.mode == "online" then
			-- lo stato col robot nella nuova posizione arriva subito dopo l'evento
			self.snap[e.robot] = true
		else
			snap_robot(self, e.robot)
		end
	elseif e.type == "turn" then
		self.tele_armed = false
		if self.mode == "online" then
			show_message(self, e.robot == self.me and "Tocca a te!" or "Turno dell'avversario")
		else
			show_message(self, "Turno di " .. NAMES[e.robot])
		end
	elseif e.type == "death" then
		gui.set_enabled(self.robots[e.robot].body, false)
	elseif e.type == "over" then
		local text
		if self.mode == "online" then
			text = e.winner == self.me and "Hai vinto!" or (e.winner and "Hai perso!" or "Pareggio!")
		else
			text = e.winner and ("Vince " .. NAMES[e.winner] .. "!") or "Pareggio!"
		end
		show_message(self, text .. "\nTocca per tornare al menu", true)
		self.mode = "ended"
	end
end

-- Online ------------------------------------------------------------------------

local function send(self, msg)
	if self.conn then
		websocket.send(self.conn, json.encode(msg), { type = websocket.DATA_TYPE_TEXT })
	end
end

local function apply_state(self, s)
	local g = self.g
	g.phase, g.current, g.timer, g.retreat = s.phase, s.cur, s.timer, s.retreat or 0
	for i, r in ipairs(s.r) do
		local rb = g.robots[i]
		rb.x, rb.y, rb.hp, rb.facing, rb.dead, rb.grounded = r.x, r.y, r.hp, r.f, r.d, r.g
		rb.swing = (r.s or 0) > 0 and r.s or nil
	end
	g.projectile = s.p and { x = s.p.x, y = s.p.y } or nil
	g.orb = s.o and { x = s.o.x, y = s.o.y } or nil
	g.orb_used = s.ou
	-- si riparte da dove siamo sullo schermo verso il nuovo stato
	advance_pose(self.pose_a, self.pose_b, pose_k(self))
	capture(self.pose_b, g)
	for i in pairs(self.snap) do
		snap_robot(self, i)
		self.snap[i] = nil
	end
	self.pose_t = 0
	self.pose_dt = game.SNAPSHOT_TICKS * game.DT
end

local function on_server_message(self, m)
	if m.t == "wait" then
		show_message(self, "In attesa di un avversario...", true)
	elseif m.t == "start" then
		new_match(self, m.seed, m.map)
		self.g:pop_events()
		self.me = m.you
		self.mode = "online"
		set_controls_visible(self, true)
		show_message(self, "Sei " .. NAMES[m.you])
	elseif m.t == "state" and self.g then
		apply_state(self, m)
	elseif m.t == "ev" then
		handle_event(self, m)
	elseif m.t == "left" then
		self.mode = "ended"
		show_message(self, "L'avversario è uscito\nTocca per tornare al menu", true)
	elseif m.t == "error" then
		self.mode = "ended"
		show_message(self, "Errore del server\nTocca per tornare al menu", true)
	end
end

local function on_socket(self, conn, data)
	if data.event == websocket.EVENT_CONNECTED then
		show_message(self, "Connesso, in attesa...", true)
	elseif data.event == websocket.EVENT_MESSAGE then
		local ok, m = pcall(json.decode, data.message)
		if ok and m then on_server_message(self, m) end
	elseif data.event == websocket.EVENT_DISCONNECTED or data.event == websocket.EVENT_ERROR then
		self.conn = nil
		if self.mode ~= "menu" and self.mode ~= "ended" then
			self.mode = "ended"
			show_message(self, "Connessione persa\nTocca per tornare al menu", true)
		end
	end
end

local function start_online(self)
	gui.set_enabled(self.menu, false)
	if not websocket then
		-- l'estensione si scarica con Project -> Fetch Libraries
		self.mode = "ended"
		show_message(self, "Manca l'estensione WebSocket\nIn Defold: Project > Fetch Libraries\nTocca per tornare al menu", true)
		return
	end
	self.mode = "connecting"
	show_message(self, "Connessione a\n" .. server_url(), true)
	self.conn = websocket.connect(server_url(), { timeout = 5000 }, on_socket)
end

local function start_local(self)
	gui.set_enabled(self.menu, false)
	new_match(self, os.time())
	self.mode = "local"
	set_controls_visible(self, true)
end

-- Rendering -------------------------------------------------------------------

local function current_robot(self)
	return self.g.robots[self.g.current]
end

local function aim_from(self, x, y)
	local rb = current_robot(self)
	local dx, dy = x - rb.x, y - (rb.y + game.ROBOT_H / 2)
	self.aim_angle = math.atan2(dy, dx)
	self.aim_dist = math.sqrt(dx * dx + dy * dy)
	self.aim_power = math.max(0.1, math.min(1, self.aim_dist / AIM_RANGE))
end

-- Un solo vettore riusato per tutte le posizioni del frame
local POS = vmath.vector3(0, 0, 0)
local function set_pos(node, x, y)
	POS.x, POS.y = x, y
	gui.set_position(node, POS)
end

local BLADE_ROT = vmath.vector3(0, 0, 0)

local function set_hud(self, text)
	if self.hud_text ~= text then
		gui.set_text(self.hud, text)
		self.hud_text = text
	end
end

local function render(self, dt)
	local g = self.g
	local k, pa, pb = pose_k(self), self.pose_a, self.pose_b
	for i, rb in ipairs(g.robots) do
		local v, r, ra, rb2 = self.view[i], self.robots[i], pa.r[i], pb.r[i]
		v.x = ra.x + (rb2.x - ra.x) * k
		-- a terra il robot sale e scende i gradini del terreno a scatti di 2 pixel:
		-- li ammorbidiamo solo nel disegno, la posizione vera non cambia
		local ty = ra.y + (rb2.y - ra.y) * k
		local dy = ty - v.y
		if rb2.g and math.abs(dy) <= game.MAX_CLIMB + 2 then
			v.y = v.y + dy * math.min(1, dt * 25)
		else
			v.y = ty
		end
		set_pos(r.body, v.x, v.y + game.ROBOT_H / 2)
		set_pos(r.eye, rb.facing * 3, 3)
		-- Lama di Nucleo: ruota attorno alla spalla durante il fendente
		gui.set_enabled(r.blade, rb.swing ~= nil)
		if rb.swing then
			-- il tick del fendente è quello della posa b: lo disegniamo tra a e b
			local span = self.mode == "online" and game.SNAPSHOT_TICKS or 1
			local t = math.max(0, rb.swing - span + k * span)
			local a = game.sword_angle(t)
			if rb.facing < 0 then a = math.pi - a end
			BLADE_ROT.z = math.deg(a)
			gui.set_rotation(r.blade, BLADE_ROT)
			set_pos(r.blade, 0, game.SWORD_PIVOT_Y - game.ROBOT_H / 2)
		end
		local hp = math.max(0, rb.hp)
		if v.hp ~= hp then
			gui.set_text(r.hp, tostring(hp))
			v.hp = hp
		end
	end

	gui.set_enabled(self.projectile, pb.has_p)
	if pb.has_p then
		local p0 = pa.has_p and pa.p or pb.p
		set_pos(self.projectile, p0.x + (pb.p.x - p0.x) * k, p0.y + (pb.p.y - p0.y) * k)
	end

	gui.set_enabled(self.orb, pb.has_o)
	if pb.has_o then
		local o0 = pa.has_o and pa.o or pb.o
		set_pos(self.orb, o0.x + (pb.o.x - o0.x) * k, o0.y + (pb.o.y - o0.y) * k)
	end

	-- pulsanti: arma scelta e teletrasporto (uno per turno)
	local tele_ok = g.phase == "aim" and not g.orb_used and my_turn(self)
	if self.tele_armed and not tele_ok then self.tele_armed = false end
	if self.shown_weapon ~= self.weapon then
		gui.set_text(self.weapon_label, WEAPON_LABEL[self.weapon])
		self.shown_weapon = self.weapon
	end
	gui.set_color(self.btn_tele, self.tele_armed and BUTTON_ON or (tele_ok and BUTTON or MENU_BUTTON))

	local aim_weapon = self.tele_armed and "teleport" or self.weapon
	local show_aim = self.aiming and g.phase == "aim" and my_turn(self) and aim_weapon ~= "sword"
	if show_aim then
		local pts = g:preview(self.aim_angle, self.aim_power, AIM_DOTS, 4, self.preview_pts)
		for i, n in ipairs(self.dots) do
			gui.set_enabled(n, true)
			set_pos(n, pts[i].x, pts[i].y)
		end
	else
		for _, n in ipairs(self.dots) do gui.set_enabled(n, false) end
	end

	local secs = math.max(0, math.ceil(g.timer / 60))
	local who = NAMES[g.current]
	if self.mode == "online" then who = g.current == self.me and "Tu" or "Avversario" end
	if g.phase == "aim" then
		set_hud(self, string.format("%s   %ds", who, secs))
	elseif g.retreat > 0 then
		set_hud(self, string.format("%s   riparati! %ds", who, math.ceil(g.retreat / 60)))
	elseif g.phase ~= "over" then
		set_hud(self, who)
	end

	-- freccia sopra il robot di turno
	local cur = current_robot(self)
	local v = self.view[g.current]
	gui.set_enabled(self.arrow, g.phase == "aim" and not cur.dead and (self.mode == "local" or self.mode == "online"))
	set_pos(self.arrow, v.x, v.y + game.ROBOT_H + 34)
	gui.set_color(self.arrow, PLAYER_COLORS[g.current])
end

-- Ciclo di vita -------------------------------------------------------------

function init(self)
	msg.post(".", "acquire_input_focus")
	self.keys = {}
	self.preview_pts = {}

	box(W / 2, H / 2, W, H, SKY)
	self.tiles = {}
	for ty = 0, TILES_Y - 1 do
		for tx = 0, TILES_X - 1 do
			local w, h = TILE_W * CELL, TILE_H * CELL
			self.tiles[#self.tiles + 1] = {
				tx = tx, ty = ty, px = {}, id = "terrain" .. tx .. "_" .. ty,
				node = box(tx * w + w / 2, ty * h + h / 2, w, h, WHITE),
			}
		end
	end

	self.robots = {}
	for i = 1, 2 do
		local body = box(0, 0, game.ROBOT_HALF_W * 2, game.ROBOT_H, PLAYER_COLORS[i])
		local eye = box(3, 3, 4, 4, WHITE)
		gui.set_parent(eye, body)
		local hp = label(0, 20, "100", 0.7)
		gui.set_parent(hp, body)
		local blade = box(0, 0, game.SWORD_REACH, 3, BLADE)
		gui.set_pivot(blade, gui.PIVOT_W)
		gui.set_parent(blade, body)
		gui.set_enabled(blade, false)
		self.robots[i] = { body = body, eye = eye, hp = hp, blade = blade }
	end

	self.projectile = circle(0, 0, 6, DARK)
	self.orb = circle(0, 0, 9, ORB)
	self.dots = {}
	for i = 1, AIM_DOTS do
		self.dots[i] = circle(0, 0, 5, vmath.vector4(1, 1, 1, 1 - i / (AIM_DOTS + 4)))
	end
	self.arrow = box(0, 0, 4, 18, WHITE)

	self.hud = label(W / 2, H - 28, "", 1)
	self.message = label(W / 2, H / 2 + 120, "", 1.6)

	self.btn_left = box(80, 80, 110, 110, BUTTON)
	gui.set_parent(label(0, 0, "<", 2), self.btn_left)
	self.btn_right = box(210, 80, 110, 110, BUTTON)
	gui.set_parent(label(0, 0, ">", 2), self.btn_right)
	self.btn_jump = box(W - 90, 80, 130, 110, BUTTON)
	gui.set_parent(label(0, 0, "SALTA", 1), self.btn_jump)
	-- arma (provvisorio: missile o spada) e, a parte, il teletrasporto
	self.btn_weapon = box(W - 90, 210, 130, 90, BUTTON)
	self.weapon_label = label(0, 0, "MISSILE", 0.8)
	gui.set_parent(self.weapon_label, self.btn_weapon)
	self.btn_tele = box(W - 240, 80, 130, 110, BUTTON)
	gui.set_parent(label(0, 0, "TELE", 1), self.btn_tele)

	self.menu = box(W / 2, H / 2, W, H, vmath.vector4(0, 0, 0, 0))
	gui.set_parent(label(0, 170, "MEGABLAST", 3), self.menu)
	self.btn_local = box(0, 30, 360, 90, MENU_BUTTON)
	gui.set_parent(self.btn_local, self.menu)
	gui.set_parent(label(0, 0, "STESSO TELEFONO", 1.2), self.btn_local)
	self.btn_online = box(0, -90, 360, 90, MENU_BUTTON)
	gui.set_parent(self.btn_online, self.menu)
	gui.set_parent(label(0, 0, "ONLINE", 1.2), self.btn_online)

	-- una mappa sullo sfondo del menu
	new_match(self, os.time())
	self.g:pop_events()
	show_menu(self)
end

function final(self)
	disconnect(self)
end

function update(self, dt)
	if self.mode == "local" then
		self.acc = math.min(self.acc + dt, 0.25)
		while self.acc >= game.DT and self.mode == "local" do
			local input = {
				left = self.keys.left or self.touch_mode == "left",
				right = self.keys.right or self.touch_mode == "right",
				jump = self.jump_pressed,
				fire = self.fire,
			}
			self.jump_pressed = false
			self.fire = nil
			capture(self.pose_a, self.g)
			self.g:step(input)
			for _, e in ipairs(self.g:pop_events()) do handle_event(self, e) end
			self.acc = self.acc - game.DT
			capture(self.pose_b, self.g)
		end
		self.pose_t, self.pose_dt = self.acc, game.DT
	elseif self.mode == "online" then
		self.pose_t = self.pose_t + dt
		-- mandiamo al server solo i cambiamenti, e solo quando tocca a noi
		if my_turn(self) and (self.g.phase == "aim" or self.g.retreat > 0) then
			local l = self.keys.left or self.touch_mode == "left" or false
			local r = self.keys.right or self.touch_mode == "right" or false
			if l ~= self.sent.l or r ~= self.sent.r then
				send(self, { t = "in", l = l, r = r })
				self.sent.l, self.sent.r = l, r
			end
			if self.jump_pressed then send(self, { t = "jump" }) end
			if self.fire then
				send(self, { t = "fire", a = self.fire.angle, p = self.fire.power, w = self.fire.weapon })
			end
		else
			self.sent.l, self.sent.r = false, false
		end
		self.jump_pressed = false
		self.fire = nil
	end

	render(self, dt)
end

function on_input(self, action_id, action)
	if action_id == ACTION_LEFT then
		self.keys.left = not action.released
	elseif action_id == ACTION_RIGHT then
		self.keys.right = not action.released
	elseif action_id == ACTION_JUMP then
		if action.pressed then self.jump_pressed = true end
	elseif action_id == ACTION_TOUCH then
		if action.pressed then
			if self.mode == "menu" then
				if gui.pick_node(self.btn_local, action.x, action.y) then
					start_local(self)
				elseif gui.pick_node(self.btn_online, action.x, action.y) then
					start_online(self)
				end
				return true
			elseif self.mode == "ended" then
				show_menu(self)
				return true
			elseif self.mode ~= "local" and self.mode ~= "online" then
				return true
			end
			if gui.pick_node(self.btn_left, action.x, action.y) then
				self.touch_mode = "left"
			elseif gui.pick_node(self.btn_right, action.x, action.y) then
				self.touch_mode = "right"
			elseif gui.pick_node(self.btn_jump, action.x, action.y) then
				self.touch_mode = "jump"
				self.jump_pressed = true
			elseif gui.pick_node(self.btn_weapon, action.x, action.y) then
				self.weapon = self.weapon == "missile" and "sword" or "missile"
				self.tele_armed = false
			elseif gui.pick_node(self.btn_tele, action.x, action.y) then
				-- il teletrasporto si attiva come un'arma, ma ha il suo pulsante
				self.tele_armed = not self.tele_armed and self.g.phase == "aim" and not self.g.orb_used
			elseif my_turn(self) then
				self.touch_mode = "aim"
				self.aiming = true
			end
		end
		if self.touch_mode == "aim" then aim_from(self, action.x, action.y) end
		if action.released then
			-- rilasciare il dito sopra il robot annulla lo sparo
			if self.touch_mode == "aim" and self.g.phase == "aim" and self.aim_dist > 24 then
				self.fire = { angle = self.aim_angle, power = self.aim_power,
					weapon = self.tele_armed and "teleport" or self.weapon }
				self.tele_armed = false
			end
			self.touch_mode = nil
			self.aiming = false
		end
	elseif action_id == nil and self.touch_mode == "aim" then
		-- movimento del mouse o del dito senza cambio di stato
		aim_from(self, action.x, action.y)
	end
	return true
end
