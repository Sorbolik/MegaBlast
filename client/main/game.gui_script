local CANCEL_R = 28

local function fit(node)
	gui.set_adjust_mode(node, gui.ADJUST_FIT)
	return node
end

local function box(x, y, w, h, color)
	local n = fit(gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0)))
	gui.set_color(n, color)
	return n
end

-- alone bianco in additivo (fx/bagliore.png), tinto con color
local function glow(x, y, d, color)
	local n = fit(gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(d, d, 0)))
	gui.set_texture(n, "battaglia")
	gui.play_flipbook(n, "bagliore")
	gui.set_blend_mode(n, gui.BLEND_ADD)
	gui.set_color(n, color)
	return n
end

-- scritte dell'HUD col font dell'interfaccia: scala 1 = circa 16 px
local FONT_K = 0.4
-- Un colpo in volo (o il globo del pulsante) dall'atlante delle armi, grande sc
-- volte le sue misure del mondo (battaglia/armi.lua): l'immagine e sopra le
-- parti col colore di chi spara. Restituisce il nodo e le parti da tingere.
local function colpo(nome, sc)
	local a = require("battaglia.armi").colpi[nome]
	local img = fit(gui.new_box_node(vmath.vector3(a.x * sc, a.y * sc, 0), vmath.vector3(a.w * sc, a.h * sc, 0)))
	gui.set_texture(img, "armi")
	gui.play_flipbook(img, a.img)
	local tinta = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(a.w * sc, a.h * sc, 0))
	gui.set_texture(tinta, "armi")
	gui.play_flipbook(tinta, a.tinta)
	gui.set_parent(tinta, img)
	return img, tinta
end

local function label(x, y, text, scale)
	return fit(ui.testo(text, x, y, (scale or 1) * FONT_K * 2))
end

-- Simulazione (strumenti/simula): con megablast.simula = 1 il gioco scrive nel
-- log gli eventi e dove sta il robot di turno, così uno script può guidarlo.
local function config_int(key, default)
	if sys.get_config_int then return sys.get_config_int(key, default) end
	return tonumber(sys.get_config(key, tostring(default))) or default
end
local SIMULA = config_int("megablast.simula", 0) == 1
-- nel simulatore (build senza estensione) l'online passa da LuaSocket
if not ws and SIMULA then ws = require "main.ws_socket" end

-- Profilo di fisica (sim/game.lua): "blastron" se non si dice niente.
-- Con [megablast] fisica = megablast si torna ai valori di prima, ma solo in
-- locale: online decide il server.
local function config_string(key, default)
	if sys.get_config_string then return sys.get_config_string(key, default) end
	return sys.get_config(key, default)
end
local FISICA = config_string("megablast.fisica", "")
if FISICA ~= "" then game.use_physics(FISICA) end

