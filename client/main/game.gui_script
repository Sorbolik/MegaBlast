-- Client di MegaBlast: menu, partita locale (hot-seat) e partita online.
-- La mappa è una mesh con lo shader del terreno (battaglia/terreno.*), tutto il
-- resto (robot, missile, esplosioni, comandi) sono nodi GUI creati da codice.
-- La logica di gioco sta in sim/ (Lua puro). In locale la facciamo girare qui,
-- online la fa girare il server e noi disegniamo lo stato che ci manda.

local game = require "sim.game"
local ui = require "ui.ui"
local gconfig = require "sim.config"
local maps = require "sim.maps"
local scoria = require "battaglia.scoria"
local targa = require "battaglia.targa"
local battute = require "battaglia.battute"
local home = require "menu.home"
local profilo = require "menu.profilo"
local assetto = require "sim.assetto"
local riconoscimenti = require "sim.riconoscimenti"
local draft = require "sim.draft"
local bot = require "sim.bot"
local replay = require "sim.replay"
-- le schermate fuori dalla battaglia, in una tabella sola: il gui_script è
-- vicino al limite di 200 variabili locali di Lua
local menu = { podio = require "menu.podio", armeria = require "menu.armeria", scelta = require "menu.scelta",
	allenamento = require "menu.allenamento", fine_livello = require "menu.fine_livello", campagna = require "menu.campagna" }
local missioni = require "sim.missioni"
local levette = require "battaglia.levette"
local camera = require "battaglia.camera"
local oggetti = require "battaglia.oggetti"
local punteggio = require "battaglia.punteggio"
local hud = require "battaglia.hud"
local guida = require "battaglia.guida"
local schermo = require "ui.schermo"
-- nel browser senza estensione (build web) basta la WebSocket del browser
local ws = websocket or (html5 and require "main.ws_browser")

-- W, H: lo schermo del gioco (16:9; su altre proporzioni lo schermo vero va da
-- schermo.x0 a x1 e da y0 a y1, ui/schermo.lua); la mappa è game.WORLD_W x game.WORLD_H
local W, H = schermo.W, schermo.H
local TW, TH = game.WORLD_W / game.CELL, game.WORLD_H / game.CELL

local DEFAULT_SERVER = "ws://127.0.0.1:8080/ws"
-- Versione del protocollo, uguale a protocolVersion in server/server.go
local PROTOCOL = 2
-- Se la connessione cade in partita riproviamo per un po' (il server tiene il
-- posto per 20 secondi)
local RECONNECT_TRIES, RECONNECT_WAIT = 12, 1.5
local SERVER_ERRORS = {
	version = "C'è una versione nuova di MegaBlast:\naggiorna il gioco",
	expired = "La partita è finita",
	draining = "Il server si sta aggiornando,\nriprova tra poco",
}

-- le azioni dell'input, in una tabella sola (limite di 200 variabili locali)
