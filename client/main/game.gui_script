-- Phone or computer: [megablast] comandi = telefono / computer to pick it,
-- otherwise from the system (and from the browser, if it is a phone). During
-- the match it switches by itself: a finger on the screen turns on the
-- sticks, a key turns them off.
local COMMANDS = config_string("megablast.comandi", "")
local function touch_device()
	if COMMANDS == "telefono" then return true end
	if COMMANDS == "computer" then return false end
	local name = sys.get_sys_info().system_name
	if name == "Android" or name == "iPhone OS" then return true end
	if name == "HTML5" and html5 then
		return html5.run("('ontouchstart' in window) || navigator.maxTouchPoints > 0") == "true"
	end
	return false
end

local function server_url()
	if sys.get_config_string then
		return sys.get_config_string("megablast.server_url", DEFAULT_SERVER)
	end
	return sys.get_config("megablast.server_url", DEFAULT_SERVER)
end

-- Terrain -----------------------------------------------------------------------

-- The map mesh reads the collision mask from a 640 x 360 texture:
-- r = terrain now, g = terrain at the start (to recognize craters), b =
-- distance from the edge of the nearest crater (Sergio, 2 Nov: «un cerchio
-- perfetto»): the physics digs in cells, but the painted maps' shader draws
-- the real circle, interpolating the distance between cells.
-- After an explosion we send only the crater's rectangle back to the GPU.
local MASK_PATH = "/battle/maschera_viva.texturec"
local RGBA = hash("rgba")
local MASK_FORMAT = { { name = RGBA, type = buffer.VALUE_TYPE_UINT8, count = 4 } }

-- the constants live in graphics (recent Defold) or in resource (old)
local TEX_2D = graphics and graphics.TEXTURE_TYPE_2D or resource.TEXTURE_TYPE_2D
local TEX_RGBA = graphics and graphics.TEXTURE_FORMAT_RGBA or resource.TEXTURE_FORMAT_RGBA

-- b: 128 on the crater's edge, 8 levels per world unit (from -16 to +16),
-- 255 far from all of them; terrain.fp reads it this way
-- (in a table: the script is close to the limit of 200 local variables)
local CR = { BORDER = 128, STEP = 8, CELLS = 7 } -- CELLS: past the radius, 16 units (a cell is 3)

-- Every crater of the match (x, y, r), to redo the b channel if the whole
-- mask is redrawn: the list is valid for one match (self.g)
function CR.lista(self)
	if self.craters_g ~= self.g then self.craters, self.craters_g = {}, self.g end
	return self.craters
end

-- Writes into the b channel (self.mask_stream) the distance from the crater
-- (x, y, r). Steel cells and those touching them stay out: steel isn't dug
-- and its outline isn't bitten
function CR.dig(self, x, y, r)
	local data, full, c = self.g.terrain.data, self.mask_stream, game.CELL
	if not full then return 0, 0, 0, 0 end
	local cx0 = math.max(0, math.floor((x - r) / c) - CR.CELLS)
	local cx1 = math.min(TW - 1, math.floor((x + r) / c) + CR.CELLS)
	local cy0 = math.max(0, math.floor((y - r) / c) - CR.CELLS)
	local cy1 = math.min(TH - 1, math.floor((y + r) / c) + CR.CELLS)
	local outside = CR.BORDER + CR.STEP * 2
	for cy = cy0, cy1 do
		local dy = (cy + 0.5) * c - y
		for cx = cx0, cx1 do
			local dx = (cx + 0.5) * c - x
			local v = CR.BORDER + (math.sqrt(dx * dx + dy * dy) - r) * CR.STEP
			v = math.floor(math.max(0, math.min(255, v)) + 0.5)
			local i = cy * TW + cx + 1
			if v < outside and (data[i] == 2 or (cx > 0 and data[i - 1] == 2)
				or (cx < TW - 1 and data[i + 1] == 2) or data[i - TW] == 2 or data[i + TW] == 2) then
				v = outside
			end
			local j = i * 4 - 1
			if v < full[j] then full[j] = v end
		end
	end
	return cx0, cy0, cx1, cy1
end

-- The explosion craters in a list of skipped events (replay, recipe): so
-- when the mask is redrawn they are there too
function CR.remember(self, events)
	local k = CR.lista(self)
	for _, e in ipairs(events) do
		if e.type == "explosion" then k[#k + 1] = { x = e.x, y = e.y, r = e.r } end
	end
end

local function mask_params(w, h, x, y)
	return {
		type = TEX_2D, format = TEX_RGBA,
		width = w, height = h, x = x, y = y,
	}
end

-- Redraws the whole mask at the end of the update (paint_terrain): entering
-- a mission it was requested three times in the same frame, and each time
-- it is 230 thousand cells (docs/prestazioni.md)
local function draw_terrain(self)
	self.pending_terrain = true
end

local function paint_terrain(self)
	if not self.pending_terrain or not self.g then return end
	self.pending_terrain = false
	local data = self.g.terrain.data
	-- the same buffer for every map: no new 900 KB to collect
	local buf = self.mask_buf or buffer.create(TW * TH, MASK_FORMAT)
	local st = buffer.get_stream(buf, RGBA)
	-- buffer.create doesn't clear the memory: we write every cell
	for i = 1, TW * TH do
		local v = data[i] ~= 0 and 255 or 0
		local j = i * 4 - 3
		st[j], st[j + 1], st[j + 2], st[j + 3] = v, v, 255, 255
	end
	self.mask_stream = st
	self.mask_buf = buf
	for _, k in ipairs(CR.lista(self)) do CR.dig(self, k.x, k.y, k.r) end
	frames.segna("maschera")
	if self.mask_tex then
		resource.set_texture(self.mask_tex, mask_params(TW, TH), buf)
	else
		self.mask_tex = resource.create_texture(MASK_PATH, mask_params(TW, TH), buf)
	end
	msg.post("/terreno#script", "maschera", { path = self.mask_tex, mappa = self.g.map })
end

-- Updates the mask in the given rectangle (cell coordinates)
local function redraw_cells(self, cx0, cy0, cx1, cy1)
	-- the whole mask is already to be redone
	if self.pending_terrain then return end
	cx0, cy0 = math.max(0, cx0), math.max(0, cy0)
	cx1, cy1 = math.min(TW - 1, cx1), math.min(TH - 1, cy1)
	if cx1 < cx0 or cy1 < cy0 then return end
	local w, h = cx1 - cx0 + 1, cy1 - cy0 + 1
	local data, full = self.g.terrain.data, self.mask_stream
	local buf = buffer.create(w * h, MASK_FORMAT)
	local st = buffer.get_stream(buf, RGBA)
	local k = 1
	for cy = cy0, cy1 do
		local i = cy * TW + cx0 + 1
		for _ = 1, w do
			local j = i * 4 - 3
			local now = data[i] ~= 0 and 255 or 0
			full[j] = now
			st[k], st[k + 1], st[k + 2], st[k + 3] = now, full[j + 1], full[j + 2], 255
			i, k = i + 1, k + 4
		end
	end
	resource.set_texture(self.mask_tex, mask_params(w, h, cx0, cy0), buf)
end

-- Messages and menus -------------------------------------------------------------

local function show_message(self, text, keep)
	-- a message takes the waiting flame's place
	if self.attesa then menu.attesa.via(self.attesa) end
	gui.set_text(self.message, text)
	gui.cancel_animations(self.message, "color.w")
	gui.set_color(self.message, WHITE)
	if not keep then
		gui.animate(self.message, "color.w", 0, gui.EASING_INCUBIC, 0.6, 1.2)
	end
end

-- At every turn start, big under the robot: IL TUO TURNO to whoever plays
-- (online whoever is on the phone, against the bots and in the missions the
-- first robot), TURNO DI: NOME to the others (and on the same phone, where
-- you all play). In the lessons it stays until you touch the controls
-- (sim/missions.lua, attesa), then fades.
local function announce_turn(self, robot)
	local my_own = (self.mode == "online" and robot == self.me)
		or (self.mode == "local" and (next(self.bots) or self.missione) and robot == 1)
	gui.set_text(self.announcement, my_own and TM.your_turn or TM.turn_of:format(string.upper(self.names[robot])))
	gui.cancel_animations(self.announcement, "color")
	local c = self.colors[robot]
	gui.set_color(self.announcement, vmath.vector4(c.x, c.y, c.z, 1))
	self.banner_wait = my_own and self.missione ~= nil and self.missione.attesa
	if not self.banner_wait then
		gui.animate(self.announcement, "color.w", 0, gui.EASING_INCUBIC, 0.6, 1.4)
	end
	-- once it has vanished (the swap button sits above it and waits)
	self.banner_end = self.clock + 2
end

-- The wheel open or closed: RIPROVA (not online), ESCI DALLA PARTITA and,
-- below, the first setting: the gauge or reticle aim
local function open_wheel(self, is_open)
	self.menu_open = is_open
	if self.rotellina then ui.luce(self.rotellina, nil) end
	gui.set_enabled(self.btn_retry, is_open and self.mode == "local")
	gui.set_enabled(self.btn_quit, is_open)
	gui.set_enabled(self.btn_aim, is_open)
	gui.set_enabled(self.btn_reread, is_open and self.mode == "local" and self.missione ~= nil and #self.vign_pages > 0)
	gui.set_text(self.btn_aim_text, TM.aim_mode:format(string.upper(profile.setting(self.profilo, "mira"))))
	gui.set_text(self.rotellina[2].testo, self.mode == "connecting" and TM.quit_search or TM.quit_match)
	if self.sala then menu.lobby.wheel_open(self.sala, is_open) end
end

local function set_controls_visible(self, visible)
	self.controls_visible = visible
	gui.set_enabled(self.move_pad.base, visible and self.touch_ui)
	gui.set_enabled(self.aim_pad.base, visible and self.touch_ui)
	gui.set_enabled(self.bar, visible)
	gui.set_enabled(self.btn_tele.nodo, visible)
	if not visible and self.guide then self.guide:aggiorna(nil) end
	self.tele_sees = visible
	-- the lessons show time and points only once they explain them (sim/missions.lua vedi)
	hud.stopwatch_on(self.chrono, visible and missions.vede(self.missione, "tempo"))
	score.conceal(self.punti, not missions.vede(self.missione, "punti"))
	if not visible then
		hud.tag_away(self.tag)
		gui.cancel_animations(self.announcement, "color.w")
		gui.set_color(self.announcement, vmath.vector4(1, 1, 1, 0))
		self.banner_wait = false
	end
	gui.set_enabled(self.chosen_glow, false)
	score.set_enabled(self.punti, visible)
	gui.set_enabled(self.btn_zoom, visible)
	gui.set_enabled(self.btn_menu, visible)
	open_wheel(self, false)
end

local function disconnect(self)
	if self.conn then
		ws.disconnect(self.conn)
		self.conn = nil
	end
end

-- Screens outside the battle (podium, armory): they are created when they
-- open and deleted when they close, so they weigh nothing while playing. Each
-- module has new, on_input (-> "indietro" / "continua" to leave), destroy
-- and, if animated, update. All live nodes together: about 650 for the
-- battle, plus the 2 vs 2 podium (about 275) or the armory (up to 330), and
-- before the match the four lineup tags with the draft (with pieces, powers
-- and badges they went past 2048 nodes and the match didn't start, 1
-- November): that's why game.gui's max_nodes is 4096.
local function close_screen(self)
	if self.schermata then
		self.schermata.mod.destroy(self.schermata.obj)
		self.schermata = nil
	end
end

-- without_veil: you get here with a transition (ui/transition.lua), which already covers
local function show_menu(self, without_veil)
	close_screen(self)
	if self.sala then menu.lobby.destroy(self.sala); self.sala = nil end
	self.podium_t = nil
	-- in the queue the connection stays: you can go around the menus (ui/pill.lua)
	if not self.queue then disconnect(self) end
	self.mode = "menu"
	home.show(self.home, without_veil)
	home.queued(self.home, self.queue ~= nil)
	-- the server's events: the line under EVENTI (and the board, the queue)
	self.events_t = 0
	home.eventi(self.home, menu.eventi.home_line())
	-- going back to the home they are refreshed (at startup the entry asks for
	-- them, CP.entra, which is born after the first home)
	if self.ingresso == nil and self.passaggio then
		menu.eventi.load_up(server_url(), function() home.eventi(self.home, menu.eventi.home_line()) end)
	end
	-- behind the home only the Forge's painted background, scrolling slowly
	-- (Sergio, 2 Nov): the terrain mesh draws it without the map, the world isn't visible
	msg.post("/terreno#script", "home", { sfondo = "forgia" })
	gui.set_enabled(self.mondo, false)
	set_controls_visible(self, false)
	show_message(self, "", true)
	self.missione, self.missione_attesa, self.end_t = nil, nil, nil
	self.vetrine, self.conta, self.from_the_profile = nil, nil, nil
	if self.flag then self.flag:display(nil) end
	if self.signal then self.signal:display(nil) end
	score.obiettivo(self.punti, nil)
	self.vign:quiet()
	-- the finished match is let go (Sergio, 3 Nov): nothing keeps it (the replay
	-- is in the profile, RIPROVA starts a new one), so its terrain cells and the
	-- bots (about 2 MB of Lua for a 1 vs 1, 4 for a 2 vs 2) go to the garbage
	-- collector, and render no longer moves the invisible world every frame.
	-- The world shows again only when the next match exists (new_match): before,
	-- while connecting, waiting for players or in the draft, the old match was
	-- still on screen. What stays is reused by the next match: the GUI nodes (a
	-- fixed pool), the mask buffer and the map's painting in terrain.script.
	self.g, self.bots, self.ricetta, self.view = nil, nil, nil, nil
	self.craters, self.craters_g = nil, nil
	self.drawn_map, self.pending_terrain = nil, false
end

-- Smoothness -------------------------------------------------------------------
-- The simulation advances in fixed steps (60 per second locally, one state
-- every SNAPSHOT_TICKS online), while the screen may run at 60, 90 or 120 Hz.
-- We always draw a position interpolated between the previous pose (a) and
-- the latest (b), so motion doesn't stutter.

-- Poses are reused tables: no allocation every frame, so no garbage
-- collector pauses.
local function new_pose()
	local o = {}
	for i = 1, game.MAX_ORBS do o[i] = { id = 0, x = 0, y = 0 } end
	local sh = {}
	for i = 1, game.SHARD_COUNT do sh[i] = { x = 0, y = 0, on = false } end
	-- c: crates by id (while falling they move, so they are interpolated too)
	local r = {}
	for i = 1, game.MAX_PLAYERS do r[i] = { x = 0, y = 0 } end
	return { r = r, p = { x = 0, y = 0 }, has_p = false,
		o = o, no = 0, s = sh, c = {} }
end

-- The orb with that number in the pose, or nil
local function find_orb(pose, id)
	for i = 1, pose.no do
		if pose.o[i].id == id then return pose.o[i] end
	end
end

local function capture(pose, g)
	for i, rb in ipairs(g.robots) do
		local r = pose.r[i]
		r.x, r.y, r.g = rb.x, rb.y, rb.grounded
		-- the Grapple's hook in flight
		r.gs = rb.hook_shot ~= nil
		if r.gs then r.gx, r.gy = rb.hook_shot.x, rb.hook_shot.y end
	end
	pose.has_p = g.projectile ~= nil
	if pose.has_p then pose.p.x, pose.p.y = g.projectile.x, g.projectile.y end
	local n = math.min(#g.orbs, game.MAX_ORBS)
	for i = 1, n do
		local src, dst = g.orbs[i], pose.o[i]
		dst.id, dst.x, dst.y = src.id, src.x, src.y
	end
	pose.no = n
	for i = 1, game.SHARD_COUNT do
		local sh, ps = g.shards[i], pose.s[i]
		ps.on = sh ~= nil
		if sh then ps.x, ps.y = sh.x, sh.y end
	end
	for _, pc in pairs(pose.c) do pc.seen = false end
	for _, c in ipairs(g.crates) do
		local pc = pose.c[c.id]
		if not pc then
			pc = {}
			pose.c[c.id] = pc
		end
		pc.x, pc.y, pc.landed, pc.seen = c.x, c.y, c.landed, true
	end
	for id, pc in pairs(pose.c) do
		if not pc.seen then pose.c[id] = nil end
	end
end

local function pose_k(self)
	return math.max(0, math.min(1, self.pose_t / self.pose_dt))
end

local ORB_TMP = {}
for i = 1, game.MAX_ORBS do ORB_TMP[i] = { id = 0, x = 0, y = 0 } end

-- Moves pose a toward b by fraction k (a becomes what is on screen)
local function advance_pose(a, b, k)
	for i, rb in ipairs(b.r) do
		local ra = a.r[i]
		ra.x, ra.y, ra.g = ra.x + (rb.x - ra.x) * k, ra.y + (rb.y - ra.y) * k, rb.g
		if rb.gs then
			if not ra.gs then ra.gx, ra.gy = rb.gx, rb.gy end
			ra.gx, ra.gy = ra.gx + (rb.gx - ra.gx) * k, ra.gy + (rb.gy - ra.gy) * k
		end
		ra.gs = rb.gs
	end
	if b.has_p then
		if not a.has_p then a.p.x, a.p.y = b.p.x, b.p.y end
		a.p.x, a.p.y = a.p.x + (b.p.x - a.p.x) * k, a.p.y + (b.p.y - a.p.y) * k
	end
	a.has_p = b.has_p
	-- b's orbs, each starting from where it was in a (same number)
	for i = 1, b.no do
		local ob, s = b.o[i], ORB_TMP[i]
		local oa = find_orb(a, ob.id) or ob
		s.id, s.x, s.y = ob.id, oa.x + (ob.x - oa.x) * k, oa.y + (ob.y - oa.y) * k
	end
	for i = 1, b.no do
		local s, d = ORB_TMP[i], a.o[i]
		d.id, d.x, d.y = s.id, s.x, s.y
	end
	a.no = b.no
	for i = 1, game.SHARD_COUNT do
		local sa, sb = a.s[i], b.s[i]
		if sb.on then
			if not sa.on then sa.x, sa.y = sb.x, sb.y end
			sa.x, sa.y = sa.x + (sb.x - sa.x) * k, sa.y + (sb.y - sa.y) * k
		end
		sa.on = sb.on
	end
	for id, cb in pairs(b.c) do
		local ca = a.c[id]
		if not ca then
			ca = { x = cb.x, y = cb.y }
			a.c[id] = ca
		end
		ca.x, ca.y, ca.landed = ca.x + (cb.x - ca.x) * k, ca.y + (cb.y - ca.y) * k, cb.landed
	end
	for id in pairs(a.c) do
		if not b.c[id] then a.c[id] = nil end
	end
end

-- After a teleport the robot must not slide from the old point to the new one
local function snap_robot(self, i)
	local ra, rb = self.pose_a.r[i], self.pose_b.r[i]
	local rg, v = self.g.robots[i], self.view[i]
	ra.x, ra.y = rg.x, rg.y
	rb.x, rb.y = rg.x, rg.y
	v.x, v.y, v.px = rg.x, rg.y, nil
end

local function reset_pose(self)
	self.pose_a = self.pose_a or new_pose()
	self.pose_b = self.pose_b or new_pose()
	capture(self.pose_a, self.g)
	capture(self.pose_b, self.g)
	self.pose_t = 0
end

-- Match -----------------------------------------------------------------------

-- Names and colors: the team's, with the number if there are two in the team.
-- list: the robots or the players, each with team.
local function names_colors(list)
	local size, nth, names, colors = {}, {}, {}, {}
	for _, p in ipairs(list) do size[p.team] = (size[p.team] or 0) + 1 end
	for i, p in ipairs(list) do
		nth[p.team] = (nth[p.team] or 0) + 1
		names[i] = TEAM_NAMES[p.team] .. (size[p.team] > 1 and (" " .. nth[p.team]) or "")
		colors[i] = TEAM_COLORS[p.team]
	end
	return names, colors
end

-- The match starts from its recipe (sim/replay.lua): the bots are the
-- players with bot = level, and the keys of whoever plays end up in it
local function new_match(self, seed, map, opts)
	-- who speaks is said by the mission (start_mission), later
	self.speak = nil
	if self.carta then self.carta:close_view(); self.carta = nil end
	self.ricetta = replay.nuova(seed, map, opts)
	self.g, self.bots = replay.partita(self.ricetta)
	-- the world shows only now that there is a match (show_menu)
	msg.post("/terreno#script", "home", {})
	gui.set_enabled(self.mondo, true)
	-- if this intact map is already on screen (RIPROVA, the next mission) we don't redraw it
	if self.g.map ~= self.drawn_map then
		draw_terrain(self)
		self.drawn_map = self.g.map
	end
	self.names, self.colors = names_colors(self.g.robots)
	for i in pairs(self.bots) do self.names[i] = self.names[i] .. TM.bot_suffix end
	for i = #self.g.robots + 1, game.MAX_PLAYERS do
		scoria.set_enabled(self.robots[i].rig, false)
		plate.set_enabled(self.robots[i].plate, false)
	end
	self.view = {}
	for i, rb in ipairs(self.g.robots) do
		scoria.set_color(self.robots[i].rig, self.colors[i])
		scoria.set_enabled(self.robots[i].rig, true)
		plate.colore(self.robots[i].plate, self.colors[i])
		plate.set_enabled(self.robots[i].plate, true)
		plate.vita(self.robots[i].plate, rb.hp, rb.max_hp, rb.shield)
		self.view[i] = { x = rb.x, y = rb.y, hp = rb.hp, scudo = rb.shield }
	end
	local plates = {}
	for i = 1, game.MAX_PLAYERS do plates[i] = self.robots[i].plate end
	score.partita(self.punti, self.g, TEAM_NAMES, plates)
	self.trail_n = 0
	self.pose_dt = game.DT
	reset_pose(self)
	self.aiming = false
	self.weapon = "missile"
	self.tele_armed = false
	self.hands, self.hand_of = {}, nil   -- on the same phone, in each one's hands
	self.orbs_wait = 0   -- our orbs still flying toward the teleport
	self.snap = {}
	self.crate_tabs = {}
	for _, n in ipairs(self.crate_nodes) do n.id = nil; gui.set_enabled(n.node, false) end
	self.acc = 0
	self.sent = {}
	-- the camera already starts on whoever's turn it is
	local rb = self.g.robots[self.g.current]
	camera.from_terrain(self.cam, self.g.terrain, game.DISEGNO_H + 40)
	camera.salta(self.cam, rb.x, rb.y + game.DISEGNO_H / 2, camera.zoom(self.cam))
	self.cam_pause = 0
	self.fermo = 0
end

-- A single vector reused for all the frame's positions
local POS = vmath.vector3(0, 0, 0)
local function set_pos(node, x, y)
	POS.x, POS.y = x, y
	gui.set_position(node, POS)
end

local EULER = vmath.vector3(0, 0, 0)

-- Explosion: a 12-frame flipbook plus an additive ember flash.
-- The nodes are few and reused in rotation, so none are created during the match.
local BRACE = vmath.vector4(1, 0.478, 0.102, 1)
local function hide_node(_, node) gui.set_enabled(node, false) end

local function explosion(self, x, y, r)
	self.boom_i = self.boom_i % #self.booms + 1
	local b = self.booms[self.boom_i]
	local d = r * 3.6
	gui.set_enabled(b.anim, true)
	gui.set_position(b.anim, vmath.vector3(x, y, 0))
	gui.set_size(b.anim, vmath.vector3(d, d, 0))
	gui.set_euler(b.anim, vmath.vector3(0, 0, math.random(0, 359)))
	gui.play_flipbook(b.anim, "esplosione", hide_node)

	gui.set_enabled(b.flash, true)
	gui.cancel_animations(b.flash)
	gui.set_position(b.flash, vmath.vector3(x, y, 0))
	gui.set_size(b.flash, vmath.vector3(r * 6, r * 6, 0))
	gui.set_color(b.flash, BRACE)
	gui.animate(b.flash, "color.w", 0, gui.EASING_OUTQUAD, 0.45, 0, hide_node)

	-- debris: pieces of rock and ember thrown upward
	for j = 1, DEBRIS_PER_SHOT do
		self.debris_i = self.debris_i % #self.debris + 1
		local d = self.debris[self.debris_i]
		local a = math.pi / 2 + (math.random() * 2 - 1) * 1.1
		local v = r * (5 + math.random() * 5)
		d.x, d.y, d.vx, d.vy = x, y, math.cos(a) * v, math.sin(a) * v
		d.a, d.va, d.t = math.random() * 360, (math.random() * 2 - 1) * 720, 0
		local side_of = r * (0.16 + math.random() * 0.14)
		gui.set_size(d.node, vmath.vector3(side_of, side_of, 0))
		local c = j % 2 == 0 and DARK_EMBER or STONE
		d.col.x, d.col.y, d.col.z = c.x, c.y, c.z
		gui.set_enabled(d.node, true)
	end
	-- the screen jolts even if nobody is hit; we remember where a hit comes from
	-- to push whoever is hit
	camera.shake(self.cam, math.random() - 0.5, -1, 3 + r * 0.2)
	self.shot_x, self.shot_y, self.shot_t = x, y, self.clock
end

local function move_debris(self, dt)
	for _, d in ipairs(self.debris) do
		if d.t < DEBRIS_LIFE then
			d.t = d.t + dt
			d.vy = d.vy - game.GRAVITY * dt
			d.x, d.y, d.a = d.x + d.vx * dt, d.y + d.vy * dt, d.a + d.va * dt
			d.col.w = math.min(1, (DEBRIS_LIFE - d.t) / 0.3)
			POS.x, POS.y = d.x, d.y
			gui.set_position(d.node, POS)
			EULER.z = d.a
			gui.set_euler(d.node, EULER)
			gui.set_color(d.node, d.col)
			if d.t >= DEBRIS_LIFE then gui.set_enabled(d.node, false) end
		end
	end
end

-- Where the hit that took robot i's health comes from: the explosion or the
-- punch of a moment ago, otherwise whoever's turn it is (the sword)
local function shot_from(self, i)
	if self.shot_t and self.clock - self.shot_t < 0.5 then return self.shot_x, self.shot_y end
	local v = self.view[self.g.current]
	if self.g.current == i then return v.x - 1, v.y end
	return v.x, v.y + game.DISEGNO_H / 2
end

-- Titan's Fist shockwave: a ring of embers spreading out
local function shock(self, x, y)
	local n = self.shock
	gui.set_enabled(n, true)
	gui.cancel_animations(n)
	gui.set_position(n, vmath.vector3(x, y, 0))
	gui.set_size(n, vmath.vector3(20 * K, 20 * K, 0))
	gui.set_color(n, BRACE)
	gui.animate(n, "size", vmath.vector3(90 * K, 90 * K, 0), gui.EASING_OUTQUAD, 0.35)
	gui.animate(n, "color.w", 0, gui.EASING_INQUAD, 0.35, 0, hide_node)
end

local function who_name(self, robot)
	if self.mode == "online" and robot == self.me then return common.you end
	return self.names[robot]
end

local function my_turn(self)
	if not self.g then return false end
	return (self.mode == "local" and not self.bots[self.g.current]) or (self.mode == "online" and self.g.current == self.me)
end

-- Whose weapons are in the bar: online ours, locally those of whoever's turn it is
local function bar_robot(self)
	if self.mode == "online" then return self.g.robots[self.me] end
	-- against the bots, always the player's weapons
	if next(self.bots) then return self.g.robots[1] end
	return self.g.robots[self.g.current]
end

-- Grapple and Bellows as drawn, in a single table: the file is close to the
-- 200 locals Lua allows
local RM = { fune = require "battle.rope", GUSTS = 5 }
-- The character sheet (Sergio, 31 Oct) in a single table: tags, lineup,
-- end-of-match stats and replay. The functions further down, before
-- start_local (they use new_match, show_menu and the others)
local CP = { conta = require "menu.tally", vetrina = require "menu.showcase", tag = require "ui.tag_card",
	vignette = require "battle.vignette" }

-- The zoom (Sergio, 3 Nov, choice Z1; 4 Nov): one button, top right, that is
-- both a switch and a slider. Inside it a small lens slides on a track with a
-- notch at each end: the lens says "zoom", the track says "it slides", and the
-- lens sits where the zoom is between the nearest (top) and the farthest
-- (bottom). A quick tap jumps between the chosen zoom and the farthest.
-- Holding it a moment (or dragging) opens the long guide beside it, with the
-- same lens under the finger. From then on the zoom follows how much the
-- finger moves, not where it is (Sergio, 4 Nov: «che continui a fare il suo
-- dovere ovunque stai spostando il dito»): ZM.RUN units for the whole range,
-- down zooms out, no stop at the guide's ends (it slides with the finger),
-- and coming back from a limit works at once. The mouse wheel takes small
-- steps; with the controller you hold the zoom button and move the aiming stick.
CP.ZM = {
	STEP = 0.12,        -- a wheel notch or a key, in shares of the zoom
	RUN = 230,          -- finger travel for the whole zoom, and the guide's length
	HOLD = 0.22,        -- held this long without moving, the guide opens (no tap)
	TICKS = 24,         -- a micro-vibration every 1/TICKS of the zoom while dragging
	DRAG_PX = 10,       -- past this the finger drags and it is no longer a tap
	STICK_RATE = 0.9,   -- with the controller: shares of the zoom per second at full stick
	W = 48, H = 48,     -- the button (round: W is its diameter)
	MARK = 24,          -- the small track inside the button
	LENS = 13,          -- the lens in the button (the one on the guide is bigger)
}
local ZM = CP.ZM

-- a small lens (ring and handle) centred on the ring, d its diameter
function ZM.lens(d, parent)
	local n = box(0, 0, d, d, ui.C.LIGHT)
	gui.set_visible(n, false) -- only a holder: its children show
	gui.set_parent(n, parent)
	local t = math.max(2, d * 0.17)
	ui.disco(0, 0, d - t, vmath.vector4(0.05, 0.05, 0.07, 1), n) -- the glass hides the track
	ui.ring_node(0, 0, d, t, ui.C.LIGHT, n)
	local h = box(d * 0.42, -d * 0.42, t + 0.5, d * 0.45, ui.C.LIGHT)
	gui.set_rotation(h, vmath.vector3(0, 0, 45))
	gui.set_parent(h, n)
	return n
end

function ZM.make_ui(self)
	local dark = vmath.vector4(0.05, 0.05, 0.07, 0.55)
	local dim = vmath.vector4(1, 1, 1, 0.35)
	-- round, with a thin pale rim (Sergio, 4 Nov: «in un contorno tondo, e fatto bene»)
	self.btn_zoom = fit(ui.disco(0, 0, ZM.W, dark))
	gui.set_position(self.btn_zoom, ZOOM_BTN)
	fit(ui.ring_node(0, 0, ZM.W, 1.5, vmath.vector4(1, 1, 1, 0.5), self.btn_zoom))
	gui.set_parent(box(0, 0, 2, ZM.MARK, dim), self.btn_zoom)
	gui.set_parent(box(0, ZM.MARK / 2, 8, 2, dim), self.btn_zoom)
	gui.set_parent(box(0, -ZM.MARK / 2, 8, 2, dim), self.btn_zoom)
	self.zoom_point = ZM.lens(ZM.LENS, self.btn_zoom)
	-- the long guide, left of the button (the thumb covers the button), only
	-- while held; it is put in place under the finger (ZM.show_guide)
	-- a capsule: the body and a round cap at each end
	self.zoom_guide = box(-ZM.W / 2 - 18, 0, 20, ZM.RUN, dark)
	gui.set_parent(self.zoom_guide, self.btn_zoom)
	for _, side in ipairs({ 1, -1 }) do -- half discs, so nothing overlaps the body
		local cap = fit(ui.disco(0, side * ZM.RUN / 2, 20, dark, self.zoom_guide))
		gui.set_fill_angle(cap, 180)
		if side < 0 then gui.set_rotation(cap, vmath.vector3(0, 0, 180)) end
	end
	gui.set_parent(box(0, 0, 2, ZM.RUN, vmath.vector4(1, 1, 1, 0.45)), self.zoom_guide)
	gui.set_parent(box(0, ZM.RUN / 2, 10, 2, vmath.vector4(1, 1, 1, 0.45)), self.zoom_guide)
	gui.set_parent(box(0, -ZM.RUN / 2, 10, 2, vmath.vector4(1, 1, 1, 0.45)), self.zoom_guide)
	self.zoom_cursor = ZM.lens(16, self.zoom_guide)
	gui.set_enabled(self.zoom_guide, false)
end

-- every frame: the lens inside the button where the zoom is (if it changed),
-- and the guide opening when the button is held
ZM.POINT = vmath.vector3()
function ZM.display(self)
	local d = self.zoom_finger
	if d and not d.open and self.clock - d.t >= ZM.HOLD then ZM.show_guide(self, d.y) end
	local f = self.cam.f
	if self.zoom_f == f then return end
	self.zoom_f = f
	ZM.POINT.y = (f - 0.5) * ZM.MARK
	gui.set_position(self.zoom_point, ZM.POINT)
end

-- the guide slides so that its lens, at the zoom's place, is under the finger
ZM.GUIDE, ZM.CURSOR = vmath.vector3(-ZM.W / 2 - 18, 0, 0), vmath.vector3()
function ZM.show_guide(self, y)
	local d = self.zoom_finger
	d.open = true
	gui.set_enabled(self.zoom_guide, true)
	local k = (self.cam.f - 0.5) * ZM.RUN
	ZM.GUIDE.y = y - ZOOM_BTN.y - k
	ZM.CURSOR.y = k
	gui.set_position(self.zoom_guide, ZM.GUIDE)
	gui.set_position(self.zoom_cursor, ZM.CURSOR)
end

-- y of the finger on screen
function ZM.premi(self, y)
	self.zoom_finger = { y = y, last = y, t = self.clock, moved = false }
end

function ZM.trascina(self, y)
	local d = self.zoom_finger
	if not d then return end
	if not d.moved and math.abs(y - d.y) > ZM.DRAG_PX then d.moved = true end
	if not d.moved then return end
	-- relative: the zoom moves by how much the finger moved since last time
	camera.trascina(self.cam, self.cam.f + (y - d.last) / ZM.RUN)
	d.last = y
	local f = self.cam.f
	-- a micro-vibration at every notch (Sergio, 3 Nov: «un feedback di vibrazione granulare»)
	local notch = math.floor(f * ZM.TICKS + 0.5)
	if d.notch and notch ~= d.notch then CP.vibrate() end
	d.notch = notch
	ZM.show_guide(self, y)
end

-- a tap only if it was quick and still; held to look, nothing changes
function ZM.release(self)
	local d = self.zoom_finger
	self.zoom_finger = nil
	gui.set_enabled(self.zoom_guide, false)
	if d and not d.moved and not d.open then camera.toggle(self.cam) end
end

-- Shots that left the screen at the top (Sergio, 3 Nov: «non mi interessa sapere
-- quanto è in alto, ma in che punto tornerà sullo schermo», for the teleports):
-- a small V per shot, in the shooter's color, above
-- the points, at the shot's x. It follows it while it is out and disappears
-- when it comes back. Missile, egg, sniper, every orb, the swarm (one for all)
CP.NOTCH = { W = 18, BELOW = 10, LATO = 12, N = 4 }

-- the plates stand this many screen units above the horns, at every zoom
CP.PLATE_GAP = 4

function CP.notch_create(self)
	self.ticks = {}
	for i = 1, CP.NOTCH.N do
		local f = plate.arrow()
		local k = CP.NOTCH.W / f.w
		gui.set_scale(f.radice, vmath.vector3(k, k, 1))
		f.pos = vmath.vector3()
		self.ticks[i] = f
	end
	self.notches_n = 0
end

-- every frame: CP.notch(self, x, y) for every shot in flight (in the world), then
-- CP.notches_end(self, color)
function CP.notch(self, x, y)
	local sx, sy = camera.to_screen(self.cam, x, y)
	if sy <= screen.y1 or self.notches_n >= CP.NOTCH.N then return end
	self.notches_n = self.notches_n + 1
	local f = self.ticks[self.notches_n]
	f.pos.x = math.max(screen.x0 + CP.NOTCH.LATO, math.min(screen.x1 - CP.NOTCH.LATO, sx))
	f.pos.y = screen.y1 - CP.NOTCH.BELOW
	gui.set_position(f.radice, f.pos)
end

function CP.notches_end(self, color)
	for i, f in ipairs(self.ticks) do
		local above = i <= self.notches_n
		if above then plate.arrow_color(f, color) end
		if above ~= f.acceso then
			gui.set_enabled(f.radice, above)
			f.acceso = above
		end
	end
	self.notches_n = 0
end

-- The entry (Sergio, 1 Nov): the home opens only when the game has from the
-- server what it needs (today the events, main/events.lua), so it is always
-- complete. If the server doesn't answer it retries after 0.5, 1 and 2
-- seconds; after ENTRY.max it enters anyway, with "senza rete" under EVENTI,
-- and the home retries by itself every 5 seconds. It stays at least
-- ENTRY.min, so as not to flicker. In the scenarios the server isn't awaited:
-- the entry closes at once, unless prova_ingresso holds it for that many
-- seconds (scenari/ingresso.txt)
CP.ENTRY = { min = 0.5, max = 4, pause = { 0.5, 1, 2 } }

function CP.entra(self)
	self.entry_t, self.entry_ready = 0, false
	local attempts = 0
	local function try_it()
		if not self.ingresso then return end
		menu.eventi.load_up(server_url(), function()
			self.entry_ready = true
		end, function()
			attempts = attempts + 1
			local paused = CP.ENTRY.pause[attempts]
			if paused and self.ingresso then timer.delay(paused, false, try_it) end
		end)
	end
	try_it()
end

function CP.close_entry(self, at_once)
	local e = self.ingresso
	if not e then return end
	self.ingresso = nil
	home.eventi(self.home, menu.eventi.home_line())
	if at_once then menu.ingresso.via(e) else menu.ingresso.close_view(e) end
end

function CP.entry_update(self, dt)
	local e = self.ingresso
	menu.ingresso.update(e, dt)
	self.entry_t = self.entry_t + dt
	local t = self.entry_t
	if (self.entry_ready and t >= CP.ENTRY.min) or t >= CP.ENTRY.max then
		CP.close_entry(self)
	elseif t > 1.5 then
		-- a real wait: say what is being done
		menu.ingresso.riga(e, TM.loading_events)
	end
end

-- The waiting room (menu/lobby.lua): the server's "wait" says who is in the
-- queue, in order (vetrine: level and badges) and our place (you)
function CP.open_room(self, m)
	menu.attesa.via(self.attesa)
	local of = tonumber(m.of) or 0
	if of < 1 or of > game.MAX_PLAYERS or type(m.vetrine) ~= "table" then return end
	if not self.sala then
		self.sala = menu.lobby.new(of, profile.GROUP_NAMES[self.coda] or "", self.btn_menu)
	end
	-- ours first, then the others in queue order
	local list = { CP.vetrina.from_profile(self.profilo, common.you, nil, TM.in_queue) }
	list[1].tu = true
	for i = 1, math.min(#m.vetrine, of) do
		if i ~= m.you then list[#list + 1] = CP.vetrina.from_net(m.vetrine[i], TM.player, nil, TM.in_queue) end
	end
	if menu.lobby.giocatori(self.sala, list) then sound.play("#punto") end
	menu.lobby.bot_in(self.sala, m.bot_in)
end

function CP.close_room(self)
	if self.sala then menu.lobby.destroy(self.sala) end
	self.sala = nil
end

-- The waiting flame (ui/waiting.lua) instead of a fixed message
function CP.aspetta(self, txt)
	gui.cancel_animations(self.message, "color.w")
	gui.set_text(self.message, "")
	menu.attesa.display(self.attesa, txt)
end

-- The transitions (ui/transition.lua): the slider between menus, the iris
-- between menus and battle. CP.radici: the root nodes of what is visible now
function CP.radici(self)
	if self.mode == "menu" then return self.home.tops end
	local o = self.schermata and self.schermata.obj
	local r = o and (o.radice or o.root)
	return { r }
end

-- toward: 1 forward (the new one arrives from the right), -1 back
function CP.slide(self, toward, change)
	menu.passaggio.slider(self.passaggio, CP.radici(self), function()
		change()
		return CP.radici(self)
	end, toward)
end

function CP.iris(self, change)
	menu.passaggio.iris(self.passaggio, change)
end

-- Where the hand of whoever fires the Grapple is, in the drawing (the rope starts there)
function RM.rope_hand(self, who)
	local v = self.view[who]
	return v.x + self.g.robots[who].facing * game.MUZZLE * 0.5, v.y + game.SWORD_PIVOT_Y
end

-- The Bellows' gust: RM.GUSTS lines of air fanning out from the nozzle,
-- stretching and fading, as long as its reach (config.BELLOWS)
function RM.gust(self, x, y, angle)
	local b = gconfig.BELLOWS
	for i = 1, RM.GUSTS do
		local n = self.gusts[i]
		local a = angle + b.cone * 0.8 * ((i - 1) / (RM.GUSTS - 1) * 2 - 1)
		local l = b.range * (i % 2 == 1 and 0.85 or 0.65)
		gui.set_enabled(n, true)
		gui.cancel_animations(n)
		gui.set_euler(n, vmath.vector3(0, 0, math.deg(a)))
		gui.set_position(n, vmath.vector3(x + math.cos(a) * 6, y + math.sin(a) * 6, 0))
		gui.set_size(n, vmath.vector3(10, 3 * K, 0))
		gui.set_color(n, vmath.vector4(1, 1, 1, 0.85))
		local d = 0.22 + i % 2 * 0.06
		gui.animate(n, "position", vmath.vector3(x + math.cos(a) * l * 0.6, y + math.sin(a) * l * 0.6, 0), gui.EASING_OUTQUAD, d)
		gui.animate(n, "size", vmath.vector3(l * 0.7, 1.5 * K, 0), gui.EASING_OUTQUAD, d)
		gui.animate(n, "color.w", 0, gui.EASING_INQUAD, d, 0, hide_node)
	end
end

local function handle_event(self, e)
	if SIMULATE then print("SIMULA evento " .. e.type) end
	if self.conta then CP.conta.evento(self.conta, self.g, e) end
	-- the campaign characters speak (battle/quips.lua); everyday quips
	-- don't cover a quip just said
	if self.speak then
		local i, s, strong, moment = self.speak:evento(e, self.g.current)
		if s then
			local fabbro = self.speak.chi[i] == "fabbro"
			self.vign:quip(fabbro and "fabbro" or "apprendista", CP.vignette.QUIP_FACE[moment], s,
				not fabbro and who_name(self, i) or nil, not fabbro and TEAM_COLORS[self.g.robots[i].team] or nil, strong)
		end
	end
	if e.type == "explosion" then
		local row_min, row_max = e.row_min, e.row_max
		if self.mode == "online" then
			-- online we dig the terrain ourselves, at the same point as the server
			row_min, row_max = self.g.terrain:carve(e.x, e.y, e.r)
		end
		self.drawn_map = nil
		local k = CR.lista(self)
		k[#k + 1] = { x = e.x, y = e.y, r = e.r }
		local cx0, cy0, cx1, cy1 = CR.dig(self, e.x, e.y, e.r)
		redraw_cells(self, math.min(cx0, math.floor((e.x - e.r) / game.CELL) - 1), math.min(cy0, row_min - 1),
			math.max(cx1, math.floor((e.x + e.r) / game.CELL) + 1), math.max(cy1, row_max + 1))
		explosion(self, e.x, e.y, e.r)
		self.cam_pause, self.pause_x, self.pause_y = CAMERA_HOLD, e.x, e.y
	elseif e.type == "fire" or e.type == "sniper" or e.type == "grenade" or e.type == "orb" or e.type == "shards" then
		-- recoil of the Rune launcher (and of the sniper), throw momentum, shard burst
		local kind = (e.type == "fire" or e.type == "sniper") and "missile" or (e.type == "shards" and "shards" or "throw")
		scoria.fire(self.robots[e.robot].rig, kind)
	elseif e.type == "teleport" then
		if self.mode == "online" then
			-- the state with the robot in its new position arrives right after the event
			self.snap[e.robot] = true
		else
			snap_robot(self, e.robot)
		end
	elseif e.type == "teleports" or e.type == "swap" then
		-- swapping the second attack gives an orb, which flies like the time ones
		e.amount = e.amount or 1
		show_message(self, e.type == "swap" and TM.swap:format(who_name(self, e.robot))
			or (e.amount == 1 and TM.orbs_one or TM.orbs_many):format(who_name(self, e.robot), e.amount))
		-- they fly from the ring: ours to the teleport button, an opponent's onto
		-- them (Sergio), silent
		-- in the first turns of the guided match the orbs fly slowly, to be watched
		local r = self.missione
		local slowed = r and r.l.guidata and r.st.turni <= 3 and 2.5 or nil
		-- if they are our orbs the small number waits for them to arrive: each one
		-- raises it with a flash and a "pling" a bit higher than the previous one
		-- (orbs leaving again before arriving no longer count: start from here)
		local my_own = bar_robot(self) == self.g.robots[e.robot]
		local where = gui.get_position(self.btn_tele.nodo)
		if my_own then
			self.orbs_wait = math.min(e.amount, hud.ORBS)
		else
			local v = self.view[e.robot]
			local x, y = camera.to_screen(self.cam, v.x, v.y + game.DISEGNO_H / 2)
			where = vmath.vector3(x, y, 0)
		end
		hud.globi(self.chrono, e.amount, where, slowed, my_own and function(i)
			self.orbs_wait = math.max(0, self.orbs_wait - 1)
			hud.round_flash(self.btn_tele)
			sound.play("#globo", { speed = hud.ORB_TONES[math.min(i, #hud.ORB_TONES)] })
		end)
	elseif e.type == "trap" then
		show_message(self, TM.trapped:format(who_name(self, e.robot)))
		shock(self, e.x, e.y)
	elseif e.type == "eagle" then
		-- straight shot: the white trace from the barrel to the point hit, fading in
		-- a quarter of a second
		scoria.fire(self.robots[e.robot].rig, "missile")
		local n, dx, dy = self.tracer, e.x1 - e.x0, e.y1 - e.y0
		gui.set_enabled(n, true)
		gui.cancel_animations(n)
		gui.set_position(n, vmath.vector3((e.x0 + e.x1) / 2, (e.y0 + e.y1) / 2, 0))
		gui.set_size(n, vmath.vector3(math.sqrt(dx * dx + dy * dy), 2.5 * K, 0))
		gui.set_euler(n, vmath.vector3(0, 0, math.deg(math.atan2(dy, dx))))
		gui.set_color(n, WHITE)
		gui.animate(n, "color.w", 0, gui.EASING_INQUAD, 0.25, 0, hide_node)
		if e.target then
			-- the shot comes from the barrel: the push on whoever is hit goes from there
			self.shot_x, self.shot_y, self.shot_t = e.x0, e.y0, self.clock
		end
	elseif e.type == "hook_shot" then
		-- the hook leaves: it leaves the barrel and the rope stretches behind it (render)
		scoria.fire(self.robots[e.robot].rig, "shards")
		scoria.uncino(self.robots[e.robot].rig, false)
		self.rope_who, self.rope = e.robot, nil
	elseif e.type == "hook" then
		-- the rope stays taut while it pulls (rope): to the hooked robot, or to the
		-- puller if it hooked the terrain. A miss: it falls with the wire
		self.rope = e.target or e.anchor and e.robot or nil
		if not self.rope then
			local x0, y0 = RM.rope_hand(self, e.robot)
			RM.fune.cade(self.fune, x0, y0, e.x1, e.y1)
		end
		if e.target then
			self.shot_x, self.shot_y, self.shot_t = e.x0, e.y0, self.clock
			plate.announcement(self.robots[e.target].plate, TM.hooked)
		end
	elseif e.type == "hook_end" and e.snap then
		-- the rope ran out before arriving: it snaps with a crack and falls with its
		-- hook, the enemy stays there (over the void it falls)
		sound.play("#strappo")
		plate.announcement(self.robots[e.robot].plate, TM.snapped)
		if self.rope == e.robot then
			self.rope = nil
			local x0, y0 = RM.rope_hand(self, e.by)
			local v = self.view[e.robot]
			RM.fune.cade(self.fune, x0, y0, v.x, v.y + game.DISEGNO_H / 2)
		end
	elseif e.type == "bellows" then
		-- the gust: the bellows squash and a fan of air leaves the nozzle
		scoria.fire(self.robots[e.robot].rig, "missile")
		RM.gust(self, e.x, e.y, e.angle)
	elseif e.type == "bellows_hit" then
		self.shot_x, self.shot_y, self.shot_t = self.g.robots[e.robot].x, self.g.robots[e.robot].y + game.DISEGNO_H / 2, self.clock
		plate.announcement(self.robots[e.target].plate, TM.blown)
	elseif e.type == "lunge" then
		scoria.lunge(self.robots[e.robot].rig)
	elseif e.type == "mallet" then
		scoria.fire(self.robots[e.robot].rig, "throw")
	elseif e.type == "mallet_hit" then
		-- the wave where the hammer struck; if the hitter bounces, its plate says so
		shock(self, e.x, e.y)
		local by = self.g.robots[e.robot]
		if e.target then self.shot_x, self.shot_y, self.shot_t = by.x, by.y + game.SWORD_PIVOT_Y, self.clock end
		if e.bounce then plate.announcement(self.robots[e.robot].plate, TM.bounce) end
	elseif e.type == "lunge_hit" then
		shock(self, e.x, e.y)
		self.shot_x, self.shot_y, self.shot_t = e.x, e.y, self.clock
	elseif e.type == "sniper_bounce" then
		-- the sniper's shot bounces clumsily: it squashes and shakes
		self.boing = self.clock
	elseif e.type == "sniper_hit" then
		shock(self, e.x, e.y)
		plate.announcement(self.robots[e.target].plate, TM.knocked)
		self.shot_x, self.shot_y, self.shot_t = e.x, e.y, self.clock
	elseif e.type == "final_round" then
		score.last_lap(self.punti)
	elseif e.type == "parachute" then
		show_message(self, TM.parachute)
	elseif e.type == "status" then
		plate.announcement(self.robots[e.robot].plate, TM.status_shout[e.kind])
	elseif e.type == "heal_spawn" then
		show_message(self, TM.heal_circle)
	elseif e.type == "heal" then
		plate.announcement(self.robots[e.robot].plate, "+" .. e.amount)
	elseif e.type == "recharge" then
		-- the Blade hit an enemy: a secondary shot comes back
		plate.announcement(self.robots[e.robot].plate, "+1 " .. (hud.NAMES[e.weapon] or string.upper(e.weapon)))
		CP.recharge(self, e)
	elseif e.type == "crate" then
		show_message(self, TM.crate)
	elseif e.type == "crate_pick" then
		local found = (self.mode == "online" and e.robot == self.me) and TM.you_found or TM.found
		show_message(self, found:format(who_name(self, e.robot), TM.weapon_found[e.weapon]))
		-- a new weapon locally: its card (battle/card.lua) stops the game until
		-- you tap PROVALA. Always in the lessons, otherwise the first time
		local l = self.missione and self.missione.l
		if self.mode == "local" and e.robot == 1 and (l or next(self.bots))
			and (profile.new_weapon(self.profilo, e.weapon) or (l and l.aspetta)) then
			profile.salva(self.profilo)
			self.carta = require("battle.card").open_view(e.weapon, PAD.comandi(self))
		end
	elseif e.type == "punch_hit" then
		shock(self, e.x, e.y)
		self.shot_x, self.shot_y, self.shot_t = e.x, e.y, self.clock
		self.cam_pause, self.pause_x, self.pause_y = CAMERA_HOLD * 0.5, e.x, e.y
	elseif e.type == "points" then
		-- the number is born on whoever is hit (on the robot itself if it loses points or parries)
		local from_pt = (e.amount < 0 or e.reason == "parry" or not e.other) and e.robot or e.other
		local v, s = self.view[from_pt], self.cam_s or 1
		if v then
			score.punti(self.punti, e, v.x * s + (self.cam_tx or 0), (v.y + scoria.altezza(self.robots[from_pt].rig)) * s + (self.cam_ty or 0))
		end
	elseif e.type == "turn" then
		score.turno(self.punti, self.g)
		-- what you hold stays from one turn to the next, even if you picked it on the
		-- others' turn (Sergio, 30 October); on the same phone each one finds their
		-- own again (at the start the Rune launcher)
		local who = (self.mode == "online" or next(self.bots)) and bar_robot(self).id or e.robot
		if self.hand_of ~= who then
			if self.hand_of then self.hands[self.hand_of] = { self.weapon, self.tele_armed } end
			local m = self.hands[who]
			self.weapon, self.tele_armed = m and m[1] or "missile", m and m[2] or false
			self.hand_of = who
		end
		announce_turn(self, e.robot)
	elseif e.type == "death" then
		-- collapses and fades by itself; after 1.5 s it reappears elsewhere, in the same turn
		scoria.die(self.robots[e.robot].rig)
		plate.set_enabled(self.robots[e.robot].plate, false)
		-- without points (the lessons that don't talk about them) only what happened
		local without = self.g.no_points
		if e.own then
			-- died alone on its own turn: the kill goes to whoever did it the most damage
			local who = (self.mode == "online" and e.robot == self.me) and TM.you_die_alone or TM.dies_alone:format(self.names[e.robot])
			local penalty = gconfig.SCORE.death + gconfig.SCORE.self_death
			show_message(self, without and who .. "!"
				or e.by and TM.dies_alone_given:format(who, penalty, e.points, who_name(self, e.by))
				or TM.dies_alone_penalty:format(who, penalty))
		elseif e.by then
			local verb = e.env and TM.pushes_off or TM.eliminates
			show_message(self, verb:format(who_name(self, e.by), who_name(self, e.robot))
				.. (without and "" or TM.points:format(e.points)))
		end
	elseif e.type == "gone" then
		-- left the match: it vanishes and doesn't come back
		scoria.set_enabled(self.robots[e.robot].rig, false)
		plate.set_enabled(self.robots[e.robot].plate, false)
	elseif e.type == "respawn" then
		scoria.set_enabled(self.robots[e.robot].rig, true)
		plate.set_enabled(self.robots[e.robot].plate, true)
		if self.mode == "online" then
			self.snap[e.robot] = true
		else
			snap_robot(self, e.robot)
		end
	elseif e.type == "over" then
		-- prova_vince 1: the first robot's team wins (scenari/podio_forgia.txt)
		if SIMULATE and config_int("megablast.prova_vince", 0) > 0 then e.winner = self.g.robots[1].team end
		-- the replay is over: back to the profile
		if self.rewatching then
			CP.replay_end(self)
			return
		end
		local text
		if self.mode == "online" then
			local mine = self.g.robots[self.me].team
			text = e.winner == mine and TM.you_won or (e.winner and TM.you_lost or TM.draw)
		else
			text = e.winner and TM.team_wins:format(TEAM_NAMES[e.winner]) or TM.draw
		end
		if e.reason == "time" then text = TM.time_up:format(text) end
		show_message(self, text, true)
		self.online_end = self.mode == "online"
		self.mode = "ended"
		-- after a moment (or at the first tap) the podium with the results; a
		-- campaign battle (not the guided match) ends with its stars instead
		-- (open_level_end): with both, the podium stayed under the stars screen
		-- and the game looked stuck (Sergio, 3 nov)
		if not (self.missione and not self.missione.l.guidata) then
			self.risultati = e.results
			self.podium_t = PODIUM_WAIT
		end
	end
end

-- The podium, with the results of the match just ended. Whoever plays on this
-- phone (online their robot, locally the first) gains experience.
local function open_podium(self)
	self.podium_t = nil
	local res = self.risultati
	local giocatori, me = {}, self.online_end and self.me or nil
	for i in ipairs(self.g.robots) do
		local nome = (self.online_end and i == self.me) and common.you or self.names[i]
		giocatori[i] = { nome = nome, colore = self.colors[i] }
	end
	local my_own = me or 1
	local spot, taken = #res.ranking, {}
	for _, v in ipairs(res.ranking) do
		if v.robot == my_own then spot = v.place end
	end
	local per_robot = awards.assign(res.ranking)
	taken = per_robot[my_own] or taken
	local gain = profile.match_end(self.profilo, spot, taken)
	profile.salva(self.profilo)
	-- the stats and the match into the profile (also saves the replay)
	local number = CP.registra(self, res)
	for i, g in ipairs(giocatori) do g.vetrina = self.match_showcases and self.match_showcases[i] end
	show_message(self, "", true)
	set_controls_visible(self, false)
	-- first the screen, then the mode: if new breaks, no mode is left without a screen
	self.schermata = { mod = menu.podium, obj = menu.podium.new(res, giocatori, me, gain, self.profilo, number) }
	self.mode = "schermata"
end

local function open_screen(self, mod, ...)
	home.hide(self.home)
	self.schermata = { mod = mod, obj = mod.new(...) }
	self.mode = "schermata"
	-- the queue's pill stays above the new screen
	if self.pill then menu.pill.raise(self.pill) end
end

-- Online ------------------------------------------------------------------------

local function send(self, msg)
	if self.conn then
		ws.send(self.conn, json.encode(msg), { type = ws.DATA_TYPE_TEXT })
	end
end

local function apply_state(self, s)
	local g = self.g
	g.phase, g.current, g.timer = s.phase, s.cur, s.timer
	g.window, g.final_round, g.round = s.win or 0, s.fr or false, s.gr or 1
	g.ahead, g.ahead_base = s.av or 0, s.ab or 0
	local u = s.u or 0
	g.used.primary, g.used.secondary, g.used.tool = u % 2 == 1, u % 4 >= 2, u >= 4
	g.match_left = s.mt or g.match_left
	for i, r in ipairs(s.r) do
		local rb = g.robots[i]
		rb.x, rb.y, rb.hp, rb.facing, rb.dead, rb.grounded = r.x, r.y, r.hp, r.f, r.d, r.g
		rb.teleports_left, rb.turns, rb.points = r.tl or 0, r.tu or 1, r.pt or 0
		rb.round_done = r.gd or false
		rb.max_hp = r.mh or rb.max_hp
		if r.gn and not rb.gone then
			-- whoever comes back after a drop didn't see anyone leave: the robot vanishes here
			rb.gone = true
			scoria.set_enabled(self.robots[i].rig, false)
			plate.set_enabled(self.robots[i].plate, false)
		end
		rb.swing = (r.s or 0) > 0 and r.s or nil
		rb.swing_dir = (r.sd or 0) ~= 0 and r.sd or rb.facing
		rb.punch = (r.pu or 0) > 0 and r.pu or nil
		rb.punch_dir = (r.pd or 0) ~= 0 and r.pd or rb.facing
		rb.swing_base, rb.punch_base = r.sb or 0, r.pb or 0
		rb.ammo.grenade, rb.ammo.shards, rb.ammo.punch = r.ag or 0, r.as or 0, r.ap or 0
		rb.ammo.sniper = r.ac or 0
		rb.secondary = (r.sw or "") ~= "" and r.sw or nil
		for _, w in ipairs(game.DRAFT_SECONDARIES) do rb.ammo[w] = w == rb.secondary and (r.ss or 0) or 0 end
		rb.lunge = (r.lu or 0) > 0 and r.lu or nil
		-- the Lunge's spear points along the dash (la: its angle)
		rb.lunge_vx = rb.lunge and math.cos(r.la or 0) or nil
		rb.lunge_vy = rb.lunge and math.sin(r.la or 0) or nil
		rb.knocked = r.kn or false
		rb.hooked = (r.hk or 0) > 0 and { by = r.hk } or (r.hk or 0) < 0 and { x = r.hx, y = r.hy } or nil
		rb.hook_shot = r.gs and { x = r.gx, y = r.gy } or nil
		rb.mallet = (r.ml or 0) > 0 and r.ml or nil
		rb.mallet_stop = (r.ms or 0) > 0 and r.ms or nil
		rb.mallet_dir = (r.md or 0) ~= 0 and r.md or nil
		rb.mallet_base = r.mb or 0
		rb.ammo.trap, rb.ammo.shield, rb.ammo.trampoline = r.ak or 0, r.ad or 0, r.am or 0
		rb.shield = (r.sh or 0) > 0 and r.sh or nil
		rb.parachute = r.pa or false
		rb.parachutes_left = r.pl or 0
		-- turns left: burn, slow x 10, cracked armor x 100
		local st = r.st or 0
		for k, kind in ipairs({ "burn", "slow", "cracked" }) do
			local turns = math.floor(st / 10 ^ (k - 1)) % 10
			rb.status[kind] = turns > 0 and { turns = turns } or nil
		end
	end
	g.projectile = s.p and { x = s.p.x, y = s.p.y, kind = s.p.k, fuse = s.p.fu } or nil
	g.orbs = {}
	for i, o in ipairs(s.o or {}) do g.orbs[i] = { id = o.i, x = o.x, y = o.y } end
	for i = 1, game.SHARD_COUNT do g.shards[i] = nil end
	for _, sh in ipairs(s.s or {}) do g.shards[sh.i] = sh end
	-- placed traps and springboards
	for i = #g.placed, 1, -1 do g.placed[i] = nil end
	for i, o in ipairs(s.pl or {}) do
		g.placed[i] = { id = o.i, kind = o.k, x = o.x, y = o.y, armed = o.a, team = o.tm, r = o.r, flying = o.v }
	end
	-- healing circles
	for i = #g.heals, 1, -1 do g.heals[i] = nil end
	for i, h in ipairs(s.hl or {}) do g.heals[i] = { id = h.i, x = h.x, y = h.y } end
	-- crates: tables reused by id
	local list = g.crates
	for i = #list, 1, -1 do list[i] = nil end
	for i, c in ipairs(s.c or {}) do
		local t = self.crate_tabs[c.i] or {}
		self.crate_tabs[c.i] = t
		t.id, t.x, t.y, t.landed = c.i, c.x, c.y, c.l
		list[i] = t
	end
	-- restart from where we are on screen toward the new state
	advance_pose(self.pose_a, self.pose_b, pose_k(self))
	capture(self.pose_b, g)
	for i in pairs(self.snap) do
		snap_robot(self, i)
		self.snap[i] = nil
	end
	self.pose_t = 0
	self.pose_dt = game.SNAPSHOT_TICKS * game.DT
end

local function on_server_message(self, m)
	if m.t == "wait" then
		CP.queue_wait(self, m)
	elseif m.t == "draft" and self.queue and self.mode ~= "connecting" then
		-- the queue filled while you were in the menus or training: three seconds
		-- on the pill, then the lineup
		CP.queue_found(self, m)
	elseif m.t == "draft" then
		-- weapon draft (menu/pick.lua): it arrives at every change, ours or the
		-- others'. The token is already needed to come back if the connection drops now.
		self.tok, self.tries = m.tok or self.tok, 0
		local first = self.mode ~= "scelta_online"
		if first then
			self.queue = nil
			CP.close_room(self)
			show_message(self, "", true)
			-- the players are found: the search's gear goes away (the match has its own)
			open_wheel(self, false)
			gui.set_enabled(self.btn_menu, false)
		end
		self.mode = "scelta_online"
		local name_list, palette = names_colors(m.players)
		self.online_teams = {}
		for i, p in ipairs(m.players) do self.online_teams[i] = p.team end
		menu.pick.online(self.scelta, m, name_list, palette, function(msg) send(self, msg) end)
		if first then
			-- the lineup: the server also gives the draft its time
			-- (config.LINEUP_SECONDS); coming back halfway, only the strip
			local stays = math.min(gconfig.LINEUP_SECONDS, (m.left or 0) * game.DT - gconfig.DRAFT_SECONDS)
			CP.open_lineup(self, CP.vetrine(self, m.players, name_list, { me = m.you, rete = m.vetrine or {} }),
				profile.GROUP_NAMES[m.mode] or "", stays)
		end
	elseif m.t == "start" and not self.online_iris then
		-- the match starts under the iris (the painted map loads in a long
		-- frame); what the server sends meanwhile waits and goes after it
		self.online_iris = {}
		CP.iris(self, function()
			local waiting = self.online_iris
			self.online_iris = nil
			on_server_message(self, { t = "start_now", m = m })
			for _, q in ipairs(waiting) do on_server_message(self, q) end
		end)
	elseif self.online_iris then
		self.online_iris[#self.online_iris + 1] = m
	elseif m.t == "start_now" then
		m = m.m
		CP.close_room(self)
		menu.pick.hide(self.scelta)
		-- also when we come back after a drop (resume): the match is rebuilt from the
		-- seed, then the digs and the state arrive.
		-- players: the robots' teams and their draft picks,
		-- [{"team":1,"pick":"shards","secondary":"eagle","tool":"hook"},...]
		-- regole: those of the queue's event (sim/rules.lua), as on the server
		local opts = m.players and { players = m.players }
		if type(m.regole) == "table" then opts = menu.regole.opzioni(m.regole, opts or {}) end
		new_match(self, m.seed, m.map, opts)
		self.g:pop_events()
		self.online_teams = {}
		for i, rb in ipairs(self.g.robots) do self.online_teams[i] = rb.team end
		self.me, self.tok, self.tries = m.you, m.tok, 0
		CP.inizio(self, m.you, m.vetrine or {}, nil, false)
		self.mode = "online"
		set_controls_visible(self, true)
		show_message(self, m.resume and TM.back_in or TM.you_are:format(self.names[m.you]))
	elseif m.t == "sync" and self.g then
		local k = CR.lista(self)
		for _, c in ipairs(m.x) do
			self.g.terrain:carve(c[1], c[2], c[3])
			k[#k + 1] = { x = c[1], y = c[2], r = c[3] }
		end
		self.drawn_map = nil
		draw_terrain(self)
	elseif m.t == "state" and self.g then
		apply_state(self, m)
		if self.conta then CP.conta.tick(self.conta, self.g) end
	elseif m.t == "ev" and self.g then
		handle_event(self, m)
	elseif m.t == "away" then
		show_message(self, TM.opponent_away, true)
	elseif m.t == "back" and m.robot ~= self.me then
		show_message(self, TM.opponent_back)
	elseif m.t == "left" then
		-- whoever leaves doesn't come back; the server goes on while two teams remain
		self.exited[m.robot] = true
		local remain, seen_weapons = 0, {}
		for i, team in ipairs(self.online_teams or {}) do
			if not self.exited[i] and not seen_weapons[team] then seen_weapons[team], remain = true, remain + 1 end
		end
		if remain >= 2 then
			show_message(self, TM.left:format(self.mode == "online" and self.names[m.robot] or TM.someone))
			return
		end
		menu.pick.hide(self.scelta)
		self.mode = "ended"
		show_message(self, TM.back_to_menu:format(TM.opponent_left), true)
	elseif m.t == "error" and self.queue and self.mode ~= "connecting" then
		self.queue.lost = true
		disconnect(self)
	elseif m.t == "error" then
		self.queue = nil
		CP.close_room(self)
		menu.pick.hide(self.scelta)
		self.mode, self.tok = "ended", nil
		show_message(self, TM.back_to_menu:format(TM.server_errors[m.e] or TM.server_error), true)
	end
end

local on_socket

local function connect(self)
	self.conn = ws.connect(server_url(), { timeout = 5000 }, on_socket)
end

on_socket = function(self, conn, data)
	-- the last events of a connection left behind (ESCI DALLA PARTITA) don't count
	if conn ~= self.conn then return end
	if data.event == ws.EVENT_CONNECTED then
		-- the first message states the version: in the queue, or back in the match
		if self.tok then
			send(self, { t = "hello", v = PROTOCOL, tok = self.tok })
		else
			CP.aspetta(self, TM.waiting)
			-- the queue picked in DOVE GIOCHI? (menu/queue.lua): 2v2, 1v1 or an event,
			-- and the tag: level and badges (menu/showcase.lua)
			send(self, { t = "hello", v = PROTOCOL, mode = self.coda or "2v2",
				vetrina = CP.vetrina.per_rete(self.profilo) })
		end
	elseif data.event == ws.EVENT_MESSAGE then
		local ok, m = pcall(json.decode, data.message)
		-- any answer other than "aspetta" closes the waiting flame
		if ok and m and m.t ~= "wait" then menu.attesa.via(self.attesa) end
		if ok and m then on_server_message(self, m) end
	elseif data.event == ws.EVENT_DISCONNECTED or data.event == ws.EVENT_ERROR then
		self.conn = nil
		local in_play = self.mode == "online" or self.mode == "connecting" or self.mode == "scelta_online"
		if in_play and self.tok and self.tries < RECONNECT_TRIES then
			-- in a match: we retry, the server keeps our seat
			self.tries = self.tries + 1
			CP.aspetta(self, TM.reconnecting)
			timer.delay(RECONNECT_WAIT, false, function()
				if (self.mode == "online" or self.mode == "connecting" or self.mode == "scelta_online") and not self.conn then connect(self) end
			end)
		elseif self.queue and self.mode ~= "connecting" then
			-- in the queue outside the room: the pill says so, a tap and you are back in
			self.queue.lost = true
		elseif self.mode ~= "menu" and self.mode ~= "ended" then
			-- in the room (or still connecting) the queue goes with the connection:
			-- kept, it would show IN CODA and GIOCA would reopen a room nobody
			-- answers, past the bots' time forever (Sergio, 4 Nov)
			self.queue = nil
			CP.close_room(self)
			menu.pick.hide(self.scelta)
			self.mode = "ended"
			show_message(self, TM.back_to_menu:format(TM.connection_lost), true)
		end
	end
end

-- The home closes; the Forge's background stays until the match exists (new_match)
local function hide_menu(self)
	home.hide(self.home)
end

local function start_online(self, coda)
	-- another queue while still in one (an event's GIOCA): the old one is left
	if self.conn then
		local conn = self.conn
		send(self, { t = "leave" })
		self.conn = nil
		timer.delay(2, false, function() ws.disconnect(conn) end)
	end
	self.coda = coda
	hide_menu(self)
	if not ws then
		-- the extension is downloaded with Project -> Fetch Libraries
		self.mode = "ended"
		show_message(self, TM.back_to_menu:format(TM.no_websocket), true)
		return
	end
	self.mode, self.tok, self.tries = "connecting", nil, 0
	self.exited, self.online_teams = {}, nil
	-- the queue: its mode, the time since you entered, the last "wait"
	self.queue = { mode = coda or "2v2", t = 0 }
	-- while searching for the others you can leave, with the usual gear (Sergio, 3 Nov)
	gui.set_enabled(self.btn_menu, true)
	CP.aspetta(self, TM.connecting)
	connect(self)
end

-- The queue outside the waiting room (Sergio, 3 Nov: "puoi stare a guardare i
-- cartellini, oppure andare indietro senza abbandonare la coda, oppure uscire
-- dalla coda"; plan https://claude.ai/artifact/DfaPTiKqa3MzqNC7kBMsLK).
-- TORNA AI MENU leaves the room but not the queue: the connection stays and
-- self.queue keeps its mode, its time and the last "wait". Meanwhile the pill
-- (ui/pill.lua) says how it goes, and a tap on it or on GIOCA (which
-- stays GIOCA, menu/home.lua) goes back to the room. When the queue fills (the "draft") outside the room,
-- the pill says PARTITA TROVATA for CP.QUEUE_FOUND seconds (a training match
-- stops, under a veil, and is cancelled: nothing goes into the profile), then
-- the iris takes you to the lineup, with the time the countdown used taken
-- off the draft. The campaign is off while queued (menu/home.lua).
CP.QUEUE_FOUND = 3

-- "wait": the room if it is open, otherwise the pill
function CP.queue_wait(self, m)
	local q = self.queue
	if q then
		local n = type(m.vetrine) == "table" and #m.vetrine or 0
		-- someone arrived while you are around: a small jump and the tick
		if q.n and n > q.n and self.mode ~= "connecting" then
			menu.pill.flash(self.pill)
			sound.play("#punto")
		end
		q.n, q.of, q.last, q.bot_left = n, tonumber(m.of) or 0, m, tonumber(m.bot_in)
	end
	if self.mode == "connecting" then CP.open_room(self, m) end
end

function CP.queue_found(self, m)
	local q = self.queue
	if not q.found then
		q.found = { wait = CP.QUEUE_FOUND }
		sound.play("#punto")
		menu.pill.flash(self.pill)
	end
	-- the draft arrives at every pick: the last one counts, with when it came
	q.found.m, q.found.at = m, q.t
end

-- TORNA AI MENU in the room
function CP.queue_to_menu(self)
	CP.close_room(self)
	open_wheel(self, false)
	CP.iris(self, function() show_menu(self, true) end)
end

-- Back to the room (the pill, GIOCA); with the queue lost (or no connection
-- left under it), in again
function CP.queue_open(self)
	local q = self.queue
	CP.iris(self, function()
		close_screen(self)
		if q.lost or not self.conn then
			self.queue = nil
			start_online(self, q.mode)
			return
		end
		hide_menu(self)
		self.mode = "connecting"
		gui.set_enabled(self.btn_menu, true)
		if q.last then
			CP.open_room(self, q.last)
			if self.sala then
				menu.lobby.since(self.sala, q.t)
				menu.lobby.bot_in(self.sala, q.bot_left)
			end
		else
			CP.aspetta(self, TM.waiting)
		end
	end)
end

function CP.queue_tap(self, x, y)
	local m = self.mode
	if not (self.queue and (m == "menu" or m == "schermata" or m == "ended")) then return false end
	if not menu.pill.hit(self.pill, x, y) or self.queue.found then return false end
	CP.queue_open(self)
	return true
end

-- The full queue: the match outside the room ends, the lineup comes
function CP.queue_go(self, q)
	CP.iris(self, function()
		local m = q.found.m
		-- the seconds of the countdown are already gone from the draft
		if m.left then m.left = math.max(0, m.left - math.floor((q.t - q.found.at) / game.DT)) end
		-- the cancelled match (training) is let go without counting (show_menu
		-- forgets the stats); the connection stays because the queue is still there
		show_menu(self, true)
		self.queue = nil
		menu.pill.show(self.pill, false)
		hide_menu(self)
		self.mode = "connecting"
		on_server_message(self, m)
	end)
end

function CP.queue_update(self, dt)
	local q, p = self.queue, self.pill
	if not q then
		if p and p.on then
			p.on = false
			menu.pill.show(p, false)
		end
		return
	end
	q.t = q.t + dt
	if q.bot_left then q.bot_left = math.max(0, q.bot_left - dt) end
	local battle = self.mode == "local"
	local on = self.mode ~= "connecting"
	if on ~= p.on or battle ~= p.battle then
		p.on, p.battle = on, battle
		menu.pill.show(p, on, battle)
		if on then menu.pill.raise(p) end
	end
	if not on then return end
	local text
	if q.found then
		q.found.wait = q.found.wait - dt
		local n = math.max(1, math.ceil(q.found.wait))
		text = TP.found_n:format(n)
		menu.pill.found(p, battle and n or nil)
		if q.found.wait <= 0 and not q.going then
			q.going = true
			CP.queue_go(self, q)
		end
	elseif q.lost then
		text = TP.lost
	else
		local secs = math.floor(q.t)
		text = TP.in_queue:format(profile.GROUP_NAMES[q.mode] or "", math.floor(secs / 60), secs % 60)
		if q.bot_left and q.bot_left <= menu.lobby.BOT_SHOWN and (q.n or 0) < (q.of or 0) then
			text = text .. (q.bot_left > 0 and TP.bots_in:format(math.ceil(q.bot_left)) or TP.bots_coming)
		end
	end
	menu.pill.set(p, text, q.found and (q.of or 0) or (q.n or 0), q.of or 0, q.found ~= nil)
	menu.pill.update(p, dt)
end

-- Character sheet (Sergio, 31 Oct) ---------------------------------------------
-- The tags (ui/tag_card.lua) before the weapon draft (the lineup), during
-- it (the strip at the top) and in the match by tapping the plate; at the end
-- of the match the stats and the match into the profile (menu/tally.lua,
-- profilo.registra) and the replay of those played here (sim/replay.lua).

-- The players' showcases (menu/showcase.lua): whoever plays here with their
-- profile, the others with just the name. opt: me (the robot of whoever
-- plays here), rete (online: everyone's level and badges, from the server)
function CP.vetrine(self, players, name_list, opt)
	local out = {}
	local my_team = players[opt.me] and players[opt.me].team
	for i, p in ipairs(players) do
		local under = i == opt.me and TM.roles.you or p.dummy and TM.roles.dummy or p.team == my_team and TM.roles.mate or TM.roles.opponent
		local v
		if opt.rete then
			v = CP.vetrina.from_net(opt.rete[i], name_list[i], p.team, under)
		elseif i == opt.me then
			v = CP.vetrina.from_profile(self.profilo, name_list[i], p.team, under)
		else
			v = CP.vetrina.simple(name_list[i], p.team, under)
			v.bot = (p.bot or p.dummy) and true or nil
		end
		v.tu = i == opt.me or nil
		out[i] = v
	end
	return out
end

-- Removes the lineup and the strip (also when the draft closes by itself)
function CP.close_choice(self)
	if self.schier then menu.lineup.destroy(self.schier) end
	if self.strip then menu.lineup.destroy(self.strip) end
	self.schier, self.strip = nil, nil
end

-- The lineup over the weapon draft (seconds: how many are left, online)
function CP.open_lineup(self, showcases, title, seconds_left)
	CP.close_choice(self)
	-- they leave with the draft, however it closes
	menu.pick.when_closing(self.scelta, function() CP.close_choice(self) end)
	self.vetrine = showcases
	if seconds_left and seconds_left <= 0 then
		self.strip = menu.lineup.strip(showcases)
		menu.pick.under_strip(self.scelta, self.strip.covers_corner)
		return
	end
	self.schier = menu.lineup.new(showcases, title)
	if seconds_left then self.schier.t = seconds_left end
end

-- Every frame of the draft: true while the lineup covers it (locally the
-- draft's time starts afterwards; online it already runs, the server keeps it)
function CP.update_choice(self, dt)
	if self.schier then
		if not menu.lineup.update(self.schier, dt) then return true end
		menu.lineup.destroy(self.schier)
		self.schier = nil
		if self.vetrine then
			self.strip = menu.lineup.strip(self.vetrine)
			menu.pick.under_strip(self.scelta, self.strip.covers_corner)
		end
		return false
	end
	if self.strip then menu.lineup.update_strip(self.strip, dt) end
	return false
end

-- Taps in the draft: first the lineup and the strip. true if they were theirs
function CP.input_choice(self, action_id, action)
	if self.schier then
		menu.lineup.on_input(self.schier, action_id, action)
		return true
	end
	return self.strip ~= nil and menu.lineup.strip_touch(self.strip, action_id, action)
end

-- At the start of the match: the tags with the real stats and the count of
-- whoever plays here. me: their robot; rete: the showcases from the server
-- (online); gruppo: "campagna" for the missions (otherwise the mode); replay:
-- the match can be rewatched
function CP.inizio(self, me, net, cluster, replay_ok)
	CP.close_card_g(self)
	local name_list, players = {}, {}
	local opt = self.ricetta.opzioni.players or {}
	for i, rb in ipairs(self.g.robots) do
		local n = self.names[i]
		name_list[i] = n:sub(-#TM.bot_suffix) == TM.bot_suffix and n:sub(1, -#TM.bot_suffix - 1) or n
		players[i] = { team = rb.team, bot = self.bots[i] and true or nil, dummy = (opt[i] or {}).dummy }
	end
	local v = self.vetrine
	self.vetrine = nil
	if net or not v or #v ~= #self.g.robots then v = CP.vetrine(self, players, name_list, { me = me, rete = net }) end
	for i, rb in ipairs(self.g.robots) do
		v[i].nome = name_list[i]
		CP.vetrina.with_stats(v[i], rb.stats)
	end
	self.match_showcases = v
	self.conta = me and CP.conta.nuova(self.g, me, name_list) or nil
	self.cp_group, self.cp_replay = cluster, replay_ok
end

-- The tag in a match: it opens by tapping a player's plate (or devil) and
-- closes by tapping again. On your turn it closes and doesn't open (Sergio,
-- 31 Oct): while you play it covers nothing. It comes out on its team's side,
-- under the points; time keeps running meanwhile.
function CP.close_card_g(self)
	if self.card_g then
		CP.tag.destroy(self.card_g.c)
		gui.delete_node(self.card_g.radice)
		self.card_g = nil
	end
end

function CP.open_card_g(self, i)
	CP.close_card_g(self)
	local v = self.match_showcases[i]
	-- the first team on the left, the others on the right (like the points at the top)
	local sx = self.g.robots[i].team == 1
	local x = sx and 20 + CP.tag.WIDE / 2 or W - 20 - CP.tag.WIDE / 2
	local root_node = gui.new_box_node(vmath.vector3(x, H - 78, 0), vmath.vector3(0, 0, 0))
	gui.set_visible(root_node, false)
	gui.set_xanchor(root_node, sx and gui.ANCHOR_LEFT or gui.ANCHOR_RIGHT)
	gui.set_yanchor(root_node, gui.ANCHOR_TOP)
	v.verso = sx and 1 or -1
	local c = CP.tag.new(v, 0, 0, { tu = v.tu }, root_node)
	local note = ui.testo(TM.card_note, 0, -CP.tag.TALL({}) - 14, 0.6,
		ui.C.OFF, root_node)
	gui.set_outline(note, ui.C.SHADOW)
	self.card_g = { c = c, radice = root_node, robot = i }
	if SIMULATE then print("SIMULA cartellino del robot " .. i) end
end

-- The robot under screen point (x, y): from the plate to the feet
function CP.robot_below(self, x, y)
	local s = self.cam.s
	for i, rb in ipairs(self.g.robots) do
		local v = self.view[i]
		if v and not rb.dead and not rb.gone then
			local rx, feet = camera.to_screen(self.cam, v.x, v.y)
			local top = feet + (scoria.cima(self.robots[i].rig) + CP.PLATE_GAP / s + plate.sopra(self.robots[i].plate) * plate.scala(self.cam)) * s
			if math.abs(x - rx) <= math.max(40, 30 * s ^ 0.35) and y >= feet - 10 and y <= top + 10 then return i end
		end
	end
end

-- A tap in a match outside your turn: true if it was for the tag
function CP.match_touch(self, x, y)
	if my_turn(self) or not self.match_showcases then return false end
	local i = CP.robot_below(self, x, y)
	if self.card_g then
		local first_one = self.card_g.robot
		CP.close_card_g(self)
		-- tapping another player switches to theirs
		if i and i ~= first_one then CP.open_card_g(self, i) end
		return true
	end
	if not i then return false end
	CP.open_card_g(self, i)
	return true
end

-- The replay file of a profile match
function CP.file_replay(number)
	return sys.get_save_file("megablast", "replay_" .. profile.replay_place(number))
end

-- End of match: the stats and the match into the profile, and its replay if
-- it was played here. Returns the match number if it can be rewatched
function CP.registra(self, res)
	local c = self.conta
	self.conta = nil
	if not c or not res then return nil end
	local r = CP.conta.fine(c, self.g, res, { gruppo = self.cp_group or res.mode, mappa = self.g.map,
		quando = os.time(), giocatori = self.match_showcases })
	local pa = profile.registra(self.profilo, r)
	if self.cp_replay then
		pa.replay = pcall(sys.save, CP.file_replay(pa.numero), { r = self.ricetta }) or nil
	else
		pa.online = self.online_end or nil
	end
	profile.salva(self.profilo)
	return pa.replay and pa.numero or nil
end

-- Can the match with number numero be rewatched?
function CP.replay_ok(self, number)
	for _, pa in ipairs(self.profilo.partite) do
		if pa.numero == number then return pa.replay == true end
	end
	return false
end

-- The profile (menu/profile_tabs.lua), on a tab
function CP.open_profile(self, card, number)
	open_screen(self, menu.profile_tabs, self.profilo, card, TEAM_COLORS[1],
		function(n) return CP.replay_ok(self, n) end, number)
end

-- Rewatches match numero from tick da: it is replayed from the saved recipe
-- without drawing it up to da, then watched. A tap goes back to the profile.
function CP.rivedi(self, number, from_pt)
	local ok, payload = pcall(sys.load, CP.file_replay(number))
	local r = ok and payload and payload.r
	if not r or r.versione ~= replay.VERSION then
		show_message(self, TM.replay_gone)
		return
	end
	CP.iris(self, function() CP.start_replay(self, r, number, from_pt) end)
end

function CP.start_replay(self, r, number, from_pt)
	close_screen(self)
	hide_menu(self)
	new_match(self, r.seme, r.mappa, r.opzioni)
	self.reader, self.rewatching, self.impronta = replay.reader(r), number, 1
	while self.g.tick < (from_pt or 0) and self.g.phase ~= "over" do
		CP.replay_step(self)
		CR.remember(self, self.g:pop_events())
	end
	draw_terrain(self)
	reset_pose(self)
	local rb = self.g.robots[self.g.current]
	camera.salta(self.cam, rb.x, rb.y + game.DISEGNO_H / 2, camera.zoom(self.cam))
	self.mode = "replay"
	self.acc = 0
	set_controls_visible(self, false)
	show_message(self, "", true)
	-- at the bottom, while it lasts: it is a replay, and how to leave
	local n = ui.titolo(TM.replay_banner, W / 2, 40, 0.5, ui.C.LIGHT)
	gui.set_yanchor(n, gui.ANCHOR_BOTTOM)
	gui.set_outline(n, ui.C.SHADOW)
	self.replay_scritta = n
end

-- A replay step; if the fingerprints don't match (game changed) it stops
function CP.replay_step(self)
	local g = self.g
	g:step(replay.read_step(self.reader, g, self.bots))
	local a = self.reader.r.impronte[self.impronta]
	if a and a.t == g.tick then
		self.impronta = self.impronta + 1
		if a.h ~= g:impronta() then
			self.replay_rotto = true
			return false
		end
	end
	return true
end

-- End of the replay (finished, tapped, or not matching): back in the profile, on that match
function CP.replay_end(self)
	if self.mode ~= "replay" then return end
	-- the replay stops at once; the profile arrives with the iris
	self.mode = "uscita"
	CP.iris(self, function()
		local number = self.rewatching
		self.rewatching, self.reader = nil, nil
		if self.replay_scritta then gui.delete_node(self.replay_scritta) end
		self.replay_scritta = nil
		show_menu(self, true)
		CP.open_profile(self, "partite", number)
		if self.replay_rotto then show_message(self, TM.replay_broken) end
		self.replay_rotto = nil
	end)
end

local start_local_match

-- It starts with the weapon draft (menu/pick.lua); after that, the match.
-- against: { modo, livello, mappa } to play against the bots (menu/training.lua)
local function start_local(self, against)
	hide_menu(self)
	self.ritorno = against and "allenamento" or "home"
	-- training plays on the map chosen (A CASO: one of those open, from the seed);
	-- the other modes on the one the seed picks (sim/maps.lua)
	self.local_map = nil
	if against then
		local open_maps = menu.training.open_maps(profile.total_stars(self.profilo))
		self.local_map = against.mappa ~= "caso" and against.mappa or open_maps[os.time() % #open_maps + 1]
		-- in the test scenarios A CASO is the scenario's map (prova_mappa), so they repeat
		if SIMULATE and against.mappa == "caso" then self.local_map = self.mappa end
	end
	-- [megablast] giocatori = 1v1, 2v2 or ffa (free-for-all), on the same phone (and online queue)
	local modo = against and against.modo or config_string("megablast.giocatori", "1v1")
	local opts = { players = {} }
	for i, p in ipairs(gconfig.MODES[modo]) do
		-- against the bots the player is the first robot, the others are bots
		opts.players[i] = { team = p.team, bot = (against and i > 1) and against.livello or nil }
	end
	self.local_opts = opts
	-- in the test scenarios the draft is there only with prova_scelta 1 (scenario scelta.txt)
	if SIMULATE and config_int("megablast.prova_scelta", 0) == 0 then
		start_local_match(self, nil)
		return
	end
	local name_list, palette = names_colors(opts.players)
	self.mode = "scelta"
	local seed = os.time()
	local d = draft.new(seed, opts.players)
	-- the bots pick at once: only whoever plays stays in the draft
	for i, p in ipairs(opts.players) do
		if p.bot then bot.choose(d, i, seed) end
	end
	menu.pick.show(self.scelta, d, name_list, palette)
	CP.open_lineup(self, CP.vetrine(self, opts.players, name_list, { me = 1 }), profile.GROUP_NAMES[modo] or "")
end

-- The match on the same phone, with the players coming out of the draft (nil: no draft)
start_local_match = function(self, picked)
	local opts = self.local_opts
	if picked then
		for i, p in ipairs(picked) do p.bot = opts.players[i].bot end
		opts = { players = picked }
	end
	if SIMULATE then
		-- only for the test scenarios (the "imposta" command in strumenti/simula)
		local ammo_n = config_int("megablast.prova_armi", 0)
		local ogni = config_int("megablast.prova_casse", 0)
		local hp_value = config_int("megablast.prova_vita", 0)
		-- prova_secondaria = eagle | mallet | lunge | bellows: everyone has that secondary
		local secondary_weapon = config_string("megablast.prova_secondaria", "")
		opts = {
			players = opts.players,
			hp = hp_value > 0 and hp_value or nil,
			secondary = game.SECONDARY[secondary_weapon] and secondary_weapon or nil,
			ammo = ammo_n > 0 and { grenade = ammo_n, shards = ammo_n, punch = ammo_n, sniper = ammo_n,
				trap = ammo_n, shield = ammo_n, trampoline = ammo_n } or nil,
			crate_every = ogni > 0 and ogni or nil,
		}
	end
	-- the first robot plays with the profile's active loadout (a copy: MODES isn't touched)
	local my_own = profile.active_loadout(self.profilo)
	local players = {}
	for i, p in ipairs(opts.players) do
		players[i] = {}
		for k, v in pairs(p) do players[i][k] = v end
	end
	players[1].stats = loadout.stats(game.base_stats(), my_own, profile.tier(self.profilo, my_own))
	opts.players = players
	new_match(self, os.time(), self.local_map or self.mappa, opts)
	-- prova_durata N: the match lasts N seconds (scenari/podio.txt)
	local duration = SIMULATE and config_int("megablast.prova_durata", 0) or 0
	if duration > 0 then
		self.g.match_left = duration * 60
		self.ricetta.durata = self.g.match_left
	end
	if SIMULATE and config_int("megablast.prova_stati", 0) > 0 then
		-- everyone starts with the three status effects, to see them (scenario stati.txt)
		for _, rb in ipairs(self.g.robots) do
			for kind in pairs(gconfig.STATUS) do rb.status[kind] = { turns = 2 } end
		end
	end
	-- prova_vicino N: the second robot starts N pixels right of the first (left if N < 0), on the ground,
	-- within Grapple range (scenario rampino_nemico.txt)
	local near = SIMULATE and config_int("megablast.prova_vicino", 0) or 0
	if near ~= 0 then
		local a, b = self.g.robots[1], self.g.robots[2]
		local y = self.g.terrain:ground_below(a.x + near, a.y + 3 * game.ROBOT_H)
		if y then b.x, b.y, b.grounded = a.x + near, y, true end
	end
	CP.inizio(self, 1, nil, nil, true)
	self.mode = "local"
	set_controls_visible(self, true)
end

-- Campaign missions, lessons and guided match (sim/missions.lua, CAMPAGNA
-- screen). picks: the players coming out of the draft, for the missions that
-- make you draft
-- The mission's line of the moment, in the vignettes (battle/vignette.lua):
-- in the lessons Favilla speaks, in the circles the Fabbro. What explains a
-- control (in the lessons; not what comes mid-move: subito, in the air) and
-- the opening line stop the game on the big
-- vignette the first time (profile.vignetta), then they stay in the strip at
-- the top; the rest is only in the strip. {salta}: how to jump with the
-- controls you have (PAD.TEXTS)
function CP.mission_line(self, r)
	local line = missions.line(r)
	if not line then
		self.vign:say(nil)
		return
	end
	local l = r.l
	local chi = l.aspetta and "favilla" or "fabbro"
	local txt = line.testo:gsub("{(%a+)}", PAD.texts(self))
	if line.apertura or (line.highlight and l.aspetta and not line.subito and line.stops ~= false) then
		local page = { chi = chi, faccia = "spiega", testo = txt, disegno = line.highlight }
		if not self.vign_read[line.testo] then
			self.vign_read[line.testo] = true
			self.vign_pages[#self.vign_pages + 1] = page
		end
		if self.vign_line ~= line and not self.carta then
			self.vign_line = line
			if self.vign_on and profile.vignetta(self.profilo, l.id .. ":" .. line.testo) then
				profile.salva(self.profilo)
				self.carta = self.vign:open({ page }, PAD.comandi(self) == "controller")
			end
		end
	end
	self.vign:say(chi, line.faccia or "calma", txt)
end

local function start_mission(self, id, picks)
	local r = missions.nuova(id)
	hide_menu(self)
	if r.l.draft and not picks then
		self.missione = r
		local players = r.l.giocatori
		local name_list, palette = names_colors(players)
		-- only the weapons already seen (in the simulator all and always the same:
		-- the scenarios know where to tap)
		local d = draft.new(SIMULATE and 1 or os.time(), players, not SIMULATE and profile.weapons_seen(self.profilo) or nil)
		-- no seen weapon to pick: just play
		if #d.offer + #d.offer2 == 0 then return start_mission(self, id, {}) end
		-- targets and bots pick by themselves; the mission's bot keeps its weapons if
		-- they are among those offered (the Smith his Mallet)
		for i, p in ipairs(players) do
			if p.dummy or p.bot then
				bot.choose(d, i, 1)
				if p.pick then draft.pick(d, i, p.pick) end
				if p.secondary then draft.pick(d, i, p.secondary) end
			end
		end
		self.mode = "scelta"
		-- in the campaign the draft is guided: no timer, it explains more, it ends with GIOCA
		menu.pick.show(self.scelta, d, name_list, palette, true)
		for i, p in ipairs(players) do name_list[i] = p.nome or name_list[i] end
		CP.open_lineup(self, CP.vetrine(self, players, name_list, { me = 1 }), r.l.titolo or "")
		return
	end
	new_match(self, missions.partita(r, os.time(), picks, profile.help(self.profilo, id)))
	-- prova_durata N also in the missions' battles (scenari/podio_forgia.txt)
	local duration = SIMULATE and config_int("megablast.prova_durata", 0) or 0
	if duration > 0 then
		self.g.match_left = duration * 60
		self.ricetta.durata = self.g.match_left
	end
	missions.prepara(r, self.g)
	-- the keepers and the opponents with their names, and who speaks
	for i, p in ipairs(r.l.giocatori) do
		if p.nome then self.names[i] = p.nome end
		if p.bot and (p.battute or p.carattere) then
			self.speak = self.speak or require("battle.quips").nuove()
			self.speak.chi[i] = p.battute or p.carattere
		end
	end
	CP.inizio(self, 1, nil, "campagna", false)
	draw_terrain(self)
	reset_pose(self)
	self.missione, self.missione_attesa = r, nil
	self.vign_read, self.vign_pages, self.vign_line = {}, {}, nil
	-- prova_vignette tutte: one page per drawing of the moves (scenari/vignette.txt)
	if SIMULATE and config_string("megablast.prova_vignette", "si") == "tutte" then
		local pages = {}
		for _, name in ipairs(CP.vignette.DRAWINGS) do
			pages[#pages + 1] = { chi = #pages % 2 == 0 and "favilla" or "fabbro", testo = name, disegno = name }
		end
		self.carta = self.vign:open(pages)
	end
	self.mode = "local"
	set_controls_visible(self, true)
	-- the first turn was already taken by missioni.prepara (without time there are no turns to announce)
	if not r.l.without_time then announce_turn(self, self.g.current) end
end

-- The campaign, on the last mission's chapter
local function open_campaign(self)
	show_menu(self, true)
	open_screen(self, menu.campaign, self.chosen_campaign, self.profilo.stelle)
end

-- Every frame: the line above the devil and the goal under the points; done,
-- the stars; failed, it starts over after a moment. The guided match ends
-- with the podium.
local function mission_update(self, dt)
	local r = self.missione
	-- the lessons' guide (battle/guide.lua): the light on the control the line
	-- suggests (the primary or the picked secondary, not the usual Rune launcher
	-- or Blade) and the gestures. Made at the first lesson, after the whole HUD:
	-- so it sits on top
	if not self.guide then
		self.guide = require("battle.guide").new()
		self.levette = { muovi = MOVE_PAD, mira = AIM_PAD }
	end
	local what = self.controls_visible and missions.highlight(r) or nil
	local where
	if what == "teleport" then
		local p = gui.get_position(self.btn_tele.nodo)
		where = { x = p.x, y = p.y, d = TELE_BTN_D }
	elseif what == "baratto" then
		-- the two-arrow button above the stopwatch
		local p = gui.get_position(self.scambio.radice)
		where = { x = p.x, y = p.y, d = 54 }
	elseif what and not self.guide.gesture(what) then
		local chosen
		for _, sl in ipairs(self.slots) do
			local ok = sl.weapon == what or (what == "primaria" and sl.group == 1) or (what == "secondaria" and sl.group == 2)
			if ok and sl.have and sl.x and (not chosen or (sl.weapon ~= "missile" and sl.weapon ~= "sword")) then
				chosen = sl
			end
		end
		if chosen then where = { x = chosen.x, y = chosen.y, d = chosen.d * (chosen.on == 2 and CHOSEN or 1) } end
	end
	self.guide:aggiorna(what, where, PAD.comandi(self), self.levette)
	-- the cards of the weapons the lesson gives without a crate (the Blade, the
	-- Grapple): like the crates' ones they stop the game until you tap PROVALA
	if not self.carta then
		local w = missions.scheda(r)
		if w then
			profile.new_weapon(self.profilo, w)
			profile.salva(self.profilo)
			self.carta = require("battle.card").open_view(w, PAD.comandi(self))
		end
	end
	-- the step wants to see farther (the island): the camera widens
	local z = missions.zoom(r)
	if z then camera.allarga(self.cam, z) end
	-- the checkered flag of the step to do (battle/flag.lua), behind the devils
	local bx, by = missions.flag(r)
	if bx and not self.flag then self.flag = require("battle.flag").new(self.mondo, self.robots[1].rig.root) end
	if self.flag then self.flag:display(bx, by, self.clock) end
	-- the marker on the target to hit now (battle/signal.lua)
	local bi = missions.target_robot(r)
	local brb = bi and self.g.robots[bi]
	if brb and brb.dead then brb = nil end
	if brb and not self.signal then self.signal = require("battle.signal").new(self.mondo) end
	if self.signal then self.signal:display(brb and brb.x, brb and brb.y, game.ROBOT_H, game.ROBOT_HALF_W, self.clock) end
	CP.mission_line(self, r)
	score.obiettivo(self.punti, missions.obiettivo(r))
	-- once the controls are touched, IL TUO TURNO fades
	-- (even if now time waits for a precise command: the light says which)
	if self.banner_wait and (not r.attesa or r.awaiting) then
		self.banner_wait = false
		gui.animate(self.announcement, "color.w", 0, gui.EASING_INCUBIC, 0.4)
	end
	if self.missione_attesa then
		self.missione_attesa = self.missione_attesa - dt
		if self.missione_attesa <= 0 then start_mission(self, r.l.id) end
		return
	end
	if r.esito == "fatta" and not r.was_saved then
		r.was_saved = true
		local record = missions.quante(self.profilo.stelle[r.l.id] or {})
		profile.missione(self.profilo, r.l.id, missions.stelle(r))
		profile.salva(self.profilo)
		if not r.l.guidata then
			-- a moment to see the shot, then (or at the first tap) the stars
			show_message(self, TM.mission_done, true)
			self.mode = "ended"
			set_controls_visible(self, false)
			self.end_t, self.record_end = PODIUM_WAIT, record
		end
	elseif r.esito == "fallita" then
		profile.fallita(self.profilo, r.l.id)
		profile.salva(self.profilo)
		show_message(self, TM.mission_retry)
		self.missione_attesa = 1.5
	end
end

-- The end-of-level screen (menu/level_end.lua) of the mission just done
local function open_level_end(self)
	local r = self.missione
	self.end_t, self.missione = nil, nil
	self.missione_finita = r.l.id
	-- battles (really finished) go into the stats, lessons don't
	if self.g.phase == "over" then CP.registra(self, self.g:results()) else self.conta = nil end
	show_message(self, "", true)
	score.obiettivo(self.punti, nil)
	self.vign:quiet()
	open_screen(self, menu.level_end, {
		titolo = r.l.titolo, stelle = missions.stelle(r), criteria = missions.criteria(r.l),
		-- the lead points, where they count
		vantaggio = missions.vantaggio(r),
		record = self.record_end, avanti = missions.dopo(r.l.id) ~= nil,
	}, function(v) sound.play("#punto", { speed = v }) end)
end

-- RIPROVA, AVANTI (the next mission; after the last one, the campaign) or the arrow (the campaign)
local function after_level_end(self, end_of)
	local id = self.missione_finita
	local after_step = end_of == "riprova" and id or (end_of == "avanti" and missions.dopo(id))
	-- leaving the finished battle: the iris, toward the new mission or the campaign
	CP.iris(self, function()
		close_screen(self)
		if after_step then
			start_mission(self, after_step)
		else
			open_campaign(self)
		end
	end)
end

-- Only in the scenarios: [megablast] ricetta = JSON file of a recipe
-- (sim/replay.lua, from the bot arena), replayed from the start up to tick
-- ricetta_da without drawing it, then watched (the highlight videos). The
-- fingerprints up to there must match, otherwise it is an error.
local function start_recipe(self, path, from_pt)
	local f = assert(io.open(path, "r"), "ricetta non trovata: " .. path)
	local r = json.decode(f:read("*a"))
	f:close()
	hide_menu(self)
	new_match(self, r.seme, r.mappa, r.opzioni)
	while self.g.tick < from_pt and self.g.phase ~= "over" do
		self.g:step(replay.input(self.ricetta, self.g, self.bots))
		replay.dopo(self.ricetta, self.g)
		CR.remember(self, self.g:pop_events())
	end
	for i, h in ipairs(self.ricetta.impronte) do
		local waiting = r.impronte[i]
		if not waiting or waiting.t ~= h.t or waiting.h ~= h.h then
			error("ricetta diversa al tick " .. h.t)
		end
	end
	print("SIMULA ricetta valida fino al tick " .. self.g.tick)
	draw_terrain(self)
	reset_pose(self)
	local rb = self.g.robots[self.g.current]
	camera.salta(self.cam, rb.x, rb.y + game.DISEGNO_H / 2, camera.zoom(self.cam))
	self.mode = "local"
	set_controls_visible(self, true)
end

-- The end of init: on top of everything the waiting flame, the transitions'
-- veil and the entry, which stays until the events arrive (CP.entra). In the
-- scenarios you can start from a recipe or from a mission
function CP.startup(self)
	self.attesa = menu.attesa.new()
	self.passaggio = menu.passaggio.new()
	self.ingresso = menu.ingresso.new()
	if SIMULATE then
		CP.ENTRY.min = 0
		CP.ENTRY.max = tonumber(config_string("megablast.prova_ingresso", "0")) or 0
	end
	CP.entra(self)
	local recipe = SIMULATE and config_string("megablast.ricetta", "") or ""
	if recipe ~= "" then
		CP.close_entry(self, true)
		start_recipe(self, recipe, config_int("megablast.ricetta_da", 0))
	end
	-- prova_missione ID: start from that campaign mission (scenari/girone.txt)
	local mission = SIMULATE and config_string("megablast.prova_missione", "") or ""
	if mission ~= "" then
		CP.close_entry(self, true)
		self.ritorno = "campagna"
		start_mission(self, mission)
	end
end


-- Rendering -------------------------------------------------------------------

local function current_robot(self)
	return self.g.robots[self.g.current]
end

-- snap: the aim jumps to the finger at once (when it touches down). Otherwise
-- with game.AIM_SMOOTH < 1 the aim chases it (smooth_aim).
-- (x, y) are on screen: the direction is taken in the world, the distance
-- (and so the power) stays in screen pixels, the same at every zoom.
local function aim_from(self, x, y, snap)
	-- a mouse still held after the match was let go (show_menu)
	if not self.g then return end
	local rb = current_robot(self)
	self.aim_left, self.aim_sy = x, y
	local wx, wy = camera.to_world(self.cam, x, y)
	local dx, dy = wx - rb.x, wy - (rb.y + game.DISEGNO_H / 2)
	self.aim_target = math.atan2(dy, dx)
	if snap or game.AIM_SMOOTH >= 1 or not self.aim_angle then self.aim_angle = self.aim_target end
	self.aim_dist = math.sqrt(dx * dx + dy * dy) * self.cam.s
	self.aim_power = game.aim_power(self.aim_dist / AIM_RANGE)
end

local function smooth_aim(self, dt)
	if not (self.aiming and self.aim_target) or game.AIM_SMOOTH >= 1 then return end
	local d = (self.aim_target - self.aim_angle + math.pi) % (2 * math.pi) - math.pi
	self.aim_angle = self.aim_angle + d * (1 - (1 - game.AIM_SMOOTH) ^ (dt * 60))
end

-- Movement controls: keyboard, stick or controller
local function move_left(self)
	return self.keys.left or (self.move_st.moving and self.move_st.dir < 0) or self.pad_walk < 0
end
local function move_right(self)
	return self.keys.right or (self.move_st.moving and self.move_st.dir > 0) or self.pad_walk > 0
end
local function jump_held(self)
	return self.keys.jump or self.move_st.jumping or self.pad_jump
end

-- Sticks -----------------------------------------------------------------------

local PAD_POS = vmath.vector3(0, 0, 0)

-- Stick as in the proposals: a faintly veiled disc with a border and a
-- matching knob; both borders take the state's color (pad_color).
-- jump: on the border the ticks of the arc where the stick jumps (from
-- levette.JUMP_START_ANGLE above the horizontal, on both sides), longer at the
-- two ends; they light up while jumping
local function new_pad(rest, ring_color, jump_name)
	local pad = { rest = rest }
	pad.base = fit(ui.disco(rest.x, rest.y, PAD_D, PAD_BOTTOM[1]))
	pad.ring = fit(ui.ring_node(0, 0, PAD_D, 3, ring_color, pad.base))
	if jump_name then
		pad.ticks, pad.tick_off, pad.tick_on = {}, vmath.vector4(1, 1, 1, 0.4), vmath.vector4(1, 0.85, 0.55, 1)
		local a0, n = math.deg(sticks.JUMP_START_ANGLE), 9
		for i = 0, n - 1 do
			local a = a0 + (180 - 2 * a0) * i / (n - 1)
			local long = (i == 0 or i == n - 1) and 16 or 9
			local r = PAD_D / 2 - 4 - long / 2
			local t = fit(gui.new_box_node(vmath.vector3(r * math.cos(math.rad(a)), r * math.sin(math.rad(a)), 0),
				vmath.vector3(long, (i == 0 or i == n - 1) and 3 or 2, 0)))
			gui.set_euler(t, vmath.vector3(0, 0, a))
			gui.set_color(t, pad.tick_off)
			gui.set_parent(t, pad.base)
			pad.ticks[#pad.ticks + 1] = t
		end
	end
	pad.knob = fit(ui.disco(0, 0, KNOB_D, PAD_BOTTOM[2], pad.base))
	pad.knob_ring = fit(ui.ring_node(0, 0, KNOB_D, 3, ring_color, pad.knob))
	return pad
end

-- jump: the jump ticks lit (only the movement stick has them)
local function pad_color(pad, c, jump_name)
	gui.set_color(pad.ring, c)
	gui.set_color(pad.knob_ring, c)
	if pad.ticks and pad.salto ~= (jump_name or false) then
		pad.salto = jump_name or false
		for _, t in ipairs(pad.ticks) do gui.set_color(t, jump_name and pad.tick_on or pad.tick_off) end
	end
end

-- The thumb touches down at (x, y): the base goes there, without leaving the screen
local function pad_press(pad, id, x, y)
	pad.id, pad.x0, pad.y0 = id, x, y
	local h = PAD_D / 2
	PAD_POS.x = math.max(screen.x0 + h, math.min(screen.x1 - h, x))
	PAD_POS.y = math.max(screen.y0 + h, math.min(screen.y1 - h, y))
	pad.bx, pad.by = PAD_POS.x, PAD_POS.y
	gui.set_position(pad.base, PAD_POS)
end

-- The thumb is at (x, y): returns the offset from where it touched down, in
-- fractions of the travel (length at most 1)
local function pad_drag(pad, x, y)
	local dx, dy = (x - pad.x0) / PAD_R, (y - pad.y0) / PAD_R
	local mag = math.sqrt(dx * dx + dy * dy)
	if mag > 1 then dx, dy = dx / mag, dy / mag end
	PAD_POS.x = pad.x0 - pad.bx + dx * PAD_R
	PAD_POS.y = pad.y0 - pad.by + dy * PAD_R
	gui.set_position(pad.knob, PAD_POS)
	return dx, dy
end

local function pad_release(pad, ring_color)
	pad.id = nil
	PAD_POS.x, PAD_POS.y = pad.rest.x, pad.rest.y
	gui.set_position(pad.base, PAD_POS)
	PAD_POS.x, PAD_POS.y = 0, 0
	gui.set_position(pad.knob, PAD_POS)
	pad_color(pad, ring_color)
end

-- Micro-vibration: client/vibra on Android phones, in the browser where
-- navigator.vibrate exists
local function vibrate_touch()
	if vibra then
		vibra.tocco()
	elseif html5 then
		html5.run("navigator.vibrate && navigator.vibrate(12)")
	elseif SIMULATE then
		print("SIMULA evento vibra")
	end
end

CP.vibrate = vibrate_touch -- for the blocks above it (the zoom)

local function move_pad_drag(self, x, y)
	local nx, ny = pad_drag(self.move_pad, x, y)
	if math.abs(nx) > 0.3 then missions.tocca(self.missione, "cammina") end
	if sticks.muovi(self.move_st, nx, ny) then
		self.jump_pressed = true
		missions.tocca(self.missione, "salta")
		-- the thumb just entered the jump arc: a micro-vibration
		vibrate_touch()
	end
	local on = self.move_st.moving or self.move_st.jumping
	pad_color(self.move_pad, on and MOVE_LIVE or MOVE_IDLE, self.move_st.jumping)
end

local function aim_pad_drag(self, x, y)
	local st = self.aim_st
	local was = st.active
	sticks.mira(st, pad_drag(self.aim_pad, x, y))
	self.aim_target = st.angle
	-- as soon as it lights up the aim jumps onto the stick, then chases it
	if (st.active and not was) or game.AIM_SMOOTH >= 1 or not self.aim_angle then self.aim_angle = st.angle end
	self.aim_power = math.max(0.1, st.f ^ game.AIM_EXPONENT)
	self.aim_dist = math.huge
	self.aiming = st.active
	pad_color(self.aim_pad, st.active and AIM_LIVE or AIM_IDLE)
	-- the thumb left the dead zone: from here releasing fires the shot
	-- (the ring turns red and the phone makes a micro-vibration)
	if st.active and not was then vibrate_touch() end
end

-- The thumb lifts off the aim stick: the shot fires if the stick was lit a
-- moment earlier (levette.RELEASE), with the aim from then
local function aim_pad_release(self)
	local st = self.aim_st
	local h = sticks.on_release(st, self.clock)
	if (h and h.active or st.active) and self.g:can_use(self.tele_armed and "teleport" or self.weapon) and my_turn(self) then
		local a, p = sticks.shot(st, self.clock, self.aim_angle, self.aim_power)
		self.fire = { angle = a, power = p, weapon = self.tele_armed and "teleport" or self.weapon }
		self.tele_armed = false
	end
	sticks.reset(st)
	self.aiming = false
	pad_release(self.aim_pad, AIM_IDLE)
end

local function move_pad_release(self)
	sticks.reset(self.move_st)
	pad_release(self.move_pad, MOVE_IDLE)
end

-- Sticks on (phone) or off (computer)
local function set_touch_ui(self, on)
	if self.touch_ui == on then return end
	if self.move_pad.id then move_pad_release(self) end
	if self.aim_pad.id then
		sticks.reset(self.aim_st)
		self.aiming = false
		pad_release(self.aim_pad, AIM_IDLE)
	end
	self.touch_ui = on
	gui.set_position(self.btn_tele.nodo, on and TELE_BTN_TOUCH or TELE_BTN_DESK)
	self.tele_state = nil
	gui.set_enabled(self.tele_key, not on)
	if self.controls_visible ~= nil then set_controls_visible(self, self.controls_visible) end
end

-- Weapon bar -------------------------------------------------------------------

-- Is the slot visible? The parachute while some are left or it is already
-- open; the Grapple always; the picked secondary even without shots (off: the
-- Blade gives them back). In the lessons only what the lesson uses (r: the
-- mission, sim/missions.lua vedi).
local function slot_have(rb, w, r)
	if not missions.vede(r, w) then return false end
	if w == "parachute" then
		return rb.parachute or rb.parachutes_left > 0
	elseif w == "hook" or (w == rb.secondary and not rb.disarmed) then
		return true
	end
	return game.has_weapon(rb, w)
end

local function update_bar(self)
	local rb = bar_robot(self)
	if not rb then return end
	local g = self.g
	local l = self.missione
	-- shots used up (or the turn's Grapple fired) it goes back to the Rune launcher
	if not slot_have(rb, self.weapon, l) or (self.weapon == "hook" and g.used.tool and rb.id == g.current) then
		self.weapon = "missile"
		-- a lesson without the Rune launcher: the first visible weapon
		if not slot_have(rb, "missile", l) then
			for _, sl in ipairs(self.slots) do
				if sl.group <= 2 and slot_have(rb, sl.weapon, l) then
					self.weapon = sl.weapon
					break
				end
			end
		end
	end
	-- after the first attack it switches by itself to the other one (weapon or sword)
	if g.window > 0 and rb.id == g.current and not g:can_use(self.weapon) then
		local other = game.SECONDARY[self.weapon] and "missile" or "sword"
		if g:can_use(other) and slot_have(rb, other, l) then self.weapon = other end
	end
	local turn = rb.id == g.current and g.phase == "aim"
	local tel = self.touch_ui
	-- on the phone with five primaries that side narrows
	local n1 = 0
	for _, sl in ipairs(self.slots) do
		if sl.group == 1 and slot_have(rb, sl.weapon, l) then n1 = n1 + 1 end
	end
	local s2 = tel and SIZES.slot_tel or SLOT
	local s1 = (tel and n1 >= 5) and SIZES.narrow_slot or s2
	local gap = tel and SIZES.gap_tel or SLOT_GAP
	-- from the center to the first slot, the same right and left of the ring
	local from_pt = hud.OUTSIDE + SIZES.from_ring
	local tele = tel and TELE_BTN_TOUCH or TELE_BTN_DESK
	local bar_y = BAR_Y + screen.y0
	local how_many_m, chosen, ogg_top = { 0, 0, 0, 0 }, nil, nil
	for _, sl in ipairs(self.slots) do
		local have = slot_have(rb, sl.weapon, l)
		if sl.have ~= have then
			gui.set_enabled(sl.node, have)
			sl.have = have
		end
		if have then
			local gr = sl.group
			local k = how_many_m[gr]
			how_many_m[gr] = k + 1
			local x, y, d = W / 2, bar_y, s2
			if gr == 1 then
				d = s1
				x = W / 2 - from_pt - d / 2 - k * (d + gap)
			elseif gr == 2 then
				x = W / 2 + from_pt + d / 2 + k * (d + gap)
			elseif gr == 3 then
				-- the items column above the teleport
				d = SIZES.oggetto
				x, y = tele.x, tele.y + TELE_BTN_D / 2 + 22 + d / 2 + k * (d + 12)
				ogg_top = y + d / 2
			else
				d = TELE_BTN_D
				x, y = tele.x - TELE_BTN_D - 12, tele.y
			end
			local count = sl.weapon == "parachute" and rb.parachutes_left or rb.ammo[sl.weapon] or 0
			if sl.count ~= count then
				if sl.tondo then
					hud.round_number(sl.tondo, count > 0 and tostring(count) or "")
				else
					gui.set_text(sl.label, count > 0 and ("x" .. count) or "")
				end
				sl.count = count
			end
			-- 2: in hand (it rises), 1: usable (border in the group's color), 0: already used
			local on = ((sl.weapon == self.weapon and not self.tele_armed) or (sl.weapon == "parachute" and rb.parachute)) and 2
				or ((not turn or g:can_use(sl.weapon)) and 1 or 0)
			-- 3 (4 if it can't be used now): the item lit by the controller (LT)
			if on ~= 2 and gr == 3 and self.pad_on and sl.weapon == self.pad_item then on = on == 0 and 4 or 3 end
			if on == 2 then
				y = y + SIZES.alza
				chosen = sl
			end
			sl.d = d
			if sl.x ~= x or sl.y ~= y then
				set_pos(sl.node, x, y)
				sl.x, sl.y = x, y
			end
			local sc = (gr <= 2 and d / SLOT or 1) * (on >= 2 and CHOSEN or 1)
			if sl.on ~= on or sl.sc ~= sc then
				gui.set_color(sl.bordo, on >= 2 and ui.C.LIGHT or (on == 1 and BAR_COLORS[gr] or SLOT_BORDER[0]))
				if sl.icon then gui.set_color(sl.icon, (on == 0 or on == 4) and ICON_USED or WHITE) end
				SLOT_SCALE.x, SLOT_SCALE.y = sc, sc
				gui.set_scale(sl.node, SLOT_SCALE)
				sl.on, sl.sc = on, sc
			end
		end
	end
	-- the column's title, above the last item
	if ogg_top then set_pos(self.items_title, tele.x, ogg_top + 16) end
	if self.items_on ~= (ogg_top ~= nil) then
		self.items_on = ogg_top ~= nil
		gui.set_enabled(self.items_title, self.items_on)
	end
	return chosen
end

-- A secondary shot coming back (the Blade hit an enemy, Sergio 3 Nov:
-- «un bel feedback»): the weapon icon flies from the devil to its button,
-- which swells with a golden flash, and the phone vibrates lightly
CP.RECHARGE = { FLY = 0.45, D = 44, SWELL = 1.35, SETTLE = 0.4, FLASH = 0.6 }

function CP.recharge_create(self)
	-- the icon flies inside a golden glow, so it shows even when it is dark
	local n = glow(0, 0, CP.RECHARGE.D * 1.9, hud.YELLOW)
	gui.set_parent(n, self.bar)
	gui.set_enabled(n, false)
	local icon_img = fit(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(CP.RECHARGE.D, CP.RECHARGE.D, 0)))
	gui.set_texture(icon_img, "armi")
	gui.set_parent(icon_img, n)
	self.recharge, self.recharge_icon = n, icon_img
	self.recharge_flash = glow(0, 0, SLOT * 1.8, hud.YELLOW)
	gui.set_parent(self.recharge_flash, self.bar)
	gui.set_enabled(self.recharge_flash, false)
end

function CP.recharge(self, e)
	local rb = bar_robot(self)
	if not rb or rb.id ~= e.robot or not self.controls_visible then return end
	local sl
	for _, s in ipairs(self.slots) do
		if s.weapon == e.weapon and s.have then sl = s end
	end
	local v = self.view[e.robot]
	if not sl or not sl.x or not v then return end
	local R = CP.RECHARGE
	local n = self.recharge
	local x, y = camera.to_screen(self.cam, v.x, v.y + game.DISEGNO_H / 2)
	gui.cancel_animations(n)
	gui.play_flipbook(self.recharge_icon, WEAPON_ICON[e.weapon])
	gui.set_position(n, vmath.vector3(x, y, 0))
	gui.set_scale(n, vmath.vector3(1.4, 1.4, 1))
	gui.set_enabled(n, true)
	gui.animate(n, "scale", vmath.vector3(0.8, 0.8, 1), gui.EASING_INQUAD, R.FLY)
	gui.animate(n, "position", vmath.vector3(sl.x, sl.y, 0), gui.EASING_INQUAD, R.FLY, 0, function()
		gui.set_enabled(n, false)
		-- arrived: the button swells and settles back, with a golden flash
		local k = (sl.sc or 1)
		gui.cancel_animations(sl.node, "scale")
		gui.set_scale(sl.node, vmath.vector3(k * R.SWELL, k * R.SWELL, 1))
		gui.animate(sl.node, "scale", vmath.vector3(k, k, 1), gui.EASING_OUTBACK, R.SETTLE, 0, function()
			sl.sc = nil   -- update_bar sets it right again, if it changed meanwhile
		end)
		local l = self.recharge_flash
		gui.cancel_animations(l)
		gui.set_position(l, vmath.vector3(sl.x, sl.y, 0))
		gui.set_color(l, hud.YELLOW)
		gui.set_scale(l, vmath.vector3(0.6, 0.6, 1))
		gui.set_enabled(l, true)
		gui.animate(l, "scale", vmath.vector3(1.3, 1.3, 1), gui.EASING_OUTQUAD, R.FLASH)
		gui.animate(l, "color.w", 0, gui.EASING_INQUAD, R.FLASH, 0, function() gui.set_enabled(l, false) end)
		vibrate_touch()
	end)
end

-- The camera moves and scales the "mondo" node (all the battle's nodes) and
-- the render view, where the terrain mesh is drawn. Labels and arrow grow
-- less than the world, so up close they don't become huge.
local CAM_POS, CAM_SCALE, LABEL_SCALE = vmath.vector3(0, 0, 0), vmath.vector3(1, 1, 1), vmath.vector3(1, 1, 1)
local function apply_camera(self)
	local c = self.cam
	if self.zoom_point then ZM.display(self) end
	local tx, ty = camera.spostamento(c)
	tx, ty = tx + self.sc_ox, ty + self.sc_oy
	if tx == self.cam_tx and ty == self.cam_ty and c.s == self.cam_s then return end
	self.cam_tx, self.cam_ty, self.cam_s = tx, ty, c.s
	CAM_POS.x, CAM_POS.y = tx, ty
	gui.set_position(self.mondo, CAM_POS)
	CAM_SCALE.x, CAM_SCALE.y = c.s, c.s
	gui.set_scale(self.mondo, CAM_SCALE)
	-- the render stretches 1280 x 720 over the whole screen: the view compensates,
	-- so the terrain has the same proportions as the nodes (ui/screen.lua)
	local view, kx, ky = self.cam_msg.view, screen.kx, screen.ky
	view.m00, view.m11 = c.s / kx, c.s / ky
	view.m03, view.m13 = W / 2 + (tx - W / 2) / kx, H / 2 + (ty - H / 2) / ky
	msg.post("@render:", "set_view_projection", self.cam_msg)
	local l = c.s ^ -0.65
	LABEL_SCALE.x, LABEL_SCALE.y = 0.7 * FONT_K * l, 0.7 * FONT_K * l
	gui.set_scale(self.cancel_label, LABEL_SCALE)
end

local function render(self, dt)
	self.clock = self.clock + dt
	local g = self.g
	-- no match (home, screens, connecting): nothing to move
	if not g then return end
	local k, pa, pb = pose_k(self), self.pose_a, self.pose_b
	for i, rb in ipairs(g.robots) do
		local v, r, ra, rb2 = self.view[i], self.robots[i], pa.r[i], pb.r[i]
		v.x = ra.x + (rb2.x - ra.x) * k
		-- on the ground the robot climbs and descends the terrain's steps in 2-pixel
		-- jumps: we smooth them only in the drawing, the real position doesn't change
		local ty = ra.y + (rb2.y - ra.y) * k
		local dy = ty - v.y
		if rb2.g and math.abs(dy) <= game.MAX_CLIMB + 2 then
			v.y = v.y + dy * math.min(1, dt * 25)
		else
			v.y = ty
		end
		local hp = math.max(0, rb.hp)
		if v.hp ~= hp or v.scudo ~= rb.shield then
			if hp < v.hp then
				-- the hit: flash and push on the target, shake and hit-stop
				local damage = v.hp - hp
				local cx, cy = shot_from(self, i)
				local dx, dy = v.x - cx, v.y + game.DISEGNO_H / 2 - cy
				scoria.hit(r.rig, dx)
				camera.shake(self.cam, dx, dy, SHAKE_BASE + damage * SHAKE_DAMAGE)
				self.fermo = math.max(self.fermo, IDLE_MIN + (IDLE_MAX - IDLE_MIN) * math.min(1, damage / 50))
			end
			v.hp, v.scudo = hp, rb.shield
			plate.vita(r.plate, hp, rb.max_hp, rb.shield)
		end
		-- the plate above the horns; online the name is known only after the start
		local nome = who_name(self, i)
		if v.nome ~= nome then
			plate.nome(r.plate, nome)
			v.nome = nome
		end
		-- the effects on it with the turns left (numeric code so the string isn't
		-- rebuilt every frame)
		local code = 0
		for k, sn in ipairs(STATUS_NAME) do
			local s = rb.status[sn[1]]
			code = code + (s and s.turns or 0) * 10 ^ (k - 1)
		end
		if v.stato ~= code then
			local txt = ""
			for _, sn in ipairs(STATUS_NAME) do
				local s = rb.status[sn[1]]
				if s then txt = txt .. (txt == "" and "" or "  ") .. sn[2] .. " " .. s.turns end
			end
			plate.stato(r.plate, txt)
			v.stato = code
		end
		-- the iron arrow above whoever's turn it is, while the match goes on
		-- (before targa.update, which puts it in place)
		if i == g.current then
			local above = not rb.dead and not rb.gone and g.phase ~= "over" and gui.is_enabled(r.plate.bars)
			plate.arrow_up(self.arrow, above and r.plate or nil)
		end
		-- above the horns: 3 in the world and 4 screen pixels
		plate.update(r.plate, dt, v.x, v.y + scoria.cima(r.rig) + CP.PLATE_GAP / self.cam.s, plate.scala(self.cam))
		local vx = v.px and (v.x - v.px) / math.max(dt, 1e-4) or 0
		v.px = v.x

		-- whoever aims turns toward the finger and points the arm with the weapon
		local aiming = self.aiming and g.phase == "aim" and i == g.current and my_turn(self)
		local st = r.st
		-- only whoever moves by themselves runs: only whoever's turn it is has the
		-- controls, and not when knocked away or pulled by the Grapple. Whoever is
		-- pushed stays idle
		local by_itself = i == g.current and not rb.knocked and not rb.hooked
		st.x, st.y, st.grounded, st.moving = v.x, v.y, rb2.g, by_itself and vx or 0
		st.facing = rb.facing
		st.turno = i == g.current
		st.paracadute = rb.parachute and not rb.dead
		st.aim = nil
		if aiming then
			st.aim = self.aim_angle
			st.facing = math.cos(self.aim_angle) < 0 and -1 or 1
		end

		-- in hand the equipped weapon: the one picked by whoever's turn it is (online
		-- we know only ours), the Rune launcher for the others
		local weapon = "missile"
		if i == g.current and my_turn(self) then
			weapon = self.tele_armed and "teleport" or self.weapon
		end
		-- aiming with the Blade or the Fist the weapon points where you aim: the hit starts there
		-- Titan's Fist: the arm follows the uppercut, rotated on the aim
		if rb.punch ~= nil and not rb.dead then
			weapon = "punch"
			local span = self.mode == "online" and game.SNAPSHOT_TICKS or 1
			local t = math.max(0, rb.punch - span + k * span)
			local a = game.punch_angle(t, rb.punch_base)
			local dir = rb.punch_dir or rb.facing
			st.aim = dir > 0 and a or math.pi - a
			st.facing = dir
		end
		-- Mallet: aiming it sits where the arc starts (high behind the head, turned
		-- with the aim); in the hit it turns around the shoulder like the Blade and
		-- stops where it struck
		if aiming and weapon == "mallet" then
			local base, dir = game.aim_side(self.aim_angle)
			local a = base + gconfig.MALLET.from
			st.aim = dir > 0 and a or math.pi - a
		end
		if rb.mallet ~= nil and not rb.dead then
			weapon = "mallet"
			local span = self.mode == "online" and game.SNAPSHOT_TICKS or 1
			local a = game.mallet_angle(math.max(0, rb.mallet - span + k * span), rb.mallet_base, rb.mallet_stop)
			local dir = rb.mallet_dir or rb.facing
			st.aim = dir > 0 and a or math.pi - a
			st.facing = dir
		end
		-- Lunge: the spear points in the dash direction
		if rb.lunge ~= nil and not rb.dead then
			weapon = "lunge"
			if rb.lunge_vx then
				st.aim = math.atan2(rb.lunge_vy, rb.lunge_vx)
				st.facing = rb.lunge_vx < 0 and -1 or 1
			end
		end
		-- Core Blade: during the slash the arm follows the blade's angle
		if rb.swing ~= nil and not rb.dead then
			weapon = "sword"
			-- the slash tick is pose b's: we draw it between a and b
			local span = self.mode == "online" and game.SNAPSHOT_TICKS or 1
			local a = game.sword_angle(math.max(0, rb.swing - span + k * span), rb.swing_base)
			-- the direction is the starting one: turning doesn't change the slash
			local dir = rb.swing_dir or rb.facing
			st.aim = dir > 0 and a or math.pi - a
			st.facing = dir
		end
		scoria.set_weapon(r.rig, weapon)
		scoria.empty_hands(r.rig, rb.disarmed == true)
		scoria.update(r.rig, dt, st)
	end

	-- the Grapple's rope: while the hook flies it stretches from the hand to it;
	-- hooked it stays taut from the puller's hand to the hanging robot (or from
	-- the hanging one's hand to the terrain point); let go, it fades
	local who = self.rope_who
	local flight = who and g.robots[who].hook_shot
	if flight and not g.robots[who].dead then
		local ra, rb2 = pa.r[who], pb.r[who]
		local tx, ty = rb2.gx or flight.x, rb2.gy or flight.y
		if ra.gs then tx, ty = ra.gx + (tx - ra.gx) * k, ra.gy + (ty - ra.gy) * k end
		local x0, y0 = RM.rope_hand(self, who)
		RM.fune.dritta(self.fune, x0, y0, tx, ty)
	elseif self.rope then
		local rb = g.robots[self.rope]
		if rb.hooked and not rb.dead then
			local x0, y0 = RM.rope_hand(self, rb.hooked.by or self.rope)
			local x1, y1 = rb.hooked.x, rb.hooked.y
			if rb.hooked.by then x1, y1 = self.view[self.rope].x, self.view[self.rope].y + game.DISEGNO_H / 2 end
			RM.fune.dritta(self.fune, x0, y0, x1, y1)
		else
			self.rope = nil
			RM.fune.sfuma(self.fune)
		end
	elseif self.fune.stato == "dritta" then
		-- the hook vanished in flight (the puller died): it fades too
		RM.fune.sfuma(self.fune)
	end
	if not RM.fune.update(self.fune, dt, self.is_solid) and who then
		-- all over: the hook goes back into the barrel
		scoria.uncino(self.robots[who].rig, true)
		self.rope_who = nil
	end

	-- Flame Egg: rolls while flying, with the seconds left to the blast above
	local egg = pb.has_p and g.projectile and g.projectile.kind == "grenade"
	gui.set_enabled(self.egg, egg)
	if egg then
		local p0 = pa.has_p and pa.p or pb.p
		local x = p0.x + (pb.p.x - p0.x) * k
		set_pos(self.egg, x, p0.y + (pb.p.y - p0.y) * k)
		self.focus_x, self.focus_y = x, p0.y + (pb.p.y - p0.y) * k
		EULER.z = -x * 4
		gui.set_euler(self.egg_spin, EULER)
		gui.set_color(self.egg_light, self.colors[g.current])
		local secs = math.max(1, math.ceil((g.projectile.fuse or 0) / 60))
		if self.egg_secs ~= secs then
			gui.set_text(self.egg_label, tostring(secs))
			self.egg_secs = secs
		end
	end

	-- missile: glow in the shooter's color and a trail fading out
	local missile = pb.has_p and not egg
	gui.set_enabled(self.projectile, missile)
	if missile then
		local p0 = pa.has_p and pa.p or pb.p
		local x, y = p0.x + (pb.p.x - p0.x) * k, p0.y + (pb.p.y - p0.y) * k
		set_pos(self.projectile, x, y)
		self.focus_x, self.focus_y = x, y
		gui.set_color(self.projectile_glow, self.colors[g.current])
		gui.set_color(self.razzo_tinta, self.colors[g.current])
		gui.set_color(self.palla_tinta, self.colors[g.current])
		-- rocket and ball point the way they go
		local dx, dy = pb.p.x - p0.x, pb.p.y - p0.y
		if dx * dx + dy * dy > 0.01 then SNIPER_EULER.z = math.deg(math.atan2(dy, dx)) end
		gui.set_euler(self.projectile, SNIPER_EULER)
		local sniper = g.projectile and g.projectile.kind == "sniper"
		gui.set_enabled(self.razzo, not sniper)
		gui.set_enabled(self.palla, sniper)
		if sniper then
			-- sniper: stretched the way it goes; at every bounce it squashes and wobbles
			-- like jelly, then goes back to how it was
			local t = self.clock - (self.boing or -10)
			local w = BOING_AMP * math.exp(-t * BOING_DAMP) * math.cos(t * BOING_FREQ)
			SNIPER_SCALE.x, SNIPER_SCALE.y = VK.x * (1.25 - w), VK.y * (0.85 + w)
			gui.set_scale(self.projectile, SNIPER_SCALE)
			self.sniper_shape = true
		elseif self.sniper_shape then
			gui.set_scale(self.projectile, VK)
			self.sniper_shape = false
		end
		local n = #self.trail
		self.trail_i = self.trail_i % n + 1
		local tp = self.trail_pos[self.trail_i]
		tp.x, tp.y = x, y
		self.trail_n = math.min(n, self.trail_n + 1)
		for j = 1, n do
			local node = self.trail[j]
			if j <= self.trail_n then
				local q = self.trail_pos[(self.trail_i - j) % n + 1]
				gui.set_enabled(node, true)
				set_pos(node, q.x, q.y)
			else
				gui.set_enabled(node, false)
			end
		end
	else
		self.trail_n = 0
		for _, node in ipairs(self.trail) do gui.set_enabled(node, false) end
	end

	if missile or egg then CP.notch(self, self.focus_x, self.focus_y) end

	-- Shard Swarm: small glows in the shooter's color
	local n_shards, shard_x, shard_y = 0, 0, 0
	for i = 1, game.SHARD_COUNT do
		local sb, node = pb.s[i], self.shard_nodes[i]
		gui.set_enabled(node, sb.on)
		if sb.on then
			local sa = pa.s[i].on and pa.s[i] or sb
			local x, y = sa.x + (sb.x - sa.x) * k, sa.y + (sb.y - sa.y) * k
			set_pos(node, x, y)
			-- the shard points the way it goes
			if sb.x ~= sa.x or sb.y ~= sa.y then
				EULER.z = math.deg(math.atan2(sb.y - sa.y, sb.x - sa.x))
				gui.set_euler(node, EULER)
			end
			n_shards, shard_x, shard_y = n_shards + 1, shard_x + x, shard_y + y
		end
	end
	if n_shards > 0 then CP.notch(self, shard_x / n_shards, shard_y / n_shards) end
	if self.shard_color ~= g.current then
		for i = 1, game.SHARD_COUNT do
			gui.set_color(self.shard_nodes[i], self.colors[g.current])
			gui.set_color(self.shard_tints[i], self.colors[g.current])
		end
		self.shard_color = g.current
	end

	items.update(self.oggetti, g, self.view, self.clock)

	-- crates: they fall swaying, lock and teeth pulse
	for _, n in ipairs(self.crate_nodes) do
		if n.id and not pb.c[n.id] then
			n.id = nil
			gui.set_enabled(n.node, false)
		end
	end
	for id, cb in pairs(pb.c) do
		local n
		for _, cn in ipairs(self.crate_nodes) do
			if cn.id == id then n = cn; break end
		end
		if not n then
			for _, cn in ipairs(self.crate_nodes) do
				if not cn.id then n = cn; n.id = id; gui.set_enabled(n.node, true); break end
			end
		end
		if n then
			local ca = pa.c[id] or cb
			set_pos(n.node, ca.x + (cb.x - ca.x) * k, ca.y + (cb.y - ca.y) * k + n.dy)
			EULER.z = cb.landed and 0 or math.sin(self.clock * 3 + id) * 10
			gui.set_euler(n.node, EULER)
			gui.set_enabled(n.chute, not cb.landed)
			n.light_col.w = 0.75 + 0.25 * math.sin(self.clock * 4 + id)
			gui.set_color(n.light, n.light_col)
		end
	end
	EULER.z = 0

	-- teleport orbs, with the core in the color of whoever threw it
	for i, node in ipairs(self.orbs) do
		local on = i <= pb.no
		gui.set_enabled(node.root, on)
		if on then
			local ob = pb.o[i]
			local o0 = find_orb(pa, ob.id) or ob
			local x, y = o0.x + (ob.x - o0.x) * k, o0.y + (ob.y - o0.y) * k
			set_pos(node.root, x, y)
			CP.notch(self, x, y)
			gui.set_color(node.light, self.colors[g.current])
			gui.set_color(node.glow, self.colors[g.current])
		end
	end

	CP.notches_end(self, self.colors[g.current])

	-- buttons: picked weapon and teleport (also with other orbs in flight)
	local tele_ok = g:can_use("teleport") and my_turn(self)
	-- picked on the others' turn it stays in hand; on yours, with orbs used up, no
	if self.tele_armed and not tele_ok and my_turn(self) and g.phase == "aim" then self.tele_armed = false end
	local chosen = update_bar(self)
	local tele_state = self.tele_armed and 2 or (tele_ok and 1 or 0)
	local bt = self.btn_tele
	-- in the lessons that don't talk about orbs the button isn't there
	local tele_sees = self.controls_visible and missions.vede(self.missione, "teleport")
	if self.tele_sees ~= tele_sees then
		gui.set_enabled(bt.nodo, tele_sees)
		self.tele_sees = tele_sees
	end
	if self.tele_state ~= tele_state then
		gui.set_color(bt.bordo, tele_state == 2 and ui.C.LIGHT or (tele_state == 1 and ui.C.PURPLE or SLOT_BORDER[0]))
		gui.set_color(bt.icon_img, tele_state == 0 and ICON_USED or WHITE)
		local sc = tele_state == 2 and CHOSEN or 1
		SLOT_SCALE.x, SLOT_SCALE.y = sc, sc
		gui.set_scale(bt.nodo, SLOT_SCALE)
		local p = self.touch_ui and TELE_BTN_TOUCH or TELE_BTN_DESK
		set_pos(bt.nodo, p.x, p.y + (tele_state == 2 and SIZES.alza or 0))
		self.tele_state = tele_state
	end
	-- what you hold: the tag with the name above and the halo in your color
	local hand, mx, my, md = nil, 0, 0, 0
	if self.tele_armed then
		local p = self.touch_ui and TELE_BTN_TOUCH or TELE_BTN_DESK
		hand, mx, my, md = "teleport", p.x, p.y + SIZES.alza, TELE_BTN_D
	elseif chosen then
		hand, mx, my, md = chosen.weapon, chosen.x, chosen.y, chosen.d
	end
	if hand and self.controls_visible then
		local ky = my + md * CHOSEN / 2 + 22
		hud.tag_up(self.tag, mx, ky, hud.NAMES[hand] or "")
		set_pos(self.chosen_glow, mx, my)
		gui.set_color(self.chosen_glow, self.colors[g.current])
		gui.set_enabled(self.chosen_glow, true)
	else
		hud.tag_away(self.tag)
		gui.set_enabled(self.chosen_glow, false)
	end

	local aim_weapon = self.tele_armed and "teleport" or self.weapon
	-- with the finger on the robot the shot is cancelled: no trajectory, only the label
	local can_aim = g:can_use(aim_weapon) and my_turn(self)
	local cancel = self.aiming and can_aim and self.aim_dist <= CANCEL_R
	gui.set_enabled(self.cancel_label, cancel)
	if cancel then
		local v = self.view[g.current]
		set_pos(self.cancel_label, v.x, v.y - 14)
	end
	-- the aim says only angle and power, the same for all firing weapons: gauge
	-- or reticle and, above the head, degrees and power; close-range ones only a
	-- tip and a ring at the feet of whoever they would hit (battle/aim.lua)
	if self.aiming and can_aim and not cancel and aim_name.MELEE[aim_weapon] then
		local v, s = self.view[g.current], self.cam.s
		local cy = v.y + game.DISEGNO_H / 2
		local a = self.aim_angle
		aim_name.punta(self.mira, v.x + math.cos(a) * game.MUZZLE, cy + math.sin(a) * game.MUZZLE, a, s, self.colors[g.current])
		-- who would be hit, tried on a copy of the match (under a millisecond): again
		-- when the aim turns, at most every 3 frames, and anyway every 10 (the others
		-- move too)
		local b = self.bersagli
		local degrees = math.floor(math.deg(self.aim_angle) + 0.5)
		b.attesa = (b.attesa or 0) - 1
		if b.arma ~= aim_weapon or (b.gradi ~= degrees and b.attesa <= 7) or b.attesa <= 0 then
			b.arma, b.gradi, b.attesa = aim_weapon, degrees, 10
			b.n = bot.hits(g, aim_weapon, self.aim_angle, b.id)
		end
		local n = math.min(b.n, aim_name.RINGS)
		for i = 1, n do
			local p = b.pos[i] or {}
			local vt = self.view[b.id[i]]
			p.x, p.y = vt.x, vt.y
			b.pos[i] = p
		end
		aim_name.bersagli(self.mira, b.pos, n, s, self.colors[g.current])
		aim_name.trajectory_off(self.mira)
	elseif self.aiming and can_aim and not cancel then
		self.bersagli.arma = nil
		aim_name.bersagli(self.mira, nil, 0)
		local v, s = self.view[g.current], self.cam.s
		local cy = v.y + game.DISEGNO_H / 2
		-- gauge or reticle, as the "mira" setting says (from the wheel)
		local bx, by = v.x + math.cos(self.aim_angle) * game.MUZZLE, cy + math.sin(self.aim_angle) * game.MUZZLE
		aim_name[profile.setting(self.profilo, "mira")](self.mira, bx, by, self.aim_angle, s, self.aim_power, self.colors[g.current])
		aim_name.tag(self.mira, bx, by, self.aim_angle, s, aim_name.gradi(self.aim_angle), self.aim_power)
		-- a micro-vibration at every power tick, if on
		local notch = aim_name.VIBRATE_TICKS and aim_name.notch(self.aim_power)
		if notch and self.notch and notch ~= self.notch then vibrate_touch() end
		self.notch = notch
		-- in the Training lessons, as help, the whole trajectory down to the terrain:
		-- the one of the shot that would fire now, so with the aim from a moment
		-- earlier like the release of the sticks (sticks.shot), not the live finger
		if self.missione and self.missione.l.chapter == "addestramento" then
			local n, a, p = HELP_POINTS, self.aim_angle, self.aim_power
			if self.aim_pad.id then
				a, p = sticks.shot(self.aim_st, self.clock, a, p)
			elseif self.pad_aim then
				a, p = sticks.shot(self.pad_st, self.clock - (PAD.imp(self, "potenza") == "grilletto" and PAD.TRIGGER_RELEASE or 0), a, p)
			end
			local pts = g:preview(a, p, n, 4, self.preview_pts, aim_weapon)
			for k = 1, n do
				if g.terrain:solid(pts[k].x, pts[k].y) then n = k break end
			end
			aim_name.trajectory(self.mira, pts, n, s)
		else
			aim_name.trajectory_off(self.mira)
		end
	else
		aim_name.via(self.mira)
		self.notch = nil
		self.bersagli.arma = nil
	end

	-- match time left, above the ring; in the last lap (double points) the label
	-- in its place, and the golden ring
	local left = math.max(0, math.ceil(g.match_left / 60))
	local clock = g.final_round and TM.last_round or string.format("%d:%02d", math.floor(left / 60), left % 60)
	hud.stopwatch_gold(self.chrono, g.final_round and g.phase ~= "over")
	-- the ring tells the turn: white, yellow while the second attack is left, blue after
	local stage, left_ones, total = nil, 0, 1
	if g.phase == "aim" then
		if g.window > 0 then
			stage = (g.used.primary and g.used.secondary) and "riparati" or "secondo"
			left_ones, total = g.window / 60, game.AFTER_ATTACK_TICKS / 60
		else
			stage, left_ones, total = "turno", g.timer / 60, game.TURN_TICKS / 60
		end
	end
	-- the orb ticks only if leftover time gives orbs (not in all lessons)
	self.chrono.ticks_on = g.robots[g.current].stats.time_orbs > 0
	hud.stopwatch_update(self.chrono, dt, stage, left_ones, total, self.colors[g.current], g.phase ~= "over" and clock or "")
	-- swapping the second attack for a teleport: one tap
	-- (after the turn announcement has vanished: they would overlap)
	local swap_sees = self.tele_sees and my_turn(self) and g:can_use("swap")
		and missions.vede(self.missione, "baratto")
		and not self.banner_wait and self.clock >= (self.banner_end or 0)
	hud.swap_update(self.scambio, swap_sees, self.chrono)
	-- while waiting for the second attack the secondaries blink, if they are what's left
	local blink = g.window > 0 and my_turn(self) and math.sin(self.clock * 12) > 0
	for _, sl in ipairs(self.slots) do
		if sl.glow then gui.set_enabled(sl.glow, blink and sl.have and g:can_use(sl.weapon)) end
	end
	score.update(self.punti, dt, g, self.mode == "online" and self.me or g.current)
	local n = bar_robot(self)
	local tele = n and math.max(0, n.teleports_left - self.orbs_wait) or 0
	if self.tele_n ~= tele then
		hud.round_number(self.btn_tele, tostring(tele))
		self.tele_n = tele
	end

	-- Camera: follows whoever's turn it is. When they fire, while they can still
	-- move (the "aim" phase: the second attack and taking cover) it keeps them
	-- and the shot in view, and then them and the explosion for a moment, zooming
	-- out just enough; once the turn is over it just follows the shot. In the menu
	-- the whole map is visible.
	local v = self.view[g.current]
	local c = self.cam
	if self.mode == "menu" then
		camera.mappa(c, dt)
	else
		local rx, ry = v.x, v.y + game.DISEGNO_H / 2
		local fx, fy, fast = nil, nil, false
		self.cam_pause = math.max(0, self.cam_pause - dt)
		if missile or egg then
			fx, fy, fast = self.focus_x, self.focus_y, true
			self.cam_pause = 0
		elseif n_shards > 0 then
			fx, fy, fast = shard_x / n_shards, shard_y / n_shards, true
			self.cam_pause = 0
		elseif self.cam_pause > 0 then
			fx, fy = self.pause_x, self.pause_y
		end
		if not fx then
			camera.follow(c, dt, rx, ry, camera.zoom(c))
		elseif g.phase == "aim" then
			camera.frame_on(c, dt, rx, ry, fx, fy, camera.zoom(c))
		else
			camera.follow(c, dt, fx, fy, camera.zoom(c), fast)
		end
	end
	apply_camera(self)
end

-- Lifecycle -------------------------------------------------------------------

-- Sticks what belongs there to the real screen edges (ui/screen.lua): at
-- startup and when the window changes proportions
local function arrange(self)
	local x0, y0, x1, y1 = screen.x0, screen.y0, screen.x1, screen.y1
	ZOOM_BTN.x, ZOOM_BTN.y = x1 - 70, y1 - 110
	MOVE_PAD.x, MOVE_PAD.y = x0 + 115, y0 + 117
	AIM_PAD.x, AIM_PAD.y = x1 - 115, y0 + 117
	PAD_ZONE.sx, PAD_ZONE.dx, PAD_ZONE.y = x0 + (x1 - x0) * 0.4, x1 - (x1 - x0) * 0.4, y0 + (y1 - y0) * 0.6
	TELE_BTN_TOUCH.x, TELE_BTN_TOUCH.y = x1 - 72, y0 + 257
	TELE_BTN_DESK.x, TELE_BTN_DESK.y = x1 - 100, y0 + 62
	gui.set_position(self.btn_zoom, ZOOM_BTN)
	for _, pad in ipairs({ self.move_pad, self.aim_pad }) do
		if not pad.id then set_pos(pad.base, pad.rest.x, pad.rest.y) end
	end
	gui.set_position(self.btn_tele.nodo, self.touch_ui and TELE_BTN_TOUCH or TELE_BTN_DESK)
	-- teleport and weapon bar are put back in place by the next update
	self.tele_state = nil
	for _, sl in ipairs(self.slots) do sl.x = nil end
	hud.stopwatch_move(self.chrono, W / 2, y0 + SIZES.ring_y)
	score.cima(self.punti, y1)
	camera.viewport(self.cam, x0, y0, x1, y1)
	self.cam_s = nil
	msg.post("/terreno#script", "schermo", { kx = screen.kx, ky = screen.ky })
end

-- The Grapple's rope with the hook (battle/rope.lua) and the Bellows' gust;
-- self.rm_nodes: their nodes, to put in the world (outside init, which already
-- has almost all of the 60 upvalues Lua allows)
function RM.nodi(self)
	self.fune = RM.fune.nuova(K)
	-- the falling rope rests on the match's terrain
	self.is_solid = function(x, y) return self.g ~= nil and self.g.terrain:solid(x, y) end
	self.gusts = {}
	for i = 1, RM.GUSTS do
		self.gusts[i] = box(0, 0, 1, 1, WHITE)
		gui.set_enabled(self.gusts[i], false)
	end
	self.rm_nodes = RM.fune.nodi(self.fune)
	for _, n in ipairs(self.gusts) do self.rm_nodes[#self.rm_nodes + 1] = n end
	-- the controller: buttons and sticks (ui/controller.lua), its aim and its
	-- walking (here and not in init, which already has almost 60 upvalues)
	self.ctrl, self.pad_st, self.pad_move = PAD.reader.new(sys.get_sys_info().system_name), sticks.new(), sticks.new()
	self.pad_walk, self.pad_jump = 0, false
	self.comandi = function() return PAD.comandi(self) end
	PAD.reader.current_value = self.ctrl
	-- in the scenarios the other controllers' graphics are tested too (prova_pad playstation)
	if SIMULATE then self.ctrl.family = config_string("megablast.prova_pad", "xbox") end
end

function init(self)
	-- the last training choice against the bots (menu/training.lua)
	self.against_bot = { modo = "1v1", livello = "normale", mappa = "caso" }
	-- the last campaign chapter opened (menu/campaign.lua)
	self.chosen_campaign = {}
	self.bots = {}
	self.orbs_wait = 0
	msg.post(".", "acquire_input_focus")
	self.keys = {}
	self.preview_pts = {}

	self.clock = 0

	-- everything in the world is a child of this node, which the camera moves and
	-- scales (apply_camera)
	self.cam = camera.new(W, H, game.WORLD_W, game.WORLD_H)
	camera.livello(self.cam, ZOOM_START)
	-- set_view_projection also wants id and projection; the projection stays the
	-- render's (stretch), which this doesn't change
	self.cam_msg = { id = hash("camera"), view = vmath.matrix4(), projection = vmath.matrix4() }
	self.cam_pause = 0
	self.fermo, self.sc_ox, self.sc_oy = 0, 0, 0
	self.mondo = fit(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0)))
	gui.set_visible(self.mondo, false)

	-- prova_pelli elmo_x,corazza_y: everyone wearing those skins (battle/skins.lua),
	-- otherwise everyone's character, until the armory picks them
	local look = {}
	for nome in config_string("megablast.prova_pelli", ""):gmatch("[%w_]+") do look[#look + 1] = nome end
	if #look == 0 then look = scoria.PERSONAGGIO end
	self.robots = {}
	for i = 1, game.MAX_PLAYERS do
		local r = { rig = scoria.new(TEAM_COLORS[i], look), st = {} }
		self.robots[i] = r
	end

	-- the aim: the reticle, the degrees tag, the lessons' help (battle/aim.lua)
	self.mira = aim_name.nuova()
	-- whom the close-range weapon in hand would hit: robot ids and where to draw the ring
	self.bersagli = { id = {}, pos = {}, n = 0 }

	-- missile: trail, halo in the team color and white core
	self.trail, self.trail_pos, self.trail_i, self.trail_n = {}, {}, 0, 0
	for i = 1, 8 do
		self.trail[i] = glow(0, 0, (16 - i * 1.4) * K, vmath.vector4(1, 0.6, 0.3, 0.55 - i * 0.06))
		self.trail_pos[i] = { x = 0, y = 0 }
	end
	self.projectile = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_visible(self.projectile, false)
	gui.set_adjust_mode(self.projectile, gui.ADJUST_FIT)
	self.projectile_glow = glow(0, 0, 34, WHITE)
	gui.set_parent(self.projectile_glow, self.projectile)
	self.razzo, self.razzo_tinta = hit_def("razzo", 1 / K)
	gui.set_parent(self.razzo, self.projectile)
	self.palla, self.palla_tinta = hit_def("palla", 1 / K)
	gui.set_parent(self.palla, self.projectile)
	gui.set_scale(self.projectile, VK)

	-- teleport orb: small and round
	self.orbs = {}
	for i = 1, game.MAX_ORBS do
		local root = fit(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0)))
		gui.set_visible(root, false)
		local orb_glow = glow(0, 0, 30, WHITE)
		gui.set_parent(orb_glow, root)
		local img, light = hit_def("globo", 1 / K)
		gui.set_parent(img, root)
		gui.set_enabled(root, false)
		gui.set_scale(root, VK)
		self.orbs[i] = { root = root, glow = orb_glow, light = light }
	end

	-- Flame Egg in flight
	self.egg = fit(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0)))
	gui.set_visible(self.egg, false)
	gui.set_parent(glow(0, 0, 36, BRACE), self.egg)
	self.egg_spin = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_visible(self.egg_spin, false)
	gui.set_parent(self.egg_spin, self.egg)
	local egg_img
	egg_img, self.egg_light = hit_def("uovo", 1 / K)
	gui.set_parent(egg_img, self.egg_spin)
	self.egg_label = label(0, 26, "3", 0.7 / K)
	gui.set_parent(self.egg_label, self.egg)
	gui.set_enabled(self.egg, false)
	gui.set_scale(self.egg, VK)

	-- the Swarm's shards
	self.shard_nodes, self.shard_tints = {}, {}
	for i = 1, game.SHARD_COUNT do
		local n = glow(0, 0, 22, WHITE)
		local img, tint = hit_def("scheggia", 1 / K)
		gui.set_parent(img, n)
		self.shard_tints[i] = tint
		gui.set_scale(n, VK)
		gui.set_enabled(n, false)
		self.shard_nodes[i] = n
	end

	-- traps, springboards, healing circles and shields (battle/items.lua)
	self.oggetti = items.new(TEAM_COLORS)

	-- crates (at most CRATE_MAX are needed), with a glow above while falling:
	-- Gabriella's chest (strumenti/grafica/cassa.py, 83 x 96 pixels), as tall as
	-- the old crate and as wide as the drawing
	local crate_box = vmath.vector3(22.4 * 83 / 96, 22.4, 0)
	self.crate_nodes = {}
	for i = 1, game.CRATE_MAX do
		local n = fit(gui.new_box_node(vmath.vector3(0, 0, 0), crate_box))
		gui.set_texture(n, "battaglia")
		gui.play_flipbook(n, "cassa")
		local chute = glow(0, 20, 40, vmath.vector4(1, 0.8, 0.5, 0.45))
		gui.set_parent(chute, n)
		local light = gui.new_box_node(vmath.vector3(0, 0, 0), crate_box)
		gui.set_texture(light, "battaglia")
		gui.play_flipbook(light, "cassa_luce")
		gui.set_blend_mode(light, gui.BLEND_ADD)
		gui.set_parent(light, n)
		gui.set_enabled(n, false)
		gui.set_scale(n, VK)
		-- dy: from the center to the feet, which rest on the ground
		self.crate_nodes[i] = { node = n, dy = crate_box.y * K / 2, chute = chute, light = light, light_col = vmath.vector4(BRACE) }
	end

	-- the Fist's shockwave
	self.shock = glow(0, 0, 20, BRACE)
	gui.set_enabled(self.shock, false)
	-- trace of straight shots (Thunderer, Grapple)
	self.tracer = box(0, 0, 1, 1, WHITE)
	gui.set_enabled(self.tracer, false)
	RM.nodi(self)

	-- explosions reused in rotation
	self.booms, self.boom_i = {}, 0
	for i = 1, 10 do
		local anim = fit(gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(100, 100, 0)))
		gui.set_texture(anim, "esplosione")
		gui.play_flipbook(anim, "esplosione")
		gui.set_enabled(anim, false)
		local flash = glow(0, 0, 100, BRACE)
		gui.set_enabled(flash, false)
		self.booms[i] = { anim = anim, flash = flash }
	end

	-- explosion debris, reused in rotation
	self.debris, self.debris_i = {}, 0
	for i = 1, DEBRIS do
		local n = box(0, 0, 1, 1, STONE)
		gui.set_enabled(n, false)
		self.debris[i] = { node = n, x = 0, y = 0, vx = 0, vy = 0, a = 0, va = 0, t = DEBRIS_LIFE, col = vmath.vector4(STONE) }
	end

	local plates = plate.nuove(TEAM_COLORS, TEAM_NAMES)
	for i = 1, game.MAX_PLAYERS do self.robots[i].plate = plates[i] end
	-- the iron arrow above whoever's turn it is (just one)
	self.arrow = plate.arrow()
	self.cancel_label = label(0, 0, TM.cancel, 0.7)
	gui.set_enabled(self.cancel_label, false)

	-- in the world, in drawing order
	local world = {}
	for i = 1, game.MAX_PLAYERS do world[#world + 1] = self.robots[i].rig.root end
	for _, n in ipairs(self.mira.nodi) do world[#world + 1] = n end
	for _, n in ipairs(self.trail) do world[#world + 1] = n end
	world[#world + 1] = self.projectile
	for _, o in ipairs(self.orbs) do world[#world + 1] = o.root end
	world[#world + 1] = self.egg
	for _, n in ipairs(self.shard_nodes) do world[#world + 1] = n end
	for _, c in ipairs(self.crate_nodes) do world[#world + 1] = c.node end
	for _, n in ipairs(items.nodi(self.oggetti)) do world[#world + 1] = n end
	world[#world + 1] = self.shock
	world[#world + 1] = self.tracer
	for _, n in ipairs(self.rm_nodes) do world[#world + 1] = n end
	-- the debris under the explosion: they come out while it fades
	for _, d in ipairs(self.debris) do world[#world + 1] = d.node end
	for _, b in ipairs(self.booms) do
		world[#world + 1] = b.anim
		world[#world + 1] = b.flash
	end
	-- the plates: first all the bars, then the arrow, then all the texts (three
	-- draw calls in all; the names and the announcements pass over the arrow)
	for i = 1, game.MAX_PLAYERS do world[#world + 1] = self.robots[i].plate.bars end
	world[#world + 1] = self.arrow.radice
	for i = 1, game.MAX_PLAYERS do world[#world + 1] = self.robots[i].plate.texts end
	world[#world + 1] = self.mira.sign
	world[#world + 1] = self.cancel_label
	for _, n in ipairs(world) do gui.set_parent(n, self.mondo) end

	-- the ring stopwatch at the bottom center, with the match time above
	self.chrono = hud.stopwatch(W / 2, SIZES.ring_y)
	hud.stopwatch_ticks(self.chrono)
	-- the framing of the shooter and the shot stays above the ring and the match time
	camera.margins(self.cam, 120, 90, SIZES.ring_y + hud.OUTSIDE + 40)
	-- the points at the top center; the ticking is the game object's "punto" sound
	self.punti = score.nuovo(TEAM_COLORS, function(v) sound.play("#punto", { speed = v }) end)
	self.message = label(W / 2, H / 2 + 120, "", 1.6)
	self.announcement = label(W / 2, H / 2 - 150, "", 2.2)
	gui.set_color(self.announcement, vmath.vector4(1, 1, 1, 0))
	-- the wheel at the top left, in every match: next to it it opens RIPROVA (not
	-- online) and ESCI DALLA PARTITA, which close by tapping elsewhere (no windows
	-- over the game). On the same phone the match is paused meanwhile. Below,
	-- MIRA: LANCETTA / MIRINO changes the aim mode (the first setting, in the
	-- profile). The buttons are children of the wheel: the anchor to the edge
	-- widens distances on wide screens, so they stay close
	self.btn_menu = ui.impostazioni({}, "menu")
	-- (in a list, for the controller light)
	self.rotellina = {}
	self.btn_retry = ui.button(self.rotellina, 32 + 12 + 80, 0, 160, 64, common.retry, "riprova", nil, self.btn_menu)
	self.btn_quit = ui.button(self.rotellina, 32 + 12 + 160 + 12 + 130, 0, 260, 64, TM.quit_match, "esci", nil, self.btn_menu)
	self.btn_aim = ui.button(self.rotellina, 32 + 12 + 130, -76, 260, 64, TM.aim, "mira", nil, self.btn_menu)
	self.btn_aim_text = self.rotellina[3].testo
	-- RILEGGI: the big vignettes of this mission again (battle/vignette.lua)
	self.btn_reread = ui.button(self.rotellina, 32 + 12 + 260 + 12 + 90, -76, 180, 64, TM.reread, "rileggi", nil, self.btn_menu)
	gui.set_enabled(self.btn_reread, false)
	-- the strip of the vignettes, above the match and its HUD
	self.vign = CP.vignette.new()
	self.vign_read, self.vign_pages = {}, {}
	-- prova_vignette no: the scenarios that test something else don't stop on them
	self.vign_on = not SIMULATE or config_string("megablast.prova_vignette", "si") ~= "no"
	gui.set_enabled(self.btn_aim, false)
	gui.set_enabled(self.btn_retry, false)
	gui.set_enabled(self.btn_quit, false)
	gui.set_enabled(self.btn_menu, false)

	-- the zoom (ZM): the button you drag, with its guide
	ZM.make_ui(self)
	CP.notch_create(self)

	-- phone sticks
	self.move_pad = new_pad(MOVE_PAD, MOVE_IDLE, true)
	self.aim_pad = new_pad(AIM_PAD, AIM_IDLE)
	self.move_st, self.aim_st = sticks.new(), sticks.new()
	-- weapon bar around the stopwatch and, apart, the teleport
	self.bar = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_visible(self.bar, false)
	fit(self.bar)
	-- the halo in your color behind what you hold
	self.chosen_glow = glow(0, 0, SLOT * 1.7, WHITE)
	gui.set_parent(self.chosen_glow, self.bar)
	self.items_title = label(0, 0, TM.items, 0.55)
	gui.set_color(self.items_title, ui.C.MINT)
	gui.set_parent(self.items_title, self.bar)
	gui.set_enabled(self.items_title, false)
	self.slots = {}
	for i, w in ipairs(BAR_WEAPONS) do
		local gr = bar_group(w)
		local sl = { weapon = w, have = false, group = gr }
		if gr >= 3 then
			-- items and tool: round, with the small number
			sl.tondo = hud.tondo(0, BAR_Y, gr == 3 and SIZES.oggetto or TELE_BTN_D, w, BAR_COLORS[gr], self.bar)
			sl.node, sl.bordo, sl.icon = sl.tondo.nodo, sl.tondo.bordo, sl.tondo.icon_img
		else
			local n, border = ui.pannello(0, BAR_Y, SLOT, SLOT, self.bar)
			fit(n)
			local icon = gui.new_box_node(vmath.vector3(0, 2, 0), vmath.vector3(62, 62, 0))
			gui.set_texture(icon, "armi")
			gui.play_flipbook(icon, WEAPON_ICON[w])
			gui.set_parent(icon, n)
			local count = label(22, -26, "", 0.7)
			gui.set_parent(count, n)
			sl.node, sl.bordo, sl.icon, sl.label = n, border, icon, count
		end
		gui.set_enabled(sl.node, false)
		self.slots[i] = sl
		-- the secondaries blink while waiting for the second attack, if they are what's left
		if game.SECONDARY[w] then
			local gl = glow(0, 0, SLOT * 1.6, hud.YELLOW)
			gui.set_parent(gl, sl.node)
			gui.set_enabled(gl, false)
			sl.glow = gl
		end
	end
	-- teleport: round and purple like the tool, with the teleports left
	self.btn_tele = hud.tondo(TELE_BTN_DESK.x, TELE_BTN_DESK.y, TELE_BTN_D, "teleport", ui.C.PURPLE)
	self.tele_key = label(-28, -30, "T", 0.6)
	gui.set_parent(self.tele_key, self.btn_tele.nodo)
	CP.recharge_create(self)
	self.tag = hud.tag()
	self.avviso = hud.avviso()
	self.scambio = hud.scambio()
	hud.orbs_nodes(self.chrono)
	self.pointers = {}
	set_touch_ui(self, touch_device())
	set_controls_visible(self, false)
	screen.aggiorna()
	arrange(self)

	-- the home last, so it sits above the battle
	self.home = home.new(TEAM_COLORS[1])
	self.pill = menu.pill.new()
	self.profilo = profile.load_up()
	if SIMULATE and config_int("megablast.prova_profilo", 0) > 0 then profile.prova(self.profilo) end
	self.scelta = menu.pick.new(WEAPON_ICON, TM.draft_names, TM.draft_effects, self.comandi)

	-- In real matches the map is picked by the seed (sim/maps.lua). In the test
	-- scenarios it is fixed, so the photos repeat: pavimento, or [megablast] prova_mappa.
	self.mappa = SIMULATE and config_string("megablast.prova_mappa", "pavimento") or nil
	show_menu(self)
	CP.startup(self)
end

function final(self)
	disconnect(self)
end

function update(self, dt)
	frames.inizio()
	if screen.aggiorna() then arrange(self) end
	self.vign:update(dt)
	if self.ingresso then CP.entry_update(self, dt) end
	menu.attesa.update(self.attesa, dt)
	if self.sala then menu.lobby.update(self.sala, dt) end
	CP.queue_update(self, dt)
	if self.wait_release then
		self.wait_release = self.wait_release - dt
		if self.wait_release <= 0 then self.wait_release = nil end
	end
	if self.conn and ws.poll then ws.poll(self) end
	PAD.every_frame(self)
	-- hit-stop: the world stays still, the screen shakes anyway
	local dt_world = dt
	if self.fermo > 0 then
		self.fermo = self.fermo - dt
		dt_world = 0
	end
	self.sc_ox, self.sc_oy = camera.shake_frame(self.cam, dt)
	if self.mode == "local" and not self.menu_open and not self.carta and not (self.queue and self.queue.found) then
		self.acc = math.min(self.acc + dt_world, 0.25)
		while self.acc >= game.DT and self.mode == "local" and not self.carta do
			local input = {
				left = move_left(self),
				right = move_right(self),
				-- holding it down you jump again as soon as you touch the ground
				jump = self.jump_pressed or jump_held(self) or false,
				-- releasing the jump while rising makes the jump short
				hold = jump_held(self) or false,
				fire = self.fire,
			}
			self.jump_pressed = false
			self.fire = nil
			capture(self.pose_a, self.g)
			-- a bot's turn: the keys are its own
			input = replay.input(self.ricetta, self.g, self.bots, input)
			-- the shots of whoever plays here, for the stats
			if self.conta and input.fire and self.g.current == self.conta.me then
				CP.conta.sparo(self.conta, self.g, input.fire.weapon)
			end
			self.g:step(input)
			replay.dopo(self.ricetta, self.g)
			for _, e in ipairs(self.g:pop_events()) do
				handle_event(self, e)
				if self.missione then missions.evento(self.missione, self.g, e, self.bots) end
			end
			if self.conta then CP.conta.tick(self.conta, self.g) end
			if self.missione then missions.tick(self.missione, self.g) end
			self.acc = self.acc - game.DT
			capture(self.pose_b, self.g)
		end
		self.pose_t, self.pose_dt = self.acc, game.DT
		if self.missione then
			mission_update(self, dt)
		end
	elseif self.mode == "online" then
		self.pose_t = self.pose_t + dt_world
		-- we send the server only the changes, and only on our turn
		if my_turn(self) and self.g.phase == "aim" then
			local l = move_left(self) or false
			local r = move_right(self) or false
			local j = jump_held(self) or false
			if l ~= self.sent.l or r ~= self.sent.r or j ~= self.sent.j then
				send(self, { t = "in", l = l, r = r, j = j })
				self.sent.l, self.sent.r, self.sent.j = l, r, j
			end
			-- repeated jump: one each time the robot gets back on the ground
			local grounded = current_robot(self).grounded
			if self.jump_pressed or (jump_held(self) and grounded and not self.jump_sent) then
				send(self, { t = "jump" })
				self.jump_sent = true
			end
			if not grounded then self.jump_sent = false end
			if self.fire then
				send(self, { t = "fire", a = self.fire.angle, p = self.fire.power, w = self.fire.weapon })
				if self.conta then CP.conta.sparo(self.conta, self.g, self.fire.weapon) end
			end
		else
			self.sent.l, self.sent.r, self.sent.j = false, false, false
		end
		self.jump_pressed = false
		self.fire = nil
	elseif self.mode == "replay" then
		-- the replay of a profile match: the recipe instead of the keys
		self.acc = math.min(self.acc + dt_world, 0.25)
		while self.acc >= game.DT and self.mode == "replay" do
			capture(self.pose_a, self.g)
			if not CP.replay_step(self) then
				CP.replay_end(self)
				break
			end
			for _, e in ipairs(self.g:pop_events()) do
				handle_event(self, e)
				if self.mode ~= "replay" then break end
			end
			self.acc = self.acc - game.DT
			capture(self.pose_b, self.g)
		end
		self.pose_t, self.pose_dt = self.acc, game.DT
	end
	-- the tag in a match: on your turn (and outside the match) it closes
	if self.card_g and (self.mode ~= "local" and self.mode ~= "online" or my_turn(self)) then CP.close_card_g(self) end

	-- aiming with a still mouse the camera can move (zoom): the screen point is
	-- the same, the world one isn't
	if self.pointers.mouse == "aim" and self.aim_left then aim_from(self, self.aim_left, self.aim_sy) end
	smooth_aim(self, dt)
	-- to fire with the aim from a moment before the thumb lifts
	if self.aim_pad.id then sticks.registra(self.aim_st, self.clock, self.aim_angle, self.aim_power, self.aiming) end
	render(self, dt_world)
	move_debris(self, dt_world)
	if self.mode == "menu" then
		home.update(self.home, dt)
		-- every minute the events again (one starts, one ends); without network
		-- every 5 seconds, until the server answers
		self.events_t = (self.events_t or 0) + dt
		if self.events_t >= (menu.eventi.without_net and 5 or 60) then
			self.events_t = 0
			menu.eventi.load_up(server_url(), function() home.eventi(self.home, menu.eventi.home_line()) end)
		end
	end
	if self.podium_t then
		self.podium_t = self.podium_t - dt
		if self.podium_t <= 0 then open_podium(self) end
	elseif self.end_t then
		self.end_t = self.end_t - dt
		if self.end_t <= 0 then open_level_end(self) end
	end
	if self.schermata and self.schermata.mod.update then self.schermata.mod.update(self.schermata.obj, dt) end
	if self.mode == "scelta" then
		-- locally the draft's time starts after the lineup
		local players = not CP.update_choice(self, dt) and menu.pick.update(self.scelta, dt)
		-- the match starts under the iris: the painted map loads in a long frame
		-- (docs/prestazioni.md, "I caricamenti sotto il velo")
		if players and self.missione then
			local id = self.missione.l.id
			CP.iris(self, function() start_mission(self, id, players) end)
		elseif players then
			CP.iris(self, function() start_local_match(self, players) end)
		end
	elseif self.mode == "scelta_online" then
		CP.update_choice(self, dt)
		menu.pick.update(self.scelta, dt)
	end

	paint_terrain(self)
	-- coda: the queue outside the room (no, si, trovata, persa), for the scenarios
	local coda = SIMULATE and (not self.queue and "no" or self.queue.found and "trovata" or self.queue.lost and "persa" or "si")
	if SIMULATE and self.g then
		-- sx, sy: the robot's center on screen (where the mouse rests to aim)
		local rb = current_robot(self)
		-- (stretched over 1280 x 720 like taps: simula.py brings it back to real pixels)
		local sx, sy = screen.on_touch(camera.to_screen(self.cam, rb.x, rb.y + game.DISEGNO_H / 2))
		local line = string.format("SIMULA stato modo=%s turno=%d fase=%s x=%d y=%d sx=%d sy=%d zoom=%.2f coda=%s",
			self.mode, self.g.current, self.g.phase, math.floor(rb.x), math.floor(rb.y),
			math.floor(sx + 0.5), math.floor(sy + 0.5), self.cam.s, coda)
		if line ~= self.simulate_line then
			print(line)
			self.simulate_line = line
		end
	elseif SIMULATE and (self.mode ~= self.simulate_mode or coda ~= self.simulate_coda) then
		-- no match (home, screens, connecting): only the mode
		print("SIMULA stato modo=" .. tostring(self.mode) .. " coda=" .. coda)
		self.simulate_line = nil
	end
	self.simulate_mode, self.simulate_coda = self.mode, coda
	CP.fotogrammi(self, dt)
end

-- The frame counter (ui/frames.lua, docs/prestazioni.md): a new screen is
-- a possible cause of stutter; the line at the top center only if it is on in
-- the IMPOSTAZIONI. In the simulator it is always on, in the log.
function CP.fotogrammi(self, dt)
	if self.mode ~= self.fps_mode then
		if self.fps_mode then frames.segna("schermata " .. tostring(self.mode)) end
		self.fps_mode = self.mode
	end
	frames.acceso = profile.setting(self.profilo, "fps") == "acceso"
	if SIMULATE then
		frames.log = true
		self.fps_summary = (self.fps_summary or 0) + dt
		if self.fps_summary >= 5 then
			self.fps_summary = 0
			local r = frames.summary()
			if r then print(r) end
		end
	end
	if frames.acceso then
		if not self.fps_text then
			self.fps_text = fit(ui.testo("", 640, 716, 0.6, ui.C.TEXT))
			gui.set_yanchor(self.fps_text, gui.ANCHOR_TOP)
			gui.set_pivot(self.fps_text, gui.PIVOT_N)
		end
		local riga = frames.testo()
		if riga then gui.set_text(self.fps_text, riga) end
		gui.set_enabled(self.fps_text, true)
		gui.move_above(self.fps_text, nil)
	elseif self.fps_text then
		gui.set_enabled(self.fps_text, false)
	end
	frames.fine()
end

-- A HUD button (a weapon, an item or the teleport) always selects that thing,
-- it never turns it off (Sergio, 30 October). On your turn, if it can't be
-- used now, what you had stays in hand and the button says why
-- (battle/hud.lua rifiuta), with the phone vibrating lightly.
-- Items that aren't thrown are used at once.
local function choose_slot(self, w)
	-- the hidden teleport (lessons that don't talk about orbs) doesn't respond
	if w == "teleport" and not self.tele_sees then return end
	missions.tocca(self.missione, w)
	local g = self.g
	local why = my_turn(self) and g.phase == "aim" and hud.motivo(g, w)
	if why then
		if w == "teleport" then
			local p = self.touch_ui and TELE_BTN_TOUCH or TELE_BTN_DESK
			hud.rifiuta(self.avviso, self.btn_tele.nodo, p.x, p.y, TELE_BTN_D, why)
		else
			for _, sl in ipairs(self.slots) do
				if sl.weapon == w then hud.rifiuta(self.avviso, sl.node, sl.x, sl.y, sl.d, why) end
			end
		end
		vibrate_touch()
	elseif w == "teleport" then
		-- the teleport is taken like a weapon, but has its own button
		self.tele_armed = true
	elseif game.TOOLS[w] and not game.THROWN[w] then
		if my_turn(self) and g:can_use(w) then self.fire = { angle = 0, power = 1, weapon = w } end
	else
		self.weapon = w
		self.tele_armed = false
	end
end

-- The bar weapon under the finger, if any
local function picked_slot(self, x, y)
	for _, sl in ipairs(self.slots) do
		if sl.have and gui.pick_node(sl.node, x, y) then return sl.weapon end
	end
	return nil
end

-- step: +1 farther, -1 closer (the wheel, one notch at a time), nil the
-- tap: from the chosen zoom to the farthest and back
local function change_zoom(self, step)
	if step then camera.passo(self.cam, -step * ZM.STEP) else camera.toggle(self.cam) end
end

-- Cancels the stick's aim: back to rest, and releasing it fires nothing
local function cancel_pad_aim(self)
	self.pointers[self.aim_pad.id] = "cancelled"
	sticks.reset(self.aim_st)
	self.aiming = false
	pad_release(self.aim_pad, AIM_IDLE)
	show_message(self, TM.aim_cancelled)
	missions.tocca(self.missione, "annulla")
end

-- ESCI DALLA PARTITA: online the server knows at once (the seat isn't kept,
-- the others see them leave), then back to where they started from: the
-- campaign, training against the bots or the home
-- RIPROVA: the same mission from scratch, or a new identical match (same
-- bots, same mode); the weapon draft, where there is one, is redone
local function retry_match(self)
	if self.missione then
		start_mission(self, self.missione.l.id)
	elseif self.ritorno == "allenamento" then
		-- the same map, also when it came out A CASO
		local against = self.against_bot
		start_local(self, { modo = against.modo, livello = against.livello, mappa = self.local_map or against.mappa })
	else
		start_local(self, nil)
	end
end

-- ESCI DALLA PARTITA: back to the menu they started from (self.ritorno:
-- "campagna", "allenamento" or "home")
local function quit_match(self)
	local online = self.mode == "online" or self.mode == "scelta_online" or self.mode == "connecting"
	local comeback = online and "home" or self.ritorno
	menu.pick.hide(self.scelta)
	if online then self.queue = nil end
	if online and self.conn then
		-- the server closes the connection, after reading the message (closing it
		-- here at once it might not leave); if it doesn't, we do in a moment
		local conn = self.conn
		send(self, { t = "leave" })
		self.conn, self.tok = nil, nil
		timer.delay(2, false, function() ws.disconnect(conn) end)
	end
	CP.iris(self, function()
		if comeback == "campagna" then
			open_campaign(self)
			return
		end
		show_menu(self, true)
		if comeback == "allenamento" then open_screen(self, menu.training, self.against_bot, profile.total_stars(self.profilo)) end
	end)
end

-- A finger (or the mouse) touches down at (x, y). id tells fingers apart.
-- x, y arrive stretched over 1280 x 720 (as gui.pick_node wants them): for
-- everything else they are brought back to game coordinates (ui/screen.lua)
local function pointer_down(self, id, px, py)
	local x, y = screen.from_touch(px, py)
	-- the replay: a tap goes back to the profile
	if self.mode == "replay" then
		CP.replay_end(self)
		return
	end
	if self.mode == "ended" then
		if self.podium_t then
			open_podium(self)
		elseif self.end_t then
			open_level_end(self)
		else
			CP.iris(self, function() show_menu(self, true) end)
		end
		return
	elseif self.mode == "connecting" then
		-- searching for players: only the gear, with ESCI
		if self.menu_open then
			PAD.rotellina(self, gui.pick_node(self.btn_aim, px, py) and "mira" or gui.pick_node(self.btn_quit, px, py) and "esci" or nil)
		elseif gui.pick_node(self.btn_menu, px, py) then
			open_wheel(self, true)
		else
			local hit = self.sala and menu.lobby.exit_hit(self.sala, px, py)
			if hit == "esci" then
				quit_match(self)
			elseif hit == "menu" then
				CP.queue_to_menu(self)
			end
		end
		return
	elseif self.mode ~= "local" and self.mode ~= "online" then
		return
	end
	-- a new weapon's card: it closes with PROVALA, and the weapon stays in hand
	if self.carta then
		if self.carta:premi(px, py) then PAD.close_card(self) end
		self.pointers[id] = "cancelled"
		return
	end
	-- the wheel: open, a tap on ESCI leaves, elsewhere it just closes it again
	if self.menu_open then
		self.pointers[id] = "cancelled"
		PAD.rotellina(self, gui.pick_node(self.btn_aim, px, py) and "mira" or gui.pick_node(self.btn_quit, px, py) and "esci"
			or self.mode ~= "online" and gui.pick_node(self.btn_retry, px, py) and "riprova"
			or gui.is_enabled(self.btn_reread) and gui.pick_node(self.btn_reread, px, py) and "rileggi" or nil)
		return
	elseif gui.pick_node(self.btn_menu, px, py) then
		open_wheel(self, true)
		self.pointers[id] = "cancelled"
		return
	end
	-- outside your turn, tapping a player shows their tag
	if CP.match_touch(self, x, y) then
		self.pointers[id] = "cancelled"
		return
	end
	-- in the lessons time starts when you touch the controls
	if self.missione then missions.tocca(self.missione) end
	-- on the phone bringing the stick back to zero is awkward: while aiming, a
	-- tap on the right half of the screen cancels the aim (and does nothing
	-- else); the left half stays with the walking hand
	if self.aim_pad.id and self.aiming and x >= W / 2 then
		cancel_pad_aim(self)
		self.pointers[id] = "cancelled"
		return
	end
	if hud.swap_press(self.scambio, px, py) then
		missions.tocca(self.missione, "baratto")
		self.fire = { angle = 0, power = 0, weapon = "swap" }
	elseif gui.pick_node(self.btn_zoom, px, py) then
		self.pointers[id] = "zoom"
		ZM.premi(self, y)
	elseif self.tele_sees and gui.pick_node(self.btn_tele.nodo, px, py) then
		choose_slot(self, "teleport")
	elseif picked_slot(self, px, py) then
		choose_slot(self, picked_slot(self, px, py))
	elseif self.touch_ui then
		if x < PAD_ZONE.sx and y < PAD_ZONE.y and not self.move_pad.id then
			self.pointers[id] = "move"
			pad_press(self.move_pad, id, x, y)
			move_pad_drag(self, x, y)
		elseif x > PAD_ZONE.dx and y < PAD_ZONE.y and not self.aim_pad.id and my_turn(self)
			-- with something to throw (at the start of the first lesson you have no weapons)
			and self.g:can_use(self.tele_armed and "teleport" or self.weapon) then
			self.pointers[id] = "pad_aim"
			missions.tocca(self.missione, "mira")
			pad_press(self.aim_pad, id, x, y)
			aim_pad_drag(self, x, y)
		end
	elseif my_turn(self) and self.g:can_use(self.tele_armed and "teleport" or self.weapon) then
		-- on the computer you aim from the robot with the mouse
		self.pointers[id] = "aim"
		missions.tocca(self.missione, "mira")
		self.aiming = true
		aim_from(self, x, y, true)
	end
end

local function pointer_move(self, id, x, y)
	x, y = screen.from_touch(x, y)
	local m = self.pointers[id]
	if m == "move" then
		move_pad_drag(self, x, y)
	elseif m == "pad_aim" then
		aim_pad_drag(self, x, y)
	elseif m == "aim" then
		aim_from(self, x, y)
	elseif m == "zoom" then
		ZM.trascina(self, y)
	end
end

local function pointer_up(self, id, x, y)
	x, y = screen.from_touch(x, y)
	local m = self.pointers[id]
	self.pointers[id] = nil
	if not self.g and (m == "aim" or m == "pad_aim") then
		-- a finger still down when the match was let go (show_menu): no shot
		sticks.reset(self.aim_st)
		self.aiming = false
		pad_release(self.aim_pad, AIM_IDLE)
	elseif m == "zoom" then
		ZM.release(self)
	elseif m == "move" then
		move_pad_release(self)
	elseif m == "pad_aim" then
		aim_pad_release(self)
	elseif m == "aim" then
		aim_from(self, x, y)
		-- releasing the finger over the robot cancels the shot
		if self.g:can_use(self.tele_armed and "teleport" or self.weapon) and self.aim_dist > CANCEL_R then
			self.fire = { angle = self.aim_angle, power = self.aim_power,
				weapon = self.tele_armed and "teleport" or self.weapon }
			self.tele_armed = false
		elseif self.aim_dist <= CANCEL_R then
			missions.tocca(self.missione, "annulla")
		end
		self.aiming = false
	end
end

-- Controller -------------------------------------------------------------------
-- What the buttons do in battle: the PAD.reader.BATTLE table, or the
-- mapping picked in the IMPOSTAZIONI (saved in the profile, self.ctrl.tasti)
-- (ui/controller.lua, docs/controller.md). The sticks work as on the phone:
-- the left one walks and, pushed up, jumps; the right one aims, and you fire
-- with RT while it is lit (brought back to the center it goes off: no shot).
-- In the menus and in the weapon draft the d-pad moves the light and A
-- confirms (ui.tocco).

-- The controls being played with: for the labels of the lessons and of the cards
function PAD.comandi(self)
	return self.pad_on and "controller" or (self.touch_ui and "telefono" or "computer")
end

-- {salta}, {annulla}, {cammina}, {mira} in the lessons' lines (sim/missions.lua)
PAD.TEXTS = { telefono = TM.gestures.telefono, computer = TM.gestures.computer, controller = {} } -- controller: PAD.texts

-- The labels for the controls in use; with the controller, with its buttons' names
function PAD.texts(self)
	local c = PAD.comandi(self)
	local t = PAD.TEXTS[c]
	if c == "controller" then
		local shoot, hop = PAD.reader.name_of("spara"), PAD.reader.name_of("salta")
		local _, is_moving = PAD.levetta(self, "muove")
		local _, aim_name = PAD.levetta(self, "mira")
		t.mira = (PAD.imp(self, "potenza") == "grilletto" and TM.pad_aim_trigger
			or PAD.imp(self, "sparo") == "rilascio" and TM.pad_aim_release
			or TM.pad_aim_press):format(aim_name, shoot)
		t.salta = hop ~= "" and TM.pad_jump_button:format(hop) or TM.pad_jump_stick:format(is_moving)
		t.cammina = TM.pad_walk:format(is_moving)
		t.annulla = TM.pad_cancel:format(aim_name)
	end
	return t
end

-- A new weapon's card closes with PROVALA (or A), and the weapon stays in hand
-- (the vignettes too sit in self.carta, without a weapon)
function PAD.close_card(self)
	local w = self.carta.arma
	if w and (not game.TOOLS[w] or game.THROWN[w]) then self.weapon = w end
	self.carta:close_view()
	self.carta = nil
end

-- A wheel button (nil: it just closes again). MIRA changes mode and the
-- wheel stays open, so the new one shows
function PAD.rotellina(self, ui_action)
	if ui_action == "mira" then
		profile.imposta(self.profilo, "mira", profile.setting(self.profilo, "mira") == "lancetta" and "mirino" or "lancetta")
		profile.salva(self.profilo)
		open_wheel(self, true)
		return
	end
	open_wheel(self, false)
	if ui_action == "rileggi" then
		self.carta = self.vign:open(self.vign_pages, PAD.comandi(self) == "controller")
	elseif ui_action == "esci" then
		quit_match(self)
	elseif ui_action == "riprova" then
		retry_match(self)
	end
end

-- The sticks at rest (outside your turn, in the menus, after the shot)
function PAD.riposo(self)
	sticks.reset(self.pad_move)
	if self.pad_aim then
		sticks.reset(self.pad_st)
		self.pad_aim, self.aiming = false, false
	end
	self.pad_walk, self.pad_jump, self.pad_charge = 0, false, false
	self.pad_zoom = nil
end

-- A profile setting (sparo, potenza: menu/settings.lua)
-- Which stick moves and which aims (the "levette" setting, Sergio 30 Oct: by
-- default the right one moves and the left one aims); and its name for the labels
function PAD.levetta(self, use)
	PAD.reader.levette = PAD.imp(self, "levette")
	local side_of = PAD.reader.lato(use)
	return self.ctrl[side_of], common.stick_side[side_of]
end

function PAD.imp(self, lookup_key)
	return profile.setting(self.profilo, lookup_key)
end

-- How far the SPARA button is pressed (0..1): triggers by half, the others all or nothing
function PAD.grilletto(self)
	local c = self.ctrl
	local t = PAD.reader.key_of(c, "spara")
	if not t then return 0 end
	return c.valore[t] or (c.giu[t] and 1 or 0)
end

-- Every frame the right stick aims, like the phone's: lit past 20% of the
-- travel, off below 10% (sticks.lua)
function PAD.mira(self)
	local st, l = self.pad_st, PAD.levetta(self, "mira")
	if not (my_turn(self) and self.g.phase == "aim" and self.g:can_use(self.tele_armed and "teleport" or self.weapon)) then
		if self.pad_aim then
			sticks.reset(st)
			self.pad_aim, self.aiming = false, false
		end
		return
	end
	local previous = st.active
	sticks.mira(st, l.x, l.y)
	-- "grilletto" power (settings): the stick gives only the direction, the
	-- power is how far you press the SPARA button, and releasing it fires the shot
	local trigger = PAD.imp(self, "potenza") == "grilletto"
	if st.active then
		if not previous then missions.tocca(self.missione, "mira") end
		self.pad_aim, self.aiming = true, true
		self.aim_target = st.angle
		if not previous or game.AIM_SMOOTH >= 1 or not self.aim_angle then self.aim_angle = st.angle end
		local f = st.f
		if trigger then f = math.max(0, math.min(1, (PAD.grilletto(self) - PAD.THRESHOLD) / (0.95 - PAD.THRESHOLD))) end
		self.aim_power = math.max(0.1, f ^ game.AIM_EXPONENT)
		self.aim_dist = math.huge
		-- to fire with the aim from a moment earlier (PAD.COMMANDS.spara)
		sticks.registra(st, self.clock, self.aim_angle, self.aim_power, true)
		if trigger then
			-- pressed: it charges; released (below the threshold): it fires
			local v = PAD.grilletto(self)
			if v > (self.pad_charge and PAD.THRESHOLD or PAD.CHARGE) then
				self.pad_charge = true
			elseif self.pad_charge then
				PAD.COMMANDS.spara(self, PAD.TRIGGER_RELEASE)
			end
		end
	elseif previous then
		-- brought back to the center: the aim goes off and nothing fires
		self.pad_aim, self.aiming, self.pad_charge = false, false, false
		missions.tocca(self.missione, "annulla")
	end
end
-- the trigger charges past CHARGE and fires when it comes back below
-- THRESHOLD, with the power from TRIGGER_RELEASE seconds earlier (the trigger
-- springs back in a moment); the margin between the two keeps a trigger
-- shaking around the threshold from firing twice with a single press
PAD.THRESHOLD, PAD.CHARGE, PAD.TRIGGER_RELEASE = 0.06, 0.15, 0.08

-- The visible OGGETTI, from the bottom of the column
function PAD.oggetti(self)
	local l = {}
	for _, sl in ipairs(self.slots) do
		if sl.have and sl.group == 3 then l[#l + 1] = sl end
	end
	return l
end

-- LB and RB: the primary (group 1) or the secondary (2) after the one in hand,
-- cycling in bar order (from the stopwatch outward); if something else is in
-- hand, the first. Those that can't be used now are skipped; if none can, the
-- next one says why (choose_slot)
function PAD.giro(self, cluster)
	local l = {}
	for _, sl in ipairs(self.slots) do
		if sl.have and sl.group == cluster then l[#l + 1] = sl end
	end
	local n = #l
	if n == 0 then return end
	local i0 = 0
	for i, sl in ipairs(l) do
		if sl.weapon == self.weapon and not self.tele_armed then i0 = i end
	end
	local g = self.g
	for k = 1, n do
		local w = l[(i0 - 1 + k) % n + 1].weapon
		if (w ~= self.weapon or self.tele_armed) and not (my_turn(self) and g.phase == "aim" and hud.motivo(g, w)) then
			choose_slot(self, w)
			return
		end
	end
	if i0 == 0 or n > 1 then choose_slot(self, l[i0 % n + 1].weapon) end
end

-- The battle commands of the buttons (PAD.reader.BATTLE, or those picked in the settings)
PAD.COMMANDS = {
	primaria = function(self) PAD.giro(self, 1) end,
	secondaria = function(self) PAD.giro(self, 2) end,
	spara = function(self, first_one)
		local w = self.tele_armed and "teleport" or self.weapon
		self.pad_charge = false
		if self.pad_aim and my_turn(self) and self.g:can_use(w) then
			-- as on the phone when the thumb lifts: the aim from a moment earlier
			-- (levette.RELEASE), so pressing RT the sliding stick doesn't move the shot
			local a, p = sticks.shot(self.pad_st, self.clock - (first_one or 0), self.aim_angle, self.aim_power)
			self.fire = { angle = a, power = p, weapon = w }
			self.tele_armed = false
			sticks.reset(self.pad_st)
			self.pad_aim, self.aiming = false, false
		end
	end,
	-- SALTA on a button (settings): jumps while held, like the stick pushed up
	salta = function(self)
		self.jump_pressed, self.pad_jump = true, true
		missions.tocca(self.missione, "salta")
	end,
	teletrasporto = function(self) choose_slot(self, "teleport") end,
	rampino = function(self) choose_slot(self, "hook") end,
	paracadute = function(self) choose_slot(self, "parachute") end,
	oggetti = function(self)
		local l = PAD.oggetti(self)
		local i = 0
		for k, sl in ipairs(l) do
			if sl.weapon == self.pad_item then i = k end
		end
		if #l > 0 then self.pad_item = l[i % #l + 1].weapon end
	end,
	usa_oggetto = function(self)
		if self.pad_item then choose_slot(self, self.pad_item) end
	end,
	-- the swap: the second attack becomes a teleport (like the button above the
	-- stopwatch, which is there when possible)
	baratto = function(self)
		if my_turn(self) and self.g.phase == "aim" and self.g:can_use("swap") and missions.vede(self.missione, "baratto") then
			missions.tocca(self.missione, "baratto")
			self.fire = { angle = 0, power = 0, weapon = "swap" }
		end
	end,
	-- held: the aiming stick changes the zoom; released without moving it, a
	-- tap (PAD.evento)
	zoom = function(self)
		if self.pad_aim then
			sticks.reset(self.pad_st)
			self.pad_aim, self.aiming = false, false
		end
		self.pad_zoom = { t = self.clock }
	end,
}

-- With the zoom button held: the aiming stick, down zooms out and up zooms
-- in (like dragging the button), and meanwhile it doesn't aim. The dot in the
-- button says where the zoom is (the long guide is only for the finger)
function PAD.zoom(self)
	local z = self.pad_zoom
	local dt = self.clock - z.t
	z.t = self.clock
	local y = PAD.levetta(self, "mira").y
	if math.abs(y) > 0.25 then
		z.moved = true
		camera.trascina(self.cam, self.cam.f + y * ZM.STICK_RATE * dt)
	end
end

-- Every frame: one stick walks and jumps, the other aims (PAD.levetta)
-- The controller's buttons on the HUD (ui/glyph.lua, Sergio 30 Oct): with the
-- controller in hand each button shows its key, drawn as on the controller in
-- use and as it is now in the settings. For each command: which node it sits
-- on and where, in half sizes of the node (1, 1 the top right corner)
PAD.glyph = require "ui.glyph"
PAD.GLYPHS = {
	primaria = { -1, 1 }, secondaria = { 1, 1 }, rampino = { -0.75, 0.75 }, paracadute = { -0.75, 0.75 },
	teletrasporto = { -0.75, 0.75 }, baratto = { -0.75, 0.75 }, usa_oggetto = { 1.3, 0 }, oggetti = { -1.3, 0 },
	zoom = { -1.35, 0 }, rotellina = { 1, -1 }, spara = { -0.7, 0.7 },
}
function PAD.sopra(self, cmd)
	if cmd == "teletrasporto" then return self.btn_tele.nodo end
	if cmd == "baratto" then return self.scambio.tondo.nodo end
	if cmd == "zoom" then return self.btn_zoom end
	if cmd == "rotellina" then return self.btn_menu end
	if cmd == "spara" then return self.chrono.radice, 2 * hud.OUTSIDE end
	local chosen
	for _, sl in ipairs(self.slots) do
		if sl.have then
			-- the weapons: the group's last one, the farthest from the stopwatch
			if (cmd == "primaria" and sl.group == 1) or (cmd == "secondaria" and sl.group == 2)
				or (cmd == "rampino" and sl.weapon == "hook") or (cmd == "paracadute" and sl.weapon == "parachute")
				or (cmd == "usa_oggetto" and sl.group == 3 and sl.weapon == self.pad_item) then
				chosen = sl
			end
			if cmd == "oggetti" and sl.group == 3 then chosen = chosen or sl end
		end
	end
	return chosen and chosen.node
end

function PAD.glyphs(self)
	local on = self.pad_on and self.controls_visible and (self.mode == "local" or self.mode == "online")
	if not (on or self.glyphs) then return end
	self.glyphs = self.glyphs or {}
	for cmd, angle_deg in pairs(PAD.GLYPHS) do
		local g = self.glyphs[cmd]
		if not g then
			g = PAD.glyph.new(nil, 30)
			self.glyphs[cmd] = g
		end
		local gui_node, side_of = nil, nil
		if on then gui_node, side_of = PAD.sopra(self, cmd) end
		local button_key = gui_node and (cmd == "rotellina" and "start" or PAD.reader.key_of(self.ctrl, cmd))
		if button_key then
			if g.su ~= gui_node then
				gui.set_parent(g.radice, gui_node)
				g.su = gui_node
			end
			local size = gui.get_size(gui_node)
			local w, h = side_of or size.x, side_of or size.y
			PAD.glyph.display(g, self.ctrl, button_key, angle_deg[1] * w / 2, angle_deg[2] * h / 2)
		else
			PAD.glyph.display(g, nil)
		end
	end
	-- the teleport's keyboard key makes room for the controller's
	gui.set_enabled(self.tele_key, not (on or self.touch_ui))
end

function PAD.every_frame(self)
	local c, reader = self.ctrl, PAD.reader
	PAD.glyphs(self)
	-- the settings' mapping, once the profile is loaded
	if not self.read_keys and self.profilo then
		self.read_keys = true
		reader.usa(c, profile.setting(self.profilo, "tasti"))
	end
	reader.levette = PAD.imp(self, "levette")
	-- Esc or back (PAD.on_input), if it wasn't the controller's B
	if self.menu_requested then
		self.menu_requested = nil
		local from_b = c.giu.b or (self.pad_b_t and self.clock - self.pad_b_t < 0.3)
		if not from_b and (self.controls_visible and (self.mode == "local" or self.mode == "online") or self.mode == "connecting") then
			open_wheel(self, not self.menu_open)
		end
	end
	if not self.pad_on and (reader.spinta(c.sx) or reader.spinta(c.dx)) then PAD.evento(self, {}) end
	local play_mission = (self.mode == "local" or self.mode == "online") and self.controls_visible
		and not self.menu_open and not self.carta
	if not play_mission then
		PAD.riposo(self)
		return
	end
	local st = self.pad_move
	local previous = st.moving
	local jump_key = reader.key_of(c, "salta")
	if jump_key then
		-- with jump on a button the left stick only walks: only sideways counts
		local x = PAD.levetta(self, "muove").x
		st.moving = math.abs(x) > (st.moving and sticks.MOVE_CENTER or sticks.LATERAL_DEAD)
		if st.moving then st.dir = x < 0 and -1 or 1 end
		self.pad_jump = self.pad_jump and c.giu[jump_key] or false
	elseif sticks.muovi(st, PAD.levetta(self, "muove").x, PAD.levetta(self, "muove").y) then
		self.jump_pressed = true
		missions.tocca(self.missione)
		missions.tocca(self.missione, "salta")
	end
	if st.moving and not previous then
		missions.tocca(self.missione)
		missions.tocca(self.missione, "cammina")
	end
	self.pad_walk = st.moving and st.dir or 0
	if not jump_key then self.pad_jump = st.jumping end
	if self.pad_zoom then PAD.zoom(self) else PAD.mira(self) end
	-- the lit item (LT): if it ran out, the column's first
	local l = PAD.oggetti(self)
	local ok = false
	for _, sl in ipairs(l) do ok = ok or sl.weapon == self.pad_item end
	if not ok then self.pad_item = l[1] and l[1].weapon end
end

-- A controller button pressed or released (ui/controller.lua)
function PAD.evento(self, e)
	self.pad_on = true
	-- on Android B also sends the phone's back key (PAD.every_frame)
	if e.nome == "b" then self.pad_b_t = self.clock end
	if self.touch_ui and COMMANDS == "" then set_touch_ui(self, false) end
	if e.nome and not e.held_down and not e.levetta and (self.mode == "local" or self.mode == "online") then
		-- released: SALTA stops jumping, SPARA "lasciando" fires the shot
		local command = PAD.reader.comando(self.ctrl, e.nome)
		if command == "salta" then self.pad_jump = false end
		if command == "zoom" and self.pad_zoom then
			if not self.pad_zoom.moved then change_zoom(self) end
			self.pad_zoom = nil
		end
		if command == "spara" and self.pad_charge and PAD.imp(self, "potenza") ~= "grilletto" then
			PAD.COMMANDS.spara(self)
		end
	end
	if not (e.nome and e.held_down) then return end
	local battle = self.mode == "local" or self.mode == "online" or self.mode == "ended" or self.mode == "connecting"
	if not battle then
		-- menus, screens and weapon draft: like taps (ui.tocco)
		-- (with the button's name, for the settings that change it)
		if e.ui or self.mode == "schermata" then
			PAD.on_input(self, ACTION.PAD, { pressed = true, ui = e.ui, nome = e.nome, levetta = e.levetta })
		end
		return
	end
	local n = e.nome
	local command = not e.levetta and PAD.reader.comando(self.ctrl, n)
	if self.mode == "ended" then
		-- the podium, the stars or the home, like a tap
		if n == "a" or n == "start" then pointer_down(self, "pad", 0, 0) end
	elseif self.carta then
		-- the weapon's card closes with A; the vignettes go on with A and close with B
		if (self.carta.pad and self.carta:pad(n)) or (not self.carta.pad and n == "a") then PAD.close_card(self) end
	elseif self.menu_open then
		-- the wheel: the d-pad moves the light, A confirms, B or Start closes it
		if command == "rotellina" or e.ui == "indietro" then
			open_wheel(self, false)
		elseif e.ui then
			local ui_action = ui.tocco(self.rotellina, ACTION.PAD, { pressed = true, ui = e.ui })
			if ui_action then PAD.rotellina(self, ui_action) end
		end
	elseif command == "rotellina" and self.queue and not self.queue.found
		and (self.mode == "menu" or self.mode == "schermata" or self.mode == "ended") then
		-- the controller's way to the pill: the gear button goes back to the room
		CP.queue_open(self)
	elseif command == "rotellina" and (self.controls_visible or self.mode == "connecting") then
		open_wheel(self, true)
		ui.navigate(self.rotellina, "giu")
	elseif command == "spara" and self.controls_visible then
		-- pressing fires at once; "lasciando" (settings) charges and fires on
		-- release; with power from the trigger PAD.mira takes care of it
		missions.tocca(self.missione)
		if PAD.imp(self, "potenza") == "grilletto" then return end
		if PAD.imp(self, "sparo") == "rilascio" then
			self.pad_charge = self.pad_aim
		else
			PAD.COMMANDS.spara(self)
		end
	elseif command and self.controls_visible then
		missions.tocca(self.missione)
		PAD.COMMANDS[command](self)
	end
end

-- (in PAD because the controller's buttons pass through here too, as ACTION.PAD)
function PAD.on_input(self, action_id, action)
	-- the controller: its buttons go to PAD.evento, one at a time
	local pad = PAD.reader.input(self.ctrl, action_id, action)
	if pad then
		for _, e in ipairs(pad) do PAD.evento(self, e) end
		return true
	end
	-- a key, the mouse or a finger: no longer playing with the controller
	if action.pressed and action_id ~= ACTION.PAD then self.pad_on = false end
	-- a finger that changed screen (on_input): until it lifts (at most half a
	-- second) the new screen doesn't feel it
	if self.wait_release and (action_id == ACTION.TOUCH or action_id == ACTION.MULTI) then
		if action.released then self.wait_release = nil end
		return true
	end
	-- the replay: a controller button goes back to the profile (taps in pointer_down)
	if self.mode == "replay" and action_id == ACTION.PAD then
		if action.pressed then CP.replay_end(self) end
		return true
	end
	if self.mode == "schermata" then
		local end_of = self.schermata.mod.on_input(self.schermata.obj, action_id, action)
		if end_of and self.schermata.mod == menu.level_end then
			after_level_end(self, end_of)
		elseif type(end_of) == "table" and end_of.coda then
			-- DOVE GIOCHI? or GIOCA in an event's detail: the online match
			CP.iris(self, function()
				close_screen(self)
				start_online(self, end_of.coda)
			end)
		elseif type(end_of) == "table" and end_of.rivedi then
			-- RIVEDI on the podium or in the profile
			CP.rivedi(self, end_of.rivedi, end_of.da)
		elseif end_of == "armeria" and self.schermata.mod == menu.profile_tabs then
			-- the armory from the profile: closing it goes back there
			CP.slide(self, 1, function()
				close_screen(self)
				self.from_the_profile = true
				open_screen(self, menu.armory, self.profilo)
			end)
		elseif end_of and self.from_the_profile and self.schermata.mod == menu.armory then
			CP.slide(self, -1, function()
				close_screen(self)
				self.from_the_profile = nil
				CP.open_profile(self, "scheda")
			end)
		elseif type(end_of) == "table" and end_of.missione then
			self.ritorno = "campagna"
			CP.iris(self, function()
				close_screen(self)
				start_mission(self, end_of.missione)
			end)
		elseif type(end_of) == "table" then
			-- GIOCA in training against the bots (the choice stays for next time)
			CP.iris(self, function()
				close_screen(self)
				start_local(self, end_of)
			end)
		elseif end_of then
			-- INDIETRO: the slider the other way (from the podium, which follows the battle, the iris)
			if self.schermata.mod == menu.podium then
				CP.iris(self, function() show_menu(self, true) end)
			else
				CP.slide(self, -1, function() show_menu(self, true) end)
			end
		end
		return true
	end
	if self.mode == "menu" then
		local choice = home.on_input(self.home, action_id, action)
		if choice == "local" then
			CP.iris(self, function() start_local(self) end)
		elseif choice == "online" and self.queue then
			-- GIOCA while queued: the matchmaking, i.e. the waiting room (Sergio wants both)
			CP.queue_open(self)
		elseif choice == "online" and profile.new_player(self.profilo)
			and (not SIMULATE or config_int("megablast.prova_nuovo", 0) > 0) then
			-- for a new player GIOCA leads to the Training basics, until they finish
			-- them (in the scenarios only with prova_nuovo 1: scenari/nuovo.txt)
			self.ritorno = "home"
			CP.iris(self, function() start_mission(self, profile.first_lesson(self.profilo)) end)
		elseif choice == "online" or choice == "eventi" then
			-- DOVE GIOCHI? (menu/queue.lua) or the board (menu/board.lua): they are
			-- redone as soon as the updated events arrive
			local mod = choice == "online" and menu.queue or menu.board
			CP.slide(self, 1, function() open_screen(self, mod, hud.NAMES) end)
			-- not while the slide still moves the screen's nodes: rebuilding deletes
			-- them, and the slide stopped on a deleted node (simulator, 3 Nov)
			local function rebuild()
				if menu.passaggio.is_active(self.passaggio) then
					timer.delay(0.05, false, rebuild)
				elseif self.schermata and self.schermata.mod == mod then
					mod.rebuild(self.schermata.obj)
				end
			end
			menu.eventi.load_up(server_url(), rebuild)
		elseif choice then
			-- the menus: they arrive with the slider (ui/transition.lua)
			local open_view = {
				armeria = function() open_screen(self, menu.armory, self.profilo) end,
				allenamento = function() open_screen(self, menu.training, self.against_bot, profile.total_stars(self.profilo)) end,
				impostazioni = function() open_screen(self, menu.settings, self.profilo, self.ctrl) end,
				campagna = function() open_campaign(self) end,
				profilo = function() CP.open_profile(self, "scheda") end,
			}
			if open_view[choice] then CP.slide(self, 1, open_view[choice]) end
		end
		return true
	elseif self.mode == "scelta" or self.mode == "scelta_online" then
		if not CP.input_choice(self, action_id, action) and menu.pick.on_input(self.scelta, action_id, action) == "esci" then
			quit_match(self)
		end
		return true
	end
	-- a key turns off the sticks (unless the configuration asked for them)
	if action_id and action_id ~= ACTION.TOUCH and action_id ~= ACTION.MULTI and action_id ~= ACTION.MENU
		and action.pressed and self.touch_ui and COMMANDS == "" then
		set_touch_ui(self, false)
	end
	if self.missione and action.pressed and (action_id == ACTION.LEFT or action_id == ACTION.RIGHT
		or action_id == ACTION.JUMP or action_id == ACTION.TELE_BTN or ACTION.WEAPON[action_id]) then
		missions.tocca(self.missione)
	end
	if (action_id == ACTION.LEFT or action_id == ACTION.RIGHT) and action.pressed then
		missions.tocca(self.missione, "cammina")
	end
	if action_id == ACTION.LEFT then
		self.keys.left = not action.released
	elseif action_id == ACTION.RIGHT then
		self.keys.right = not action.released
	elseif action_id == ACTION.JUMP then
		if action.pressed then
			self.jump_pressed = true
			missions.tocca(self.missione, "salta")
		end
		self.keys.jump = not action.released
	elseif action_id == ACTION.TELE_BTN then
		if action.pressed then choose_slot(self, "teleport") end
	elseif action_id == ACTION.ZOOM then
		if action.pressed then change_zoom(self) end
	elseif action_id == ACTION.MENU then
		-- Esc (or back on the phone): opens and closes the wheel, at the end of the
		-- frame (PAD.every_frame): the controller's B button on Android also sends
		-- "indietro", and that one doesn't count
		if action.pressed then self.menu_requested = true end
	elseif action_id == ACTION.ZOOM_IN or action_id == ACTION.ZOOM_OUT then
		if action.pressed then change_zoom(self, action_id == ACTION.ZOOM_OUT and 1 or -1) end
	elseif ACTION.WEAPON[action_id] then
		-- keys 1-5: the bar's weapons, in order
		if action.pressed then
			local n = 0
			for _, sl in ipairs(self.slots) do
				if sl.have then
					n = n + 1
					if n == ACTION.WEAPON[action_id] then choose_slot(self, sl.weapon) end
				end
			end
		end
	elseif action_id == ACTION.MULTI then
		-- real fingers: from here on the "mouse" touch (the first finger) is ignored
		if not self.multitouch then
			self.multitouch = true
			if self.pointers.mouse then pointer_up(self, "mouse", action.x, action.y) end
		end
		-- a finger turns on the sticks (also after a key or the controller)
		if not self.touch_ui and COMMANDS ~= "computer" then set_touch_ui(self, true) end
		for _, t in ipairs(action.touch) do
			if t.pressed then
				pointer_down(self, t.id, t.x, t.y)
			elseif t.released then
				pointer_up(self, t.id, t.x, t.y)
			else
				pointer_move(self, t.id, t.x, t.y)
			end
		end
	elseif action_id == ACTION.TOUCH then
		if self.multitouch then return true end
		if action.pressed then
			pointer_down(self, "mouse", action.x, action.y)
		elseif action.released then
			pointer_up(self, "mouse", action.x, action.y)
		else
			pointer_move(self, "mouse", action.x, action.y)
		end
	elseif action_id == ACTION.CANCEL then
		-- right button while aiming with the left: the shot is cancelled, and
		-- releasing the left fires nothing (you can change weapon and aim again)
		if action.pressed and self.pointers.mouse == "aim" then
			self.pointers.mouse = "cancelled"
			self.aiming = false
		elseif action.pressed and self.pointers.mouse == "pad_aim" and self.aiming then
			-- (also on the stick, if there is a mouse: it is like a second-finger tap)
			cancel_pad_aim(self)
		end
	elseif action_id == nil and self.pointers.mouse then
		-- mouse movement without a state change
		pointer_move(self, "mouse", action.x, action.y)
	end
	return true
end

-- The screen you are on (for PAD.finger)
function PAD.schermo(self)
	return self.mode, self.schermata and self.schermata.obj
end

-- A finger touching down (with the mouse, or any of the real fingers)?
function PAD.finger(action_id, action)
	if action_id == ACTION.TOUCH then return action.pressed end
	if action_id ~= ACTION.MULTI then return false end
	for _, t in ipairs(action.touch or {}) do
		if t.pressed then return true end
	end
	return false
end

-- on_input's work counts in the frame counter too
function on_input(self, action_id, action)
	local t = frames.ora()
	local r = CP.on_input(self, action_id, action)
	frames.lavoro(t)
	return r
end

function CP.on_input(self, action_id, action)
	-- during the entry and the transitions nothing can be touched
	if self.ingresso or menu.passaggio.is_active(self.passaggio) then return true end
	-- the queue's pill: a tap goes back to the room (not in a match: the finger is playing)
	if action_id == hash("touch") and action.pressed and CP.queue_tap(self, action.x, action.y) then return true end
	local modo, obj = PAD.schermo(self)
	local r = PAD.on_input(self, action_id, action)
	-- A finger that changes screen by touching down doesn't also touch the next
	-- one (Sergio, 30 Oct: leaving online a tap pressed the home button under
	-- the finger, because the same finger arrives twice, with the mouse and with
	-- the real fingers): until it lifts (at most half a second) the rest doesn't feel it
	local m2, o2 = PAD.schermo(self)
	if (m2 ~= modo or o2 ~= obj) and PAD.finger(action_id, action) then self.wait_release = 0.5 end
	return r
end
