// Il Worker del pannello degli eventi: la pagina in pagina/, le API e il file
// per il server in worker.js, il calendario in KV. Cloudflare lo costruisce dal
// repository collegato (Path strumenti/eventi, niente build, deploy
// npx wrangler deploy): la prima volta crea da solo lo spazio KV. Vedi README.md.
{
	"name": "megablast-eventi",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"assets": { "directory": "pagina", "binding": "ASSETS" },
	"kv_namespaces": [{ "binding": "EVENTI" }],
	// al massimo 10 chiavi sbagliate al minuto per indirizzo (worker.js)
	"ratelimits": [{ "name": "TENTATIVI", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
