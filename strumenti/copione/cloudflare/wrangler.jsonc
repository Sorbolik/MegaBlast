// Il Copione su Cloudflare: la pagina e la build web in dist/ (costruisci.sh),
// "Manda a Claude" in worker.js. .github/workflows/copione.yml lo mette già
// costruito nel ramo copione-pubblica; Cloudflare (repository collegato, ramo
// copione-pubblica, niente build, deploy npx wrangler deploy) lo pubblica da lì.
{
	"name": "megablast-copione",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"assets": { "directory": "dist", "binding": "ASSETS" }
}
